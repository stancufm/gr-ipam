#!/usr/bin/env python3
import argparse
import concurrent.futures
import datetime
import importlib.machinery
import importlib.util
import json
import os
import re
import select
import subprocess
import time

GR_PATH = os.environ.get("GR_PATH", "/usr/local/bin/gr")
def load_gr():
    loader = importlib.machinery.SourceFileLoader("gr_module", GR_PATH)
    spec = importlib.util.spec_from_loader("gr_module", loader)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def match(patterns, text, flags=re.I | re.M):
    for pattern in patterns:
        found = re.search(pattern, text, flags)
        if found:
            return found.group(1).strip()
    return ""


def parse_version(text):
    version = match([
        r"Cisco IOS XE Software, Version\s+([^\s,]+)",
        r"Cisco IOS Software.*?Version\s+([^\s,]+)",
        r"Software Version\s*[:=]\s*([^\s,]+)",
        r"Version\s*[:=]\s*([^\r\n]+)",
    ], text)
    model = match([
        r"^Model [Nn]umber\s*[:=]\s*(\S+)",
        r"^Model [Nn]ame\s*[:=]\s*(\S+)",
        r"^[Cc]isco\s+(\S+)\s+.*(?:processor|revision)",
        r"^Machine type\s*[:=]\s*(\S+)",
        r"^PID\s*:\s*(\S+)",
    ], text)
    uptime = match([r"^(.+?) uptime is (.+)$"], text)
    if uptime:
        uptime = match([r"^.+? uptime is (.+)$"], text)
    serial = match([
        r"Processor board ID\s+(\S+)",
        r"System [Ss]erial [Nn]umber\s*[:=]\s*(\S+)",
        r"Serial [Nn]umber\s*[:=]\s*(\S+)",
    ], text)
    image = match([r'^System image file is\s+"([^"]+)"', r"^Image [Ff]ile\s*[:=]\s*(.+)$"], text)
    rom = match([r"^ROM:\s*(.+)$", r"^BOOTLDR:\s*(.+)$"], text)
    os_family = "cisco"
    lower = text.lower()
    if "ios xe" in lower:
        os_family = "ios-xe"
    elif "cisco ios software" in lower:
        os_family = "ios"
    elif "nx-os" in lower:
        os_family = "nx-os"
    elif "small business" in lower or "sg300" in lower or "sg500" in lower:
        os_family = "cisco-small-business"
    return {"model": model, "firmware": version, "os_family": os_family,
            "uptime": uptime, "serial": serial, "system_image": image, "rom": rom}


def redact_secret(data, password):
    secret = password.encode("utf-8")
    return data.replace(secret, b"[REDACTED]") if secret else data


def run_cisco_small_business(item, password, command, read_fd, login_driver_class, timeout=50):
    master_fd, slave_fd = os.openpty()
    command = command[:-1] if command[-1:] == ["show version"] else command
    command.insert(command.index("-p"), "-tt")
    process = subprocess.Popen(command, stdin=slave_fd, stdout=slave_fd, stderr=subprocess.PIPE,
                               close_fds=True, pass_fds=(read_fd,))
    os.close(slave_fd)
    os.close(read_fd)
    read_fd = None
    driver = login_driver_class(item["user"], password)
    stdout_chunks, stderr_chunks = [], []
    streams = {master_fd: stdout_chunks, process.stderr.fileno(): stderr_chunks}
    deadline = time.monotonic() + timeout
    commands_sent = False
    timed_out = False
    try:
        while streams:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                timed_out = True
                process.kill()
                break
            ready, _, _ = select.select(list(streams), [], [], min(remaining, 1.0))
            if not ready and process.poll() is not None:
                break
            for descriptor in ready:
                try:
                    data = os.read(descriptor, 65536)
                except OSError:
                    data = b""
                if not data:
                    streams.pop(descriptor, None)
                    continue
                streams[descriptor].append(data)
                if descriptor == master_fd:
                    for action, response in driver.feed(data):
                        if action == "credential":
                            os.write(master_fd, response)
                        elif action == "ready" and not commands_sent:
                            os.write(master_fd, b"terminal datadump\nshow version\nexit\n")
                            commands_sent = True
        if timed_out:
            process.wait()
        else:
            process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        timed_out = True
        process.kill()
        process.wait()
    finally:
        try:
            os.close(master_fd)
        except OSError:
            pass
    stdout = redact_secret(b"".join(stdout_chunks), password).decode("utf-8", "replace")
    stderr = redact_secret(b"".join(stderr_chunks), password).decode("utf-8", "replace")
    return process.returncode, stdout, stderr, timed_out


def run_one(item, password, output_dir):
    login_driver_class = item.pop("_login_driver", None)
    read_fd, write_fd = os.pipe()
    try:
        os.write(write_fd, (password + "\n").encode("utf-8"))
        os.close(write_fd)
        client = "/usr/bin/ssh1" if item["client"] == "legacy" else "ssh"
        known_hosts = os.path.join(output_dir, "known-hosts-{}".format(item["ip"]))
        strict = "no" if item["client"] == "legacy" else "accept-new"
        command = ["sshpass", "-d", str(read_fd), client, "-F", "/dev/null",
                   "-o", "StrictHostKeyChecking={}".format(strict),
                   "-o", "UserKnownHostsFile={}".format(known_hosts),
                   "-o", "ConnectTimeout=10", "-o", "ConnectionAttempts=1",
                   "-p", str(item["port"]), "{}@{}".format(item["user"], item["ip"]),
                   "show version"]
        if item.get("session_driver") == "cisco-small-business":
            returncode, stdout, stderr, timed_out = run_cisco_small_business(
                item, password, command, read_fd, login_driver_class)
            read_fd = None
        else:
            completed = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                       universal_newlines=True, timeout=35, pass_fds=(read_fd,))
            returncode, stdout, stderr, timed_out = (
                completed.returncode, completed.stdout, completed.stderr, False)
        item["returncode"] = returncode
        item["stderr"] = stderr.strip()
        raw_path = os.path.join(output_dir, "{}-{}-show-version.txt".format(item["hostname"], item["ip"]))
        with open(raw_path, "w", encoding="utf-8", errors="replace") as handle:
            handle.write(stdout)
            if stderr:
                handle.write("\n--- STDERR ---\n" + stderr)
        os.chmod(raw_path, 0o600)
        item["raw_report"] = raw_path
        item.update(parse_version(stdout))
        item["result"] = "timeout" if timed_out else ("success" if returncode == 0 else "failed")
    except subprocess.TimeoutExpired:
        item["result"] = "timeout"
    finally:
        try:
            if read_fd is not None:
                os.close(read_fd)
        except OSError:
            pass
    return item


def main():
    parser = argparse.ArgumentParser(description="Collect and parse show version through gr metadata/vault")
    target = parser.add_mutually_exclusive_group(required=True)
    target.add_argument("--all", action="store_true", help="collect from every matching vendor device")
    target.add_argument("--ip", action="append", dest="ips", help="collect only this IP (repeatable)")
    parser.add_argument("--vendor", default="cisco", help="phpIPAM device_vendor value (default: cisco)")
    parser.add_argument("--workers", type=int, default=4)
    args = parser.parse_args()
    gr = load_gr()
    cfg = gr.load_config(None)
    with gr.api_session(cfg, prompt=False) as client:
        rows = client.addresses()
    items = []
    for row in rows:
        ip = str(gr.normalize_ip(row.get("ip")) or row.get("ip") or "")
        if args.ips and ip not in args.ips:
            continue
        meta = gr.phpipam_ssh_metadata(row)
        vendor = str(gr.custom_value(row, "device_vendor") or "").strip()
        if vendor.lower() != args.vendor.lower():
            continue
        if not meta["enabled"] or not meta["profile"]:
            continue
        session_driver = gr.profile_session_driver(cfg, meta["profile"])
        items.append({"id": row.get("id"), "ip": ip, "hostname": str(row.get("hostname") or ip),
                      "vendor": vendor, "user": meta["user"], "port": int(meta["port"] or 22),
                      "profile": meta["profile"], "client": meta.get("client", "normal"),
                      "session_driver": session_driver,
                      "_login_driver": gr.CiscoSmallBusinessLogin})
    if not items:
        print("No eligible devices matched.")
        return 1
    profiles = sorted(set(item["profile"] for item in items))
    passwords = {profile: gr.read_vault_password(gr.vault_secret_name(cfg, profile)) for profile in profiles}
    stamp = datetime.datetime.utcnow().strftime("%Y%m%dT%H%M%SZ")
    report_root = cfg["device_version_dir"]
    os.makedirs(report_root, mode=0o700, exist_ok=True)
    os.chmod(report_root, 0o700)
    output_dir = os.path.join(report_root, stamp)
    os.makedirs(output_dir, mode=0o700)
    results = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, min(args.workers, 12))) as pool:
        futures = [pool.submit(run_one, dict(item), passwords[item["profile"]], output_dir) for item in items]
        for future in concurrent.futures.as_completed(futures):
            result = future.result()
            results.append(result)
            print("RESULT {} {} {} model={} firmware={}".format(
                result["hostname"], result["ip"], result["result"],
                result.get("model", ""), result.get("firmware", "")))
    results.sort(key=lambda item: tuple(int(part) for part in item["ip"].split(".")))
    report = os.path.join(output_dir, "cisco-show-version-report.json")
    with open(report, "w", encoding="utf-8") as handle:
        json.dump({"generated_utc": stamp, "command": "show version", "results": results},
                  handle, ensure_ascii=False, indent=2)
    os.chmod(report, 0o600)
    print("SUMMARY={}".format(json.dumps({key: sum(1 for x in results if x["result"] == key)
                                           for key in ("success", "failed", "timeout")}, sort_keys=True)))
    print("REPORT={}".format(report))
    return 0 if all(item["result"] == "success" for item in results) else 2


if __name__ == "__main__":
    main()
