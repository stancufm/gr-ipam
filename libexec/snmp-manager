#!/usr/bin/env python3
"""Template-driven SNMP inventory, testing, planning and controlled execution."""
import argparse
import csv
import datetime
import getpass
import importlib.machinery
import importlib.util
import ipaddress
import json
import os
import re
import socket
import ssl
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

GR_PATH = os.environ.get("GR_PATH", "/usr/local/bin/gr")
TEMPLATES_OVERRIDE = os.environ.get("GR_SNMP_TEMPLATES")
DEFAULT_TEMPLATES = TEMPLATES_OVERRIDE or "/usr/local/share/gr/snmp/templates.json"
COLLECT_VERSION_PATH = os.environ.get("GR_COLLECT_VERSION", "/usr/local/libexec/gr/collect-version")
COLLECT_CONFIG_PATH = os.environ.get("GR_COLLECT_CONFIG", "/usr/local/libexec/gr/collect-config")
HANDLERS_PATH = os.environ.get("GR_SNMP_HANDLERS", "/usr/local/libexec/gr/snmp-handlers")


def load_module(name, path):
    loader = importlib.machinery.SourceFileLoader(name, path)
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


gr = load_module("gr_snmp_manager", GR_PATH)
snmp_handlers = load_module("gr_snmp_handlers", HANDLERS_PATH)


def custom(row, name):
    return gr.custom_value(row, name)


def load_templates(cfg):
    # An explicit process-level override is authoritative. This is required by
    # temporary validation and recovery workflows that must not silently fall
    # back to an installed site catalog from the user's persistent config.
    path = DEFAULT_TEMPLATES if TEMPLATES_OVERRIDE else gr.expand(
        cfg.get("snmp_template_file") or DEFAULT_TEMPLATES)
    if not os.path.isfile(path):
        path = DEFAULT_TEMPLATES
    def read_catalog(catalog_path):
        with open(catalog_path, encoding="utf-8") as handle:
            data = json.load(handle)
        if data.get("schema_version") != 1 or not isinstance(data.get("templates"), list):
            raise gr.GrError("Unsupported SNMP template schema: {}".format(catalog_path))
        return data

    local = read_catalog(path)
    if os.path.abspath(path) == os.path.abspath(DEFAULT_TEMPLATES) or not os.path.isfile(DEFAULT_TEMPLATES):
        return path, local["templates"]
    packaged = read_catalog(DEFAULT_TEMPLATES)
    # New package catalogs must become usable after upgrade without deleting
    # site-only template IDs.  A local catalog at the current generation may
    # override package IDs; an older generated catalog yields to reviewed new
    # definitions while retaining its additional IDs.
    local_generation = int(local.get("catalog_version") or 0)
    package_generation = int(packaged.get("catalog_version") or 0)
    first, second = ((local, packaged) if local_generation < package_generation
                     else (packaged, local))
    merged = {}
    order = []
    for catalog in (first, second):
        for template in catalog["templates"]:
            template_id = str(template.get("id") or "")
            if not template_id:
                raise gr.GrError("SNMP template without id in {}".format(path))
            if template_id not in merged:
                order.append(template_id)
            merged[template_id] = template
    return "{} + {}".format(DEFAULT_TEMPLATES, path), [merged[item] for item in order]


def implicit_privacy_probe_candidate(template, checks):
    """Allow AES128 SNMPGET to resolve an unreliable CLI privacy label.

    This never authorizes save by itself. The caller must still require both
    local and monitoring-server authPriv tests to succeed.
    """
    if str(template.get("privacy_protocol_implicit") or "").upper() != "AES128":
        return False
    required = ["engine", "view", "group", "user", "auth_sha"]
    if template.get("verify_server_enabled"):
        required.append("server_enabled")
    return all(bool(checks.get(name)) for name in required)


def row_ip(row):
    return str(gr.normalize_ip(row.get("ip")) or row.get("ip") or "")


def inventory_rows(api):
    """Join native device OS metadata onto address rows when API access permits."""
    rows = api.addresses()
    devices = {}
    try:
        response = api.request("GET", "devices/")
        values = response.get("data", []) if isinstance(response, dict) else []
        if isinstance(values, dict):
            values = list(values.values())
        for device in values if isinstance(values, list) else []:
            devices[str(device.get("id") or device.get("deviceId") or "")] = device
    except gr.GrError:
        pass
    for row in rows:
        device = devices.get(str(row.get("deviceId") or ""), {})
        row["_device_os"] = str(gr.custom_value(device, "device_os") or "")
    return rows


def select_rows(rows, args, require_enabled=False):
    selected = []
    network = ipaddress.ip_network(args.subnet, strict=False) if args.subnet else None
    start = end = None
    if args.ip_range:
        left, right = args.ip_range.split("-", 1)
        start, end = ipaddress.ip_address(left), ipaddress.ip_address(right)
    file_ips = set()
    excluded_ips = set(getattr(args, "exclude_ip", []) or [])
    if args.file:
        with open(args.file, encoding="utf-8-sig", newline="") as handle:
            content = handle.read()
        file_ips.update(re.findall(r"(?<![\d.])(?:\d{1,3}\.){3}\d{1,3}(?![\d.])", content))
    for row in rows:
        ip = row_ip(row)
        if not ip:
            continue
        address = ipaddress.ip_address(ip)
        matched = args.all or (args.ip and ip in args.ip) or ip in file_ips
        matched = matched or (network is not None and address in network)
        matched = matched or (start is not None and start <= address <= end)
        if not matched:
            continue
        if ip in excluded_ips:
            continue
        if require_enabled and not bool(int(custom(row, "snmp_enabled") or 0)):
            continue
        selected.append(row)
    if not selected:
        raise gr.GrError("No phpIPAM addresses matched the SNMP selection")
    return selected


def managed_row(row):
    """Keep intentional management rows without flooding reports with IPAM leases."""
    return (gr.resolve_device_driver(row) != "generic" or
            bool(str(custom(row, "snmp_template") or "").strip()) or
            bool(int(custom(row, "snmp_enabled") or 0)) or
            bool(int(custom(row, "monitoring_enabled") or 0)))


def response_row(response):
    """Normalize phpIPAM client data and raw API envelopes for verification."""
    data = response
    if isinstance(data, dict) and "data" in data and isinstance(data.get("data"), (dict, list)):
        data = data.get("data")
    if isinstance(data, list):
        data = data[0] if data else {}
    return data if isinstance(data, dict) else {}


def template_matches(template, row):
    match = template.get("match", {})
    values = {
        "ip": row_ip(row), "driver": gr.resolve_device_driver(row),
        "vendor": str(custom(row, "device_vendor") or ""),
        "model": str(custom(row, "device_model") or ""),
        "device_os": str(row.get("_device_os") or ""),
        "os_version": str(custom(row, "os_version") or ""),
    }
    for key in ("ip", "driver", "vendor"):
        if match.get(key) and values[key].lower() != str(match[key]).lower():
            return False
    for key in ("model", "device_os", "os_version"):
        pattern = match.get(key + "_regex")
        if pattern and not re.search(pattern, values[key], re.I):
            return False
    return True


def resolve_template(templates, row):
    explicit = str(custom(row, "snmp_template") or "").strip()
    if explicit:
        found = [item for item in templates if item.get("id") == explicit]
        if not found:
            raise gr.GrError("Unknown explicit SNMP template {} for {}".format(explicit, row_ip(row)))
        return found[0], "ip-override"
    candidates = [item for item in templates if template_matches(item, row)]
    if not candidates:
        raise gr.GrError("No SNMP template matches {}".format(row_ip(row)))
    def score(item):
        match = item.get("match", {})
        return sum(1 for key in ("ip", "model_regex", "device_os_regex", "os_version_regex", "vendor", "driver")
                   if match.get(key))
    candidates.sort(key=score, reverse=True)
    return candidates[0], "selector"


def profile_network_values(name, profile):
    sources = profile.get("sources") or []
    if not isinstance(sources, list):
        raise gr.GrError("SNMP profile {} sources must be a JSON list".format(name))
    try:
        sources = [str(ipaddress.ip_address(str(source))) for source in sources]
    except ValueError as exc:
        raise gr.GrError("SNMP profile {} has an invalid source: {}".format(name, exc))
    source_address = str(profile.get("source_address") or "").strip()
    if source_address:
        try:
            source_address = str(ipaddress.ip_address(source_address))
        except ValueError as exc:
            raise gr.GrError("SNMP profile {} has an invalid source_address: {}".format(name, exc))
        if sources and source_address not in sources:
            raise gr.GrError(
                "SNMP profile {} source_address {} is not in its approved sources".format(
                    name, source_address))
    return sources, source_address


def profile_values(cfg, row, args, need_secrets=True):
    name = args.profile or str(custom(row, "snmp_profile") or "").strip()
    profile = cfg.get("snmp_profiles", {}).get(name, {}) if name else {}
    username = args.username or str(profile.get("username") or "").strip()
    if not username:
        raise gr.GrError("SNMP profile/username is missing for {}".format(row_ip(row)))
    auth_protocol = str(profile.get("auth_protocol") or "SHA").upper()
    privacy_protocol = str(profile.get("privacy_protocol") or "AES").upper()
    sources, source_address = profile_network_values(name, profile)
    auth_password = privacy_password = ""
    if need_secrets:
        if args.prompt_credentials:
            auth_password = getpass.getpass("SNMPv3 AUTH password: ")
            privacy_password = getpass.getpass("SNMPv3 PRIV password: ")
        else:
            auth_secret = str(profile.get("auth_secret") or "").strip()
            privacy_secret = str(profile.get("privacy_secret") or "").strip()
            if not auth_secret or not privacy_secret:
                raise gr.GrError("SNMP vault secret names are missing in profile {}".format(name))
            auth_password = gr.read_vault_password(auth_secret)
            privacy_password = gr.read_vault_password(privacy_secret)
        if len(auth_password) < 8 or len(privacy_password) < 8:
            raise gr.GrError("SNMPv3 AUTH and PRIV passwords must contain at least 8 characters")
    return {"profile": name, "username": username, "auth_protocol": auth_protocol,
            "privacy_protocol": privacy_protocol, "auth_password": auth_password,
            "privacy_password": privacy_password, "sources": sources,
            "source_address": source_address}


def variables(row, credentials, args, template=None):
    defaults = (template or {}).get("defaults", {})
    sources = list(args.source or credentials.get("sources") or ["<SOURCE_REQUIRED>"])
    while len(sources) < 3:
        sources.append(sources[-1])
    return dict(credentials, ip=row_ip(row), hostname=str(row.get("hostname") or row_ip(row)),
                mac=str(row.get("mac") or ""),
                group=args.group or defaults.get("group") or "SNMP_DEFAULT_GROUP",
                view=args.view or defaults.get("view") or "SNMP_DEFAULT_VIEW",
                acl=args.acl or defaults.get("acl") or "SNMP_MON_SRV_ACL",
                write_view=defaults.get("write_view") or "SNMP_NO_WRITE",
                source_1=sources[0], source_2=sources[1], source_3=sources[2],
                legacy_value="<legacy-value-not-rendered>")


def render_commands(template, action, values, redact=True):
    commands = []
    for command in template.get(action + "_commands", []):
        rendered = command.format(**values)
        if redact:
            for key in ("auth_password", "privacy_password"):
                if values.get(key):
                    rendered = rendered.replace(values[key], "[REDACTED]")
        commands.append(rendered)
    return commands


def preserve_preexisting_snmp_state(template, preflight_output, commands, rollback_commands):
    """Avoid claiming ownership of a pre-existing global server or engine ID."""
    commands = list(commands)
    rollback_commands = list(rollback_commands)
    if template.get("preserve_preexisting_engine"):
        engine_present = bool(re.search(
            r"(?im)(?:local\s+snmp(?:v3)?\s+engine\s*id|local\s+snmp\s+engineid).*?[0-9a-f]{10,}",
            preflight_output or ""))
        if engine_present:
            commands = [item for item in commands if not re.match(
                r"(?i)^\s*snmp-server\s+engineid\s+(?:local\s+)?default\s*$", item)]
            rollback_commands = [item for item in rollback_commands if not re.match(
                r"(?i)^\s*no\s+snmp-server\s+engineid(?:\s+local)?\s*$", item)]
    if template.get("preserve_preexisting_server"):
        server_enabled = bool(re.search(
            r"(?im)^\s*SNMP(?:\s+agent)?\s+is\s+enabled\b", preflight_output or ""))
        if server_enabled:
            commands = [item for item in commands if item.strip().lower() != "snmp-server"]
            rollback_commands = [item for item in rollback_commands
                                 if item.strip().lower() != "no snmp-server"]
    return commands, rollback_commands


def snmpget(ip, credentials, timeout=5):
    # Net-SNMP normally exposes -A/-X passphrases in the process list.  A
    # private, short-lived snmp.conf keeps credentials out of argv and reports.
    with tempfile.TemporaryDirectory(prefix="gr-snmp-") as directory:
        os.chmod(directory, 0o700)
        config = os.path.join(directory, "snmp.conf")
        with open(config, "w", encoding="utf-8") as handle:
            handle.write(snmp_config_text(
                credentials, source_address=credentials.get("source_address") or ""))
        os.chmod(config, 0o600)
        environment = os.environ.copy()
        environment["SNMPCONFPATH"] = directory
        command = ["snmpget", "-v3", "-t", str(timeout), "-r", "0", "-On",
                   ip, ".1.3.6.1.2.1.1.5.0"]
        result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                universal_newlines=True, timeout=timeout + 3, env=environment)
    return result.returncode, result.stderr.strip()


def snmp_config_text(credentials, source_address=""):
    def quoted(value):
        return '"{}"'.format(str(value).replace("\\", "\\\\").replace('"', '\\"'))
    lines = []
    if source_address:
        lines.append("clientaddr {}".format(source_address))
    security_level = str(credentials.get("security_level") or "authPriv")
    lines.extend((
        "defSecurityLevel {}".format(security_level),
        "defSecurityName {}".format(quoted(credentials["username"])),
        "defAuthType {}".format(credentials["auth_protocol"]),
        "defAuthPassphrase {}".format(quoted(credentials["auth_password"])),
    ))
    if security_level.lower() == "authpriv":
        lines.extend((
            "defPrivType {}".format(credentials["privacy_protocol"]),
            "defPrivPassphrase {}".format(quoted(credentials["privacy_password"])),
        ))
    return "\n".join(lines) + "\n"


def remote_snmpget(cfg, monitoring_profile_name, ip, credentials, timeout=5):
    """Test from the monitoring host without placing SNMP secrets in argv."""
    monitoring_profile = cfg.get("monitoring_profiles", {}).get(
        monitoring_profile_name, {})
    host = str(monitoring_profile.get("host") or "").strip()
    if not host:
        raise gr.GrError(
            "Monitoring profile {} has no execution host".format(monitoring_profile_name))
    with gr.api_session(cfg, prompt=False) as api:
        matches = [row for row in inventory_rows(api)
                   if row_ip(row) == host or
                   str(row.get("hostname") or "").lower() == host.lower()]
    if len(matches) != 1:
        raise gr.GrError(
            "Monitoring execution host {} must match one phpIPAM address".format(host))
    row = matches[0]
    meta = gr.phpipam_ssh_metadata(row)
    if not meta["enabled"] or not meta["profile"] or not meta["user"]:
        raise gr.GrError("Incomplete SSH metadata for monitoring host {}".format(host))
    ssh_password = gr.read_vault_password(gr.vault_secret_name(cfg, meta["profile"]))
    config_text = snmp_config_text(credentials)
    # The complete script travels over stdin. Neither passphrase occurs in
    # the local or remote process argument list, and the quoted heredoc keeps
    # shell expansion disabled while writing the mode-0600 temporary file.
    script = """set -eu
umask 077
d=$(mktemp -d /tmp/gr-snmp-test.XXXXXX)
trap 'rm -rf "$d"' EXIT HUP INT TERM
cat > "$d/snmp.conf" <<'GR_SNMP_CONFIG_EOF'
{config}GR_SNMP_CONFIG_EOF
SNMPCONFPATH="$d" MIBS='' /usr/bin/snmpget -v3 -t {timeout} -r 0 -On {target} .1.3.6.1.2.1.1.5.0
""".format(config=config_text, timeout=int(timeout),
           target=str(ipaddress.ip_address(ip)))
    payload = script.encode("utf-8")
    read_fd, write_fd = os.pipe()
    try:
        os.write(write_fd, (ssh_password + "\n").encode("utf-8"))
        os.close(write_fd); write_fd = None
        client = "/usr/bin/ssh1" if meta.get("client") == "legacy" else "ssh"
        strict = "no" if meta.get("client") == "legacy" else "accept-new"
        command = ["sshpass", "-d", str(read_fd), client, "-F", "/dev/null",
                   "-o", "StrictHostKeyChecking={}".format(strict),
                   "-o", "UserKnownHostsFile={}".format(gr.ensure_known_hosts(cfg)),
                   "-o", "ConnectTimeout=10", "-o", "ConnectionAttempts=1",
                   "-p", str(meta.get("port") or 22),
                   "{}@{}".format(meta["user"], row_ip(row)), "/bin/sh", "-s"]
        process = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                   stderr=subprocess.PIPE, pass_fds=(read_fd,))
        _stdout, stderr = process.communicate(payload, timeout=timeout + 30)
    except subprocess.TimeoutExpired:
        process.kill(); process.wait()
        return 1, "Timeout while testing from monitoring host"
    finally:
        if write_fd is not None:
            os.close(write_fd)
        os.close(read_fd)
    detail = stderr.decode("utf-8", "replace").strip()
    for secret in (ssh_password, credentials["auth_password"],
                   credentials["privacy_password"]):
        detail = detail.replace(secret, "[REDACTED]")
    return process.returncode, detail


def snmp_test_status(returncode, detail):
    """Classify an authenticated probe without hiding an authentication error behind a timeout."""
    if returncode == 0:
        return "success"
    lower = str(detail or "").lower()
    authentication_markers = (
        "authentication failure", "unknown user", "unknown security name",
        "wrong digest", "decryption error", "incorrect password", "incorrect key",
    )
    if any(marker in lower for marker in authentication_markers):
        return "failed"
    if "timeout" in lower or "no response" in lower:
        return "timeout"
    return "failed"


def unauthenticated_probe(ip, timeout=2, source_address=""):
    with tempfile.TemporaryDirectory(prefix="gr-snmp-probe-") as directory:
        os.chmod(directory, 0o700)
        if source_address:
            config = os.path.join(directory, "snmp.conf")
            with open(config, "w", encoding="utf-8") as handle:
                handle.write("clientaddr {}\n".format(source_address))
            os.chmod(config, 0o600)
        environment = os.environ.copy(); environment["SNMPCONFPATH"] = directory
        command = ["snmpget", "-v3", "-l", "noAuthNoPriv", "-u", "GRportProbe",
                   "-t", str(timeout), "-r", "0", "-On", ip,
                   ".1.3.6.1.2.1.1.5.0"]
        result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                universal_newlines=True, timeout=timeout + 3, env=environment)
    detail = (result.stderr or result.stdout).strip()
    lower = detail.lower()
    if "timeout" in lower or "no response" in lower:
        return "no-response", detail
    if "network is unreachable" in lower or "no route to host" in lower:
        return "error", detail
    # An unknown-user/authentication REPORT still proves that an SNMP agent
    # answered the unauthenticated discovery exchange.
    return "responsive", detail


def cli_error_lines(output):
    patterns = (r"^%\s*(?:error|invalid|incomplete|unrecognized|unknown)",
                r"^\s*(?:unknown command|invalid input|incomplete command|ambiguous command)",
                r"wrong number of parameters|missing mandatory parameter",
                r"^\s*\^\s*$", r"too many parameters", r"illegal (?:command|parameter)")
    return [line.strip() for line in output.splitlines()
            if any(re.search(pattern, line, re.I) for pattern in patterns)]


def run_device_commands(cfg, row, commands, timeout=70, template=None, values=None):
    if not commands:
        return {"rc": 0, "output": "", "error": "", "timeout": False,
                "complete": True, "cli_errors": []}
    if not os.path.isfile(COLLECT_VERSION_PATH):
        raise gr.GrError("Missing interactive collection helper: {}".format(COLLECT_VERSION_PATH))
    helper = load_module("gr_snmp_collect_version", COLLECT_VERSION_PATH)
    meta = gr.phpipam_ssh_metadata(row)
    if not meta["enabled"] or not meta["profile"] or not meta["user"]:
        raise gr.GrError("Incomplete SSH metadata for {}".format(row_ip(row)))
    driver = gr.resolve_device_driver(row)
    template = template or {"handler": "generic-cli"}
    handler_values = dict(values or {})
    handler_values["save_session"] = any(
        re.search(r"(?i)^\s*(?:copy\s+running-config\s+startup-config|write\s+(?:memory|startup-config))\s*$",
                  command or "") for command in commands)
    context = {"driver": driver, "row": row, "values": handler_values}
    try:
        login = snmp_handlers.login_driver(gr, template, context)
    except snmp_handlers.HandlerError as exc:
        raise gr.GrError(str(exc))
    password = gr.read_vault_password(gr.vault_secret_name(cfg, meta["profile"]))
    known_hosts = gr.ensure_known_hosts(cfg)
    read_fd, write_fd = os.pipe()
    try:
        os.write(write_fd, (password + "\n").encode("utf-8")); os.close(write_fd)
        client = "/usr/bin/ssh1" if meta.get("client") == "legacy" else "ssh"
        strict = "no" if meta.get("client") == "legacy" else "accept-new"
        command = ["sshpass", "-d", str(read_fd), client, "-F", "/dev/null",
                   "-o", "StrictHostKeyChecking={}".format(strict),
                   "-o", "UserKnownHostsFile={}".format(known_hosts),
                   "-o", "ConnectTimeout=10", "-o", "ConnectionAttempts=1",
                   "-p", str(meta.get("port") or 22),
                   "{}@{}".format(meta["user"], row_ip(row)), commands[0]]
        item = {"user": meta["user"], "client": meta.get("client") or "normal"}
        rc, output, error, timed_out, complete = helper.run_interactive_device(
            item, password, command, read_fd, login, list(commands),
            snmp_handlers.exit_commands(template), timeout=timeout)
        read_fd = None
        # Firmware commonly echoes configuration commands.  Redact every
        # secret before the caller can verify, report or persist the output.
        secrets_to_redact = [password]
        for key in ("auth_password", "privacy_password"):
            if values and values.get(key):
                secrets_to_redact.append(values[key])
        for key in ("temporary_auth", "temporary_priv"):
            if context.get(key):
                secrets_to_redact.append(context[key])
        for secret in secrets_to_redact:
            output = output.replace(str(secret), "[REDACTED]")
            error = error.replace(str(secret), "[REDACTED]")
        return {"rc": rc, "output": output, "error": error.strip(), "timeout": timed_out,
                "complete": complete, "cli_errors": cli_error_lines(output)}
    finally:
        if read_fd is not None:
            try:
                os.close(read_fd)
            except OSError:
                pass


def report_path(cfg, name):
    root = gr.expand(cfg["snmp_report_dir"])
    os.makedirs(root, mode=0o700, exist_ok=True); os.chmod(root, 0o700)
    stamp = datetime.datetime.utcnow().strftime("%Y%m%dT%H%M%SZ")
    return os.path.join(root, "{}-{}".format(stamp, name))


def backup_configuration(ip, attempts=3):
    if not os.path.isfile(COLLECT_CONFIG_PATH):
        raise gr.GrError("Missing configuration backup helper: {}".format(COLLECT_CONFIG_PATH))
    result = None
    for attempt in range(1, max(1, int(attempts)) + 1):
        result = subprocess.run([sys.executable, COLLECT_CONFIG_PATH, "--ip", ip,
                                 "--workers", "1"], stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, universal_newlines=True)
        if result.returncode == 0:
            break
        if attempt < max(1, int(attempts)):
            print("BACKUP_RETRY={} target={}".format(attempt, ip))
            time.sleep(2)
    if result.returncode != 0:
        lines = (result.stderr or result.stdout).strip().splitlines()
        preferred = [line for line in lines if line.startswith(("RESULT ", "Archive failed:"))]
        detail = preferred[-1] if preferred else (
            lines[-1] if lines else "collector exit {}".format(result.returncode))
        raise gr.GrError("Pre-change backup failed for {}: {}".format(ip, detail[:240]))
    summary = [line for line in result.stdout.splitlines()
               if line.startswith(("SUMMARY=", "ARCHIVE=", "COMMIT="))]
    print("BACKUP_STATUS=success {}".format(" ".join(summary)))


def offline_facts(ip):
    try:
        item = gr.config_archive_target(ip)
        content = gr.git_archive_output(["show", "HEAD:{}".format(item["path"])])
    except Exception:
        return {"available": False}
    lower = content.lower()
    return {"available": True, "v3": bool(re.search(r"snmpv3|snmp-server\s+(?:user|group).*\bv3\b|usm-user", lower)),
            "legacy": bool(re.search(r"snmp-server\s+community|snmp-agent\s+community|config system snmp community", lower)),
            "user_visible": bool(re.search(r"snmp-server\s+user|usm-user", lower))}


def command_templates(cfg, templates, args):
    if args.target:
        with gr.api_session(cfg, prompt=False) as api:
            rows = [row for row in inventory_rows(api) if row_ip(row) == args.target or
                    str(row.get("hostname") or "").lower() == args.target.lower()]
        if len(rows) != 1:
            raise gr.GrError("Expected one template target")
        template, source = resolve_template(templates, rows[0])
        print("{} template={} source={} apply_supported={} actions={} reason={}".format(
            row_ip(rows[0]), template["id"], source, bool(template.get("apply_supported")),
            ",".join(template.get("supported_actions") or []) or "report,test",
            template.get("reason") or "-"))
        return 0
    for item in templates:
        print("{} apply_supported={} actions={} match={} reason={}".format(
            item["id"], bool(item.get("apply_supported")),
            ",".join(item.get("supported_actions") or []) or "report,test",
            json.dumps(item.get("match", {}), sort_keys=True), item.get("reason") or "-"))
    return 0


def validate_capability_commands(commands):
    """Refuse a capability probe that could become a configuration change."""
    navigation = {"configure terminal", "config", "end", "exit", "quit",
                  "terminal datadump", "terminal length 0", "no page"}
    for command in commands:
        probe_command = command[:-1] if command.endswith("\x03") else command
        normalized = probe_command.strip().lower()
        if normalized in navigation or normalized.startswith("show "):
            continue
        if (normalized.startswith("snmp-server ") and
                normalized.endswith("?")):
            continue
        raise gr.GrError(
            "Unsafe SNMP capability command in template: {}".format(command))


def sanitized_capability_output(output):
    """Make contextual help safe for parsing and terminal display."""
    text = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", str(output or ""))
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    return "".join(character for character in text
                   if character in "\n\t" or ord(character) >= 32)


def safe_apply_diagnostics(output, values):
    """Return device diagnostics without ever returning echoed secret commands.

    Cisco Business line editing can repaint a long command in fragments.  A
    full-value replacement is therefore insufficient: an individual repaint
    can contain only a prefix or suffix of a secret.  Reject every echoed
    prompt/command line and retain only standalone device error/warning lines.
    """
    text = sanitized_capability_output(output)
    for key in ("auth_password", "privacy_password"):
        secret = str(values.get(key) or "")
        if secret:
            text = text.replace(secret, "[REDACTED]")
    selected = []
    diagnostic = re.compile(
        r"^(?:%\s*)?(?:error|warning|invalid|wrong|failed|password|privacy)\b|"
        r"\b(?:error|warning|invalid|wrong|failed|complexity|minimum|maximum)\b",
        re.I)
    for line in text.splitlines():
        line = " ".join(line.split())
        lower = line.lower()
        if (not line or "snmp-server user" in lower or "[redacted]" in lower or
                re.search(r"[>#]\s*", line) or lower.startswith("password:")):
            continue
        if diagnostic.search(line):
            selected.append(re.sub(r"\S{32,}", "[VALUE_REDACTED]", line)[:240])
    return selected[-12:]


def command_capabilities(cfg, templates, args):
    """Inspect incomplete contextual help without creating SNMP objects."""
    with gr.api_session(cfg, prompt=False) as api:
        rows = select_rows(inventory_rows(api), args, require_enabled=False)
    failed = False
    for row in rows:
        template, source = resolve_template(templates, row)
        commands = render_commands(template, "capability", {}, redact=False)
        if not commands:
            print("TARGET={} TEMPLATE={} RESOLUTION={} CAPABILITY_STATUS=not_defined".format(
                row_ip(row), template["id"], source))
            failed = True
            continue
        validate_capability_commands(commands)
        session = run_device_commands(
            cfg, row, commands, template=template, values={"capability_probe": True})
        capability_output = sanitized_capability_output(session["output"])
        checks = snmp_handlers.capabilities(template, capability_output)
        confirmed = bool(checks.get("confirmed"))
        session_ok = session["complete"] and not session["timeout"]
        status = "confirmed" if confirmed and session_ok else "attention"
        print("TARGET={} TEMPLATE={} RESOLUTION={} READ_ONLY=True STATUS={}".format(
            row_ip(row), template["id"], source, status))
        print("CAPABILITIES={}".format(json.dumps(checks, sort_keys=True)))
        print("SESSION rc={} complete={} timeout={} cli_errors={}".format(
            session["rc"], session["complete"], session["timeout"],
            len(session["cli_errors"])))
        if not session["complete"] and session["error"]:
            print("SESSION_ERROR={}".format(session["error"].splitlines()[-1][:200]))
        if status != "confirmed":
            safe_help = capability_output.replace("GrProbeAuth9", "[DUMMY]")
            print("SAFE_CAPABILITY_HELP_BEGIN")
            print(safe_help[-12000:].strip())
            print("SAFE_CAPABILITY_HELP_END")
        failed = failed or status != "confirmed"
    print("CAPABILITY_PROBE_OBJECTS_CREATED=False")
    return 2 if failed else 0


def command_plan_or_apply(cfg, templates, args):
    with gr.api_session(cfg, prompt=False) as api:
        rows = select_rows(
            inventory_rows(api), args, require_enabled=not args.include_disabled)
    if args.include_disabled and (not args.ip or len(rows) != 1):
        raise gr.GrError(
            "--include-disabled is restricted to one explicit --ip pilot target")
    failed = False
    for row in rows:
        template, source = resolve_template(templates, row)
        credentials = profile_values(cfg, row, args, need_secrets=args.apply)
        values = variables(row, credentials, args, template)
        try:
            values = snmp_handlers.prepare(template, row, values, applying=args.apply)
        except snmp_handlers.HandlerError as exc:
            print("ERROR={}".format(exc))
            failed = True
            continue
        print("TARGET={} TEMPLATE={} RESOLUTION={} ACTION={} APPLY_SUPPORTED={}".format(
            row_ip(row), template["id"], source, args.action, bool(template.get("apply_supported"))))
        print("TEMPLATE_POLICY implicit_privacy={} monitoring_test_required={}".format(
            template.get("privacy_protocol_implicit") or "none",
            bool(template.get("require_monitoring_test"))))
        supported_actions = template.get("supported_actions") or (
            ["configure", "rotate", "cleanup"] if template.get("apply_supported") else [])
        if args.action not in supported_actions:
            print("ERROR=Action {} is not reviewed for this template; supported={}".format(
                args.action, ",".join(supported_actions) or "report,test"))
            failed = True
            continue
        commands = render_commands(template, args.action, values, redact=True)
        for command in commands:
            print("  {}".format(command))
        if not args.apply:
            continue
        if not template.get("apply_supported"):
            print("ERROR={}".format(template.get("reason") or "Template is report/test only"))
            failed = True
            continue
        if template.get("workflow") != "transactional-cli-v1":
            print("ERROR=Template has no reviewed transactional workflow; no commands sent")
            failed = True
            continue
        monitoring_required = bool(template.get("require_monitoring_test"))
        if monitoring_required and not args.monitoring_profile:
            print("ERROR=Template requires --monitoring-profile for a pre-save remote SNMP test")
            failed = True
            continue
        if args.action == "rotate" and not args.previous_profile:
            print("ERROR=--previous-profile is required for recoverable rotation")
            failed = True
            continue
        if "<SOURCE_REQUIRED>" in values.values():
            print("ERROR=Approved SNMP sources are missing; set profile sources or use --source")
            failed = True
            continue
        preflight = run_device_commands(
            cfg, row, render_commands(template, "inspect", values, redact=False),
            template=template, values=values)
        managed_terms = [values["username"], values["group"], values["view"], values["acl"]]
        managed_existing = [term for term in managed_terms
                            if term.lower() in preflight["output"].lower()]
        if args.action == "configure" and managed_existing:
            print("ERROR=Managed SNMP objects already exist: {}; use test/rotate or a reconciliation template".format(
                ",".join(managed_existing)))
            failed = True
            continue
        try:
            backup_configuration(row_ip(row))
        except gr.GrError as exc:
            print("ERROR={}".format(exc))
            failed = True
            continue
        actual_commands = render_commands(template, args.action, values, redact=False)
        rollback_commands = render_commands(template, args.action + "_rollback", values, redact=False)
        if args.action == "configure":
            actual_commands, rollback_commands = preserve_preexisting_snmp_state(
                template, preflight["output"], actual_commands, rollback_commands)
        if args.action == "cleanup":
            inspection = run_device_commands(
                cfg, row, render_commands(template, "inspect", values, redact=False),
                template=template, values=values)
            actual_commands, rollback_commands = snmp_handlers.cleanup_plan(
                template, inspection["output"], values)
            print("LEGACY_CLEANUP_COMMANDS={}".format(max(0, len(actual_commands) - 2)))
        if args.action == "rotate":
            previous_args = argparse.Namespace(profile=args.previous_profile, username=None,
                                               prompt_credentials=False)
            previous = profile_values(cfg, row, previous_args)
            previous_values = variables(row, previous, args, template)
            previous_values = snmp_handlers.prepare(template, row, previous_values, applying=True)
            rollback_commands = render_commands(template, "rotate", previous_values, redact=False)
        session = run_device_commands(cfg, row, actual_commands, template=template, values=values)
        verify_action = "inspect" if args.action == "cleanup" else "verify"
        verification = run_device_commands(
            cfg, row, render_commands(template, verify_action, values, redact=False),
            template=template, values=values)
        terms_ok, normalized_checks = snmp_handlers.verify(
            template, verification["output"], values, args.action)
        cli_verification_ok = (session["complete"] and not session["timeout"] and
                               not session["cli_errors"] and verification["complete"] and
                               not verification["timeout"] and not verification["cli_errors"])
        structurally_ok = cli_verification_ok and terms_ok
        privacy_probe = (cli_verification_ok and args.action != "cleanup" and
                         implicit_privacy_probe_candidate(template, normalized_checks))
        probe_allowed = structurally_ok or privacy_probe
        print("CLI_APPLY_COMPLETE={} CLI_ERRORS={} STRUCTURAL_VERIFY={}".format(
            session["complete"], len(session["cli_errors"]), structurally_ok))
        print("CLI_SAFE_DIAGNOSTICS={}".format(json.dumps(
            safe_apply_diagnostics(session["output"], values))))
        print("NORMALIZED_CHECKS={}".format(json.dumps(normalized_checks, sort_keys=True)))
        print("FUNCTIONAL_PRIVACY_PROBE={}".format(privacy_probe and not structurally_ok))
        test_rc, test_error = snmpget(
            row_ip(row), credentials, args.timeout) if probe_allowed else (
                1, "CLI verification failed")
        print("SHADOW_SNMP_TEST={}".format("success" if test_rc == 0 else "failed"))
        if privacy_probe and test_rc != 0:
            auth_only_credentials = dict(credentials, security_level="authNoPriv")
            auth_only_rc, _auth_only_error = snmpget(
                row_ip(row), auth_only_credentials, args.timeout)
            print("DIAGNOSTIC_AUTHNOPRIV_TEST={}".format(
                "success" if auth_only_rc == 0 else "failed"))
        monitoring_rc, monitoring_error = (0, "")
        if probe_allowed and test_rc == 0 and args.monitoring_profile:
            try:
                monitoring_rc, monitoring_error = remote_snmpget(
                    cfg, args.monitoring_profile, row_ip(row), credentials, args.timeout)
            except gr.GrError as exc:
                monitoring_rc, monitoring_error = 1, str(exc)
            print("MONITORING_SNMP_TEST={}".format(
                "success" if monitoring_rc == 0 else "failed"))
        elif monitoring_required:
            monitoring_rc, monitoring_error = 1, "Skipped because an earlier validation failed"
            print("MONITORING_SNMP_TEST=failed")
        effective_structure_ok = structurally_ok or (
            privacy_probe and test_rc == 0 and monitoring_rc == 0)
        if effective_structure_ok and test_rc == 0 and monitoring_rc == 0:
            saved = run_device_commands(
                cfg, row, render_commands(template, "save", values, redact=False),
                template=template, values=values)
            save_ok = saved["complete"] and not saved["timeout"] and not saved["cli_errors"]
            print("SAVE_SESSION complete={} timeout={} cli_errors={}".format(
                saved["complete"], saved["timeout"], len(saved["cli_errors"])))
            if not save_ok:
                rollback = run_device_commands(
                    cfg, row, rollback_commands, template=template,
                    values=values) if rollback_commands else None
                rollback_ok = bool(rollback and rollback["complete"] and
                                   not rollback["timeout"] and not rollback["cli_errors"])
                print("RESULT=save_failed SAVED=False ROLLBACK={}".format(
                    "success" if rollback_ok else "failed"))
                failed = True
                continue
            archive_ok = True
            if save_ok:
                try:
                    backup_configuration(row_ip(row))
                    print("FINAL_ARCHIVE_STATUS=success")
                except gr.GrError as exc:
                    print("FINAL_ARCHIVE_STATUS=failed ERROR={}".format(exc))
                    archive_ok = False
            print("RESULT={} SAVED=True".format(
                "success" if archive_ok else "archive_failed"))
            failed = failed or not archive_ok
        else:
            rollback = run_device_commands(
                cfg, row, rollback_commands, template=template, values=values) if rollback_commands else None
            rollback_ok = bool(rollback and rollback["complete"] and not rollback["cli_errors"])
            print("RESULT=failed ROLLBACK={} SNMP_TEST={}".format(
                "success" if rollback_ok else "failed", "failed" if test_rc else "success"))
            if test_error:
                print("SNMP_ERROR={}".format(test_error.splitlines()[-1][:200]))
            if monitoring_error:
                print("MONITORING_SNMP_ERROR={}".format(
                    monitoring_error.splitlines()[-1][:200]))
            failed = True
    if not args.apply:
        print("DRY_RUN=True Re-run with --apply only after reviewing the selected templates and commands.")
    return 2 if failed else 0


def command_test(cfg, templates, args):
    with gr.api_session(cfg, prompt=False) as api:
        rows = select_rows(inventory_rows(api), args, require_enabled=not args.include_disabled)
    results = []
    for row in rows:
        template, _ = resolve_template(templates, row)
        credentials = profile_values(cfg, row, args)
        rc, error = snmpget(row_ip(row), credentials, args.timeout)
        status = snmp_test_status(rc, error)
        results.append({"ip": row_ip(row), "hostname": row.get("hostname") or "",
                        "template": template["id"], "profile": credentials["profile"],
                        "status": status, "error": error.splitlines()[-1][:200] if error else ""})
        print("RESULT {} {} {} template={} profile={}".format(
            row.get("hostname") or row_ip(row), row_ip(row), status,
            template["id"], credentials["profile"] or "manual"))
    path = report_path(cfg, "snmp-test.json")
    with open(path, "w", encoding="utf-8") as handle:
        json.dump({"results": results}, handle, indent=2, sort_keys=True); handle.write("\n")
    os.chmod(path, 0o600)
    print("REPORT={}".format(path))
    return 0 if all(item["status"] == "success" for item in results) else 2


def command_report(cfg, templates, args):
    with gr.api_session(cfg, prompt=False) as api:
        rows = select_rows(inventory_rows(api), args, require_enabled=False)
    if args.managed_only:
        rows = [row for row in rows if managed_row(row)]
        if not rows:
            raise gr.GrError("No managed phpIPAM addresses matched the SNMP selection")
    records = []
    for row in rows:
        try:
            template, resolution = resolve_template(templates, row)
            template_id = template["id"]
            apply_supported = bool(template.get("apply_supported"))
            supported_actions = template.get("supported_actions") or ["report", "test"]
        except gr.GrError:
            resolution, template_id = "none", "none"
            apply_supported, supported_actions = False, ["report", "test"]
        record = {"ip": row_ip(row), "hostname": row.get("hostname") or "",
                  "driver": gr.resolve_device_driver(row), "template": template_id,
                  "device_model": str(custom(row, "device_model") or ""),
                  "device_os": str(row.get("_device_os") or ""),
                  "os_version": str(custom(row, "os_version") or ""),
                  "template_resolution": resolution,
                  "apply_supported": apply_supported,
                  "supported_actions": supported_actions,
                  "snmp_enabled": bool(int(custom(row, "snmp_enabled") or 0)),
                  "snmp_profile": str(custom(row, "snmp_profile") or ""),
                  "last_seen": str(row.get("lastSeen") or ""),
                  "monitoring_enabled": bool(int(custom(row, "monitoring_enabled") or 0)),
                  "monitoring_device_id": str(custom(row, "monitoring_device_id") or "")}
        if args.mode == "offline":
            record.update(offline_facts(record["ip"]))
        elif args.mode == "live":
            try:
                template, _resolution = resolve_template(templates, row)
                credentials = {"username": "", "auth_password": "", "privacy_password": ""}
                values = variables(row, credentials, args, template)
                values = snmp_handlers.prepare(template, row, values, applying=False)
                live = run_device_commands(cfg, row, render_commands(template, "inspect", values,
                                                                      redact=False),
                                           template=template, values=values)
                record.update({"live_complete": live["complete"], "live_timeout": live["timeout"],
                               "live_cli_errors": live["cli_errors"], "snmp_output": live["output"]})
            except gr.GrError as exc:
                record.update({"live_complete": False, "live_error": str(exc)})
        elif args.mode == "ports":
            try:
                profile_name = args.profile or str(custom(row, "snmp_profile") or "").strip()
                profile = cfg.get("snmp_profiles", {}).get(profile_name, {}) if profile_name else {}
                _sources, source_address = profile_network_values(profile_name, profile)
                record["udp_161"], detail = unauthenticated_probe(
                    record["ip"], args.timeout, source_address)
                record["probe_source_address"] = source_address or "auto"
                record["probe_detail"] = detail.splitlines()[-1][:200] if detail else ""
            except (OSError, subprocess.TimeoutExpired) as exc:
                record["udp_161"] = "error"
                record["probe_detail"] = str(exc)[:200]
        records.append(record)
        print("RESULT {} {} template={} snmp_enabled={} mode={}".format(
            record["hostname"] or record["ip"], record["ip"], record["template"],
            record["snmp_enabled"], args.mode))
    path = report_path(cfg, "snmp-{}.json".format(args.mode))
    with open(path, "w", encoding="utf-8") as handle:
        json.dump({"mode": args.mode, "results": records}, handle, indent=2, sort_keys=True); handle.write("\n")
    os.chmod(path, 0o600)
    csv_path = path[:-5] + ".csv"
    fieldnames = sorted(set(key for record in records for key in record if key != "snmp_output"))
    with open(csv_path, "w", encoding="utf-8", newline="") as handle:
        writer = csv.DictWriter(handle, fieldnames=fieldnames, extrasaction="ignore")
        writer.writeheader()
        for record in records:
            writer.writerow({key: (json.dumps(value, sort_keys=True) if isinstance(value, (dict, list)) else value)
                             for key, value in record.items() if key != "snmp_output"})
    os.chmod(csv_path, 0o600)
    print("REPORT={}".format(path)); print("CSV_REPORT={}".format(csv_path)); return 0


def command_assign(cfg, templates, args):
    with gr.api_session(cfg, prompt=False) as api:
        rows = select_rows(inventory_rows(api), args, require_enabled=False)
    changes = []
    for row in rows:
        template_id = args.template or ""
        if args.enabled == "yes" and not template_id:
            template_id = resolve_template(templates, row)[0]["id"]
        if args.enabled == "yes" and not args.profile:
            raise gr.GrError("--profile is required when SNMP is enabled")
        payload = {"custom_snmp_enabled": 1 if args.enabled == "yes" else 0,
                   "custom_snmp_profile": args.profile or "",
                   "custom_snmp_template": template_id if args.enabled == "yes" else ""}
        if args.monitoring_profile:
            payload.update({"custom_monitoring_enabled": 1,
                            "custom_monitoring_profile": args.monitoring_profile})
        changes.append((row, payload))
        print("{} {} template={} profile={} monitoring={}".format(
            "APPLY" if args.apply else "PLAN", row_ip(row), template_id,
            args.profile, args.monitoring_profile or "disabled"))
    if not args.apply:
        print("DRY_RUN=True Re-run with --apply to update phpIPAM custom fields.")
        return 0
    write_cfg = dict(cfg); write_cfg["app_id"] = cfg.get("migration_app_id", "gr-migrate")
    with gr.api_session(write_cfg) as api:
        for row, payload in changes:
            api.request("PATCH", "addresses/{}/".format(row["id"]), payload=payload)
            data = response_row(api.request("GET", "addresses/{}/".format(row["id"])))
            if not isinstance(data, dict) or str(gr.custom_value(data, "snmp_template") or "") != payload["custom_snmp_template"]:
                raise gr.GrError("phpIPAM verification failed for {}".format(row_ip(row)))
    print("ASSIGN_STATUS=success count={}".format(len(changes))); return 0


def command_inventory_sync(cfg, args):
    reports = [gr.expand(report) for report in args.report]
    by_result_ip = {}
    for report in reports:
        with open(report, encoding="utf-8") as handle:
            data = json.load(handle)
        results = data.get("results", []) if isinstance(data, dict) else []
        if not isinstance(results, list):
            raise gr.GrError("Version report has no results array: {}".format(report))
        for result in results:
            ip = str(result.get("ip") or "")
            if ip and result.get("result") in (None, "success"):
                by_result_ip[ip] = result
    with gr.api_session(cfg, prompt=False) as api:
        rows = inventory_rows(api)
    by_ip = {row_ip(row): row for row in rows}
    changes = []
    unchanged = 0
    for ip in sorted(by_result_ip, key=lambda value: ipaddress.ip_address(value)):
        result = by_result_ip[ip]
        ip = str(result.get("ip") or "")
        row = by_ip.get(ip)
        if not row:
            continue
        payload = {"custom_device_model": str(result.get("model") or "").strip(),
                   "custom_os_version": str(result.get("firmware") or "").strip()}
        payload = {key: value for key, value in payload.items() if value}
        if not payload:
            continue
        current = {"custom_device_model": str(custom(row, "device_model") or "").strip(),
                   "custom_os_version": str(custom(row, "os_version") or "").strip()}
        if all(current.get(key) == value for key, value in payload.items()):
            unchanged += 1
            print("UNCHANGED {} model={} os_version={}".format(
                ip, current["custom_device_model"] or "-", current["custom_os_version"] or "-"))
            continue
        changes.append((row, payload))
        print("{} {} model={} os_version={}".format(
            "APPLY" if args.apply else "PLAN", ip,
            payload.get("custom_device_model", "-"), payload.get("custom_os_version", "-")))
    if not args.apply:
        print("REPORTS={} UNIQUE_TARGETS={} CHANGES={} UNCHANGED={}".format(
            len(reports), len(by_result_ip), len(changes), unchanged))
        print("DRY_RUN=True Re-run with --apply to synchronize model/OS version metadata.")
        return 0
    write_cfg = dict(cfg); write_cfg["app_id"] = cfg.get("migration_app_id", "gr-migrate")
    with gr.api_session(write_cfg) as api:
        for row, payload in changes:
            api.request("PATCH", "addresses/{}/".format(row["id"]), payload=payload)
            data = response_row(api.request("GET", "addresses/{}/".format(row["id"])))
            if not isinstance(data, dict):
                raise gr.GrError("phpIPAM metadata verification failed for {}".format(row_ip(row)))
            verified = {
                "custom_device_model": str(gr.custom_value(data, "device_model") or "").strip(),
                "custom_os_version": str(gr.custom_value(data, "os_version") or "").strip(),
            }
            if any(verified.get(key) != value for key, value in payload.items()):
                raise gr.GrError("phpIPAM metadata verification failed for {}".format(row_ip(row)))
    print("INVENTORY_SYNC_STATUS=success changed={} unchanged={}".format(
        len(changes), unchanged))
    return 0


def monitoring_request(profile, token, method, path, payload=None):
    context = ssl.create_default_context(cafile=gr.expand(profile.get("ca_file") or
                                                          "/etc/ssl/certs/ca-certificates.crt"))
    base = str(profile.get("url") or "").rstrip("/")
    data = json.dumps(payload).encode("utf-8") if payload is not None else None
    request = urllib.request.Request(base + path, data=data, method=method,
                                     headers={"X-Auth-Token": token, "Accept": "application/json",
                                              "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(request, context=context, timeout=60) as response:
            raw = response.read().decode("utf-8")
            return response.status, json.loads(raw) if raw else {}
    except urllib.error.HTTPError as exc:
        raw = exc.read().decode("utf-8", "replace")
        try:
            body = json.loads(raw)
        except ValueError:
            body = {"message": raw[:300]}
        return exc.code, body


def monitoring_poll(profile, device_id):
    host = str(profile.get("host") or "").strip()
    if not host:
        raise gr.GrError("Monitoring profile host is required for --poll")
    try:
        normalized_device_id = str(int(device_id))
    except (TypeError, ValueError):
        raise gr.GrError("LibreNMS device ID must be numeric for --poll")
    poll_command = (
        "cd /opt/librenms && exec ./lnms device:poll {} --no-interaction"
    ).format(normalized_device_id)
    command = ["gr", "exec", host, "--sudo", "--no-audit", "--",
               "/usr/bin/sudo", "-H", "-u", "librenms",
               "/bin/sh", "-lc", poll_command]
    result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            universal_newlines=True, timeout=900)
    detail = "\n".join(part.strip() for part in (result.stdout, result.stderr)
                         if part and part.strip())
    return result.returncode, detail


def poll_error_summary(detail):
    lines = [line.strip() for line in str(detail or "").splitlines() if line.strip()]
    actionable = [line for line in lines if not line.startswith("Executing on ")]
    return (actionable or lines or ["unknown"])[-1][:200]


def command_monitor(cfg, templates, args):
    profile_name = args.monitoring_profile
    profile = cfg.get("monitoring_profiles", {}).get(profile_name, {})
    if profile.get("type") != "librenms":
        raise gr.GrError("Monitoring profile {} is not a LibreNMS profile".format(profile_name))
    token = gr.read_vault_password(str(profile.get("token_secret") or ""))
    with gr.api_session(cfg, prompt=False) as api:
        rows = select_rows(inventory_rows(api), args, require_enabled=False)
    updates = []
    failed = False
    for row in rows:
        ip = row_ip(row)
        code, body = monitoring_request(profile, token, "GET", "/devices/{}".format(
            urllib.parse.quote(ip, safe="")))
        devices = body.get("devices") if isinstance(body, dict) else None
        device = devices[0] if code == 200 and devices else None
        if device is None and args.add:
            credentials = profile_values(cfg, row, args)
            payload = {"hostname": ip, "snmpver": "v3", "port": 161,
                       "transport": "udp", "authlevel": "authPriv",
                       "authname": credentials["username"], "authalgo": credentials["auth_protocol"],
                       "authpass": credentials["auth_password"],
                       "cryptoalgo": credentials["privacy_protocol"],
                       "cryptopass": credentials["privacy_password"]}
            if args.apply:
                add_code, _ = monitoring_request(profile, token, "POST", "/devices", payload)
                if add_code not in (200, 201):
                    print("RESULT {} add_failed http={}".format(ip, add_code)); failed = True; continue
                code, body = monitoring_request(profile, token, "GET", "/devices/{}".format(
                    urllib.parse.quote(ip, safe="")))
                devices = body.get("devices") if isinstance(body, dict) else None
                device = devices[0] if code == 200 and devices else None
            else:
                print("PLAN {} add_to_librenms profile={}".format(ip, profile_name)); continue
        if device is not None and args.sync_credentials:
            credentials = profile_values(cfg, row, args)
            credential_fields = ["snmpver", "authlevel", "authname", "authpass",
                                 "authalgo", "cryptopass", "cryptoalgo"]
            credential_data = ["v3", "authPriv", credentials["username"],
                               credentials["auth_password"], credentials["auth_protocol"],
                               credentials["privacy_password"], credentials["privacy_protocol"]]
            if args.apply:
                update_code, _update_body = monitoring_request(
                    profile, token, "PATCH", "/devices/{}".format(
                        urllib.parse.quote(str(device.get("device_id") or ip), safe="")),
                    {"field": credential_fields, "data": credential_data})
                if update_code != 200:
                    print("RESULT {} credential_sync_failed http={}".format(ip, update_code))
                    failed = True
                    continue
                print("CREDENTIAL_SYNC {} updated=True verification=next_poller_run".format(ip))
            else:
                print("PLAN {} sync_librenms_credentials profile={}".format(ip,
                                                                            credentials["profile"]))
                continue
        if device is None:
            print("RESULT {} missing lastSeen={}".format(ip, row.get("lastSeen") or "-")); failed = True; continue
        if args.poll:
            if not args.apply:
                print("PLAN {} poll_librenms_device id={}".format(ip, device.get("device_id")))
                continue
            poll_rc, poll_error = monitoring_poll(profile, device.get("device_id"))
            if poll_rc:
                print("RESULT {} poll_failed detail={}".format(
                    ip, poll_error_summary(poll_error)))
                failed = True
                continue
            code, body = monitoring_request(profile, token, "GET", "/devices/{}".format(
                urllib.parse.quote(ip, safe="")))
            devices = body.get("devices") if isinstance(body, dict) else None
            device = devices[0] if code == 200 and devices else device
            print("POLL {} success=True".format(ip))
        status = bool(device.get("status"))
        print("RESULT {} present id={} up={} last_polled={} phpipam_lastSeen={}".format(
            ip, device.get("device_id"), status, device.get("last_polled") or "-",
            row.get("lastSeen") or "-"))
        updates.append((row, str(device.get("device_id") or "")))
        failed = failed or not status
    if args.apply and updates:
        write_cfg = dict(cfg); write_cfg["app_id"] = cfg.get("migration_app_id", "gr-migrate")
        with gr.api_session(write_cfg) as api:
            for row, device_id in updates:
                api.request("PATCH", "addresses/{}/".format(row["id"]), payload={
                    "custom_monitoring_enabled": 1,
                    "custom_monitoring_profile": profile_name,
                    "custom_monitoring_device_id": device_id})
    if (args.add or args.sync_credentials or args.poll) and not args.apply:
        print("DRY_RUN=True Re-run with --apply to change LibreNMS and persist associations.")
    return 2 if failed else 0


def add_selectors(parser):
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--all", action="store_true")
    group.add_argument("--ip", action="append")
    group.add_argument("--subnet")
    group.add_argument("--range", dest="ip_range", metavar="START-END")
    group.add_argument("--file", help="text or CSV file containing IP addresses")
    parser.add_argument("--exclude-ip", action="append", default=[],
                        help="exclude one IP address; repeat for OOBM or duplicate paths")


def build_parser():
    parser = argparse.ArgumentParser(prog="gr snmp", description=__doc__)
    parser.add_argument("--config")
    sub = parser.add_subparsers(dest="action", required=True)
    templates = sub.add_parser("templates"); templates.add_argument("--target")
    capabilities = sub.add_parser(
        "capabilities", help="read-only contextual-help probe for candidate handlers")
    add_selectors(capabilities)
    for action in ("configure", "rotate", "cleanup"):
        command = sub.add_parser(action); add_selectors(command)
        command.add_argument("--apply", action="store_true")
        command.add_argument(
            "--include-disabled", action="store_true",
            help="pilot one explicit --ip before SNMP intent is enabled in phpIPAM")
        command.add_argument("--profile"); command.add_argument("--username")
        command.add_argument("--prompt-credentials", action="store_true")
        command.add_argument("--previous-profile",
                             help="vault-backed old profile required for recoverable rotation")
        command.add_argument("--timeout", type=int, default=5)
        command.add_argument(
            "--monitoring-profile",
            help="SSH execution host used for the pre-save remote SNMP test")
        command.add_argument("--source", action="append")
        command.add_argument("--group")
        command.add_argument("--view")
        command.add_argument("--acl")
    test = sub.add_parser("test"); add_selectors(test)
    test.add_argument("--profile"); test.add_argument("--username")
    test.add_argument("--prompt-credentials", action="store_true")
    test.add_argument("--include-disabled", action="store_true")
    test.add_argument("--timeout", type=int, default=5)
    report = sub.add_parser("report"); add_selectors(report)
    report.add_argument("--mode", choices=("offline", "ports", "inventory", "live"), default="inventory")
    report.add_argument("--profile",
                        help="SNMP profile used to bind a ports probe to source_address")
    report.add_argument("--timeout", type=float, default=2.0)
    report.add_argument("--source", action="append")
    report.add_argument("--group")
    report.add_argument("--view")
    report.add_argument("--acl")
    report.add_argument("--managed-only", action="store_true",
                        help="report only rows with a managed driver or explicit SNMP/monitoring intent")
    assign = sub.add_parser("assign"); add_selectors(assign)
    assign.add_argument("--enabled", choices=("yes", "no"), default="yes")
    assign.add_argument("--profile"); assign.add_argument("--template")
    assign.add_argument("--monitoring-profile"); assign.add_argument("--apply", action="store_true")
    inventory_sync = sub.add_parser("inventory-sync",
                                    help="import model and OS version from a collect-version JSON report")
    inventory_sync.add_argument("--report", action="append", required=True,
                                help="collect-version JSON report; repeat and later reports win per IP")
    inventory_sync.add_argument("--apply", action="store_true")
    monitor = sub.add_parser("monitor"); add_selectors(monitor)
    monitor.add_argument("--monitoring-profile", required=True)
    monitor.add_argument("--add", action="store_true"); monitor.add_argument("--apply", action="store_true")
    monitor.add_argument("--sync-credentials", action="store_true",
                         help="update SNMPv3 fields on an existing LibreNMS device")
    monitor.add_argument("--poll", action="store_true",
                         help="run and validate an immediate LibreNMS poll (requires --apply)")
    monitor.add_argument("--profile"); monitor.add_argument("--username")
    monitor.add_argument("--prompt-credentials", action="store_true")
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    cfg = gr.load_config(args.config)
    _path, templates = load_templates(cfg)
    if args.action == "templates":
        return command_templates(cfg, templates, args)
    if args.action == "capabilities":
        return command_capabilities(cfg, templates, args)
    if args.action in ("configure", "rotate", "cleanup"):
        return command_plan_or_apply(cfg, templates, args)
    if args.action == "test":
        return command_test(cfg, templates, args)
    if args.action == "report":
        return command_report(cfg, templates, args)
    if args.action == "assign":
        return command_assign(cfg, templates, args)
    if args.action == "inventory-sync":
        return command_inventory_sync(cfg, args)
    if args.action == "monitor":
        return command_monitor(cfg, templates, args)
    raise gr.GrError("Unsupported SNMP action")


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (gr.GrError, ValueError, OSError) as exc:
        print("gr snmp: error: {}".format(exc), file=sys.stderr)
        sys.exit(2)
