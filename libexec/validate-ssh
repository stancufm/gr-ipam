#!/usr/bin/env python3
"""Validate SSH metadata and driver-aware read-only connectivity in bulk."""

import argparse
import concurrent.futures
import datetime
import importlib.machinery
import importlib.util
import ipaddress
import json
import os
import re
import shutil
import subprocess
import sys


GR_PATH = os.environ.get("GR_PATH", "/usr/local/bin/gr")
POOL_MANAGER_PATH = os.environ.get(
    "GR_CONFIG_POOL_MANAGER", "/usr/local/libexec/gr/config-collection-pools")


def load_source(name, path):
    loader = importlib.machinery.SourceFileLoader(name, path)
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def load_gr():
    return load_source("gr_module", GR_PATH)


def load_pool_manager():
    if not os.path.isfile(POOL_MANAGER_PATH):
        raise RuntimeError("Collection pool manager is missing: {}".format(POOL_MANAGER_PATH))
    return load_source("gr_config_pool_manager", POOL_MANAGER_PATH)


def parse_ip_range(value):
    try:
        first_text, last_text = str(value).split("-", 1)
        first = ipaddress.ip_address(first_text.strip())
        last = ipaddress.ip_address(last_text.strip())
    except (ValueError, AttributeError):
        raise argparse.ArgumentTypeError("range must use START-END with valid IP addresses")
    if first.version != last.version or int(first) > int(last):
        raise argparse.ArgumentTypeError(
            "range endpoints must use one family and START must not exceed END")
    return first, last


def parse_subnet(value):
    try:
        return ipaddress.ip_network(str(value).strip(), strict=False)
    except ValueError as exc:
        raise argparse.ArgumentTypeError(str(exc))


def normalized_row_ip(gr, row):
    return gr.normalize_ip(row.get("ip"))


def select_rows(gr, cfg, rows, args, pool_manager=None):
    """Resolve one explicit selector and return unique phpIPAM rows plus missing IPs."""
    missing = []
    if args.ips:
        requested = []
        for value in args.ips:
            parsed = gr.normalize_ip(value)
            if parsed is None:
                raise ValueError("Invalid IP address: {}".format(value))
            requested.append(str(parsed))
        requested_set = set(requested)
        selected = [row for row in rows
                    if str(normalized_row_ip(gr, row) or "") in requested_set]
        present = {str(normalized_row_ip(gr, row)) for row in selected}
        missing = sorted(requested_set - present)
        label = "ip:" + ",".join(requested)
    elif args.ip_range:
        first, last = args.ip_range
        selected = []
        for row in rows:
            current = normalized_row_ip(gr, row)
            if (current is not None and current.version == first.version
                    and first <= current <= last):
                selected.append(row)
        label = "range:{}-{}".format(first, last)
    elif args.subnet:
        selected = []
        for row in rows:
            current = normalized_row_ip(gr, row)
            if current is not None and current in args.subnet:
                selected.append(row)
        label = "subnet:{}".format(args.subnet)
    elif args.pool:
        pool_manager = pool_manager or load_pool_manager()
        parsed = pool_manager.validate_configuration(
            cfg, allowed_drivers=getattr(gr, "DEVICE_DRIVERS", None))
        pool = parsed["pools"].get(args.pool)
        if pool is None:
            raise ValueError("Unknown configuration pool: {}".format(args.pool))
        selected = [row for row in rows if pool_manager.matches_pool(gr, row, pool)]
        label = "pool:{}".format(args.pool)
    elif args.all:
        selected = list(rows)
        label = "all"
    else:
        raise ValueError("Choose --all, --ip, --pool, --range or --subnet/--class")

    unique = {}
    for row in selected:
        current = normalized_row_ip(gr, row)
        if current is not None:
            unique.setdefault(str(current), row)
    return [unique[key] for key in sorted(unique, key=ipaddress.ip_address)], missing, label


def prepare_item(gr, cfg, row):
    meta = gr.phpipam_ssh_metadata(row)
    profile = str(meta.get("profile") or "").strip()
    profile_cfg = cfg.get("ssh_profiles", {}).get(profile, {}) if profile else {}
    if not isinstance(profile_cfg, dict):
        profile_cfg = {}
    secret = gr.vault_secret_name(cfg, profile) if profile else ""
    identity = str(profile_cfg.get("identity_file") or "").strip()
    if identity:
        identity = gr.expand(identity)
    hostname = str(row.get("hostname") or "").strip() or "-"
    normalized_ip = str(normalized_row_ip(gr, row) or row.get("ip") or "")
    vendor = str(gr.custom_value(row, "device_vendor") or "").strip().lower()
    driver_error = ""
    try:
        driver = gr.resolve_device_driver(row)
        spec = gr.device_driver_spec(driver)
    except Exception as exc:
        driver = str(gr.custom_value(row, "device_driver") or "").strip().lower() or "invalid"
        spec = {}
        driver_error = str(exc)
    expected_vendor = str(spec.get("vendor") or "").strip().lower()
    commands = tuple(spec.get("validation_commands") or ())
    client = str(meta.get("client") or "normal")
    item = {
        "id": row.get("id"), "ip": normalized_ip, "hostname": hostname,
        "enabled": bool(meta.get("enabled")), "user": meta.get("user") or "",
        "port": int(meta.get("port") or 22), "profile": profile, "secret": secret,
        "identity": identity, "jump": meta.get("jump") or "", "client": client,
        "driver": driver, "vendor": vendor, "expected_vendor": expected_vendor,
        "validation_commands": list(commands),
        "interactive": bool(spec.get("interactive_cli")),
    }
    if not item["enabled"]:
        result = "ssh_disabled"
    elif not item["user"]:
        result = "ssh_user_missing"
    elif not meta.get("port"):
        result = "ssh_port_missing"
    elif not profile:
        result = "profile_missing"
    elif driver_error:
        result = "driver_invalid"
        item["detail"] = driver_error
    elif driver == "generic":
        result = "driver_missing"
    elif not commands:
        result = "driver_validation_unsupported"
    elif not vendor:
        result = "vendor_missing"
    elif expected_vendor and vendor != expected_vendor:
        result = "vendor_driver_mismatch"
    elif client not in ("normal", "legacy"):
        result = "ssh_client_invalid"
    elif secret and gr.vault_secret_exists(secret):
        result = "ready"
        item["auth_mode"] = "vault"
    elif identity and os.path.isfile(identity):
        result = "ready"
        item["auth_mode"] = "key"
    elif secret:
        result = "vault_secret_missing"
    elif identity:
        result = "identity_file_missing"
    else:
        result = "profile_not_configured"
    item["result"] = result
    return item


def classify_failure(returncode, combined, timed_out=False, complete=True, cli_errors=0):
    text = str(combined or "").lower()
    if timed_out:
        return "timeout"
    if "permission denied" in text or "authentication failed" in text:
        return "authentication_failed"
    if "host key verification failed" in text or "remote host identification has changed" in text:
        return "host_key_failed"
    if "no route to host" in text or "network is unreachable" in text:
        return "network_unreachable"
    if "connection refused" in text:
        return "connection_refused"
    if cli_errors:
        return "driver_command_failed"
    if not complete:
        return "driver_sequence_incomplete"
    return "ssh_failed" if returncode else "driver_validation_failed"


def build_ssh_command(gr, item, known_hosts, remote_command):
    client_binary = "/usr/bin/ssh1" if item["client"] == "legacy" else "ssh"
    if not shutil.which(client_binary):
        raise RuntimeError("SSH client is not installed: {}".format(client_binary))
    command = [client_binary, "-F", "/dev/null", "-p", str(item["port"]),
               "-o", "UserKnownHostsFile={}".format(known_hosts)]
    command.extend(gr.ssh_connection_options(item["client"]))
    if item["identity"]:
        command.extend(["-i", item["identity"]])
    if item["jump"]:
        command.extend(["-J", item["jump"]])
    command.extend(["{}@{}".format(item["user"], item["ip"]), remote_command])
    return command


def validate_one(gr, item, passwords, known_hosts_dir):
    password = passwords.get(item["profile"])
    known_hosts = os.path.join(
        known_hosts_dir, re.sub(r"[^A-Za-z0-9_.-]", "_", item["ip"]))
    placeholder = ("gr-interactive-placeholder" if item["interactive"]
                   else item["validation_commands"][0])
    read_fd = None
    try:
        command = build_ssh_command(gr, item, known_hosts, placeholder)
        if password:
            command, read_fd = gr.ssh_with_password(command, password)
        if item["interactive"]:
            if read_fd is None:
                read_fd, write_fd = os.pipe()
                os.close(write_fd)
            login_driver = gr.device_login_driver(item["driver"])
            returncode, stdout, stderr, timed_out, complete = gr.run_interactive_device(
                {"user": item["user"]}, password or "", command, read_fd,
                login_driver, item["validation_commands"],
                tuple(gr.device_driver_spec(item["driver"]).get("cleanup_commands") or ()),
                timeout=90, command_timeout=30)
            read_fd = None
            cli_errors = len(gr.DEVICE_CLI_ERROR_RE.findall(stdout))
            item["returncode"] = returncode
            item["timeout"] = timed_out
            item["complete"] = complete
            item["cli_errors"] = cli_errors
            if complete and not timed_out and cli_errors == 0:
                item["result"] = "success"
            else:
                item["result"] = classify_failure(
                    returncode, stderr + "\n" + stdout, timed_out, complete, cli_errors)
        else:
            completed = subprocess.run(
                command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                universal_newlines=True, timeout=45,
                pass_fds=((read_fd,) if read_fd is not None else ()))
            if read_fd is not None:
                os.close(read_fd)
                read_fd = None
            item["returncode"] = completed.returncode
            item["stdout"] = completed.stdout.strip()[-1000:]
            item["stderr"] = completed.stderr.strip()[-1000:]
            item["result"] = ("success" if completed.returncode == 0 else
                              classify_failure(completed.returncode,
                                               completed.stdout + "\n" + completed.stderr))
    except subprocess.TimeoutExpired as exc:
        item["result"] = "timeout"
        item["stdout"] = (exc.stdout or "")[-1000:] if isinstance(exc.stdout, str) else ""
        item["stderr"] = (exc.stderr or "")[-1000:] if isinstance(exc.stderr, str) else ""
    except Exception as exc:
        item["result"] = "validator_error"
        item["detail"] = str(exc)
    finally:
        if read_fd is not None:
            try:
                os.close(read_fd)
            except OSError:
                pass
    return item


def build_parser():
    parser = argparse.ArgumentParser(
        description="Validate driver-aware SSH access for an explicit phpIPAM target set")
    parser.add_argument("--config")
    parser.add_argument("--run", action="store_true")
    parser.add_argument("--workers", type=int, default=6)
    selector = parser.add_mutually_exclusive_group(required=True)
    selector.add_argument("--all", action="store_true")
    selector.add_argument("--ip", action="append", dest="ips")
    selector.add_argument("--pool")
    selector.add_argument("--range", dest="ip_range", type=parse_ip_range,
                          metavar="START-END")
    selector.add_argument("--subnet", "--class", dest="subnet", type=parse_subnet,
                          metavar="CIDR")
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    gr = load_gr()
    cfg = gr.load_config(args.config)
    with gr.api_session(cfg, prompt=False) as client:
        rows = client.addresses()
    try:
        selected_rows, missing, selector = select_rows(gr, cfg, rows, args)
    except Exception as exc:
        print("gr ssh validate: error: {}".format(exc), file=sys.stderr)
        return 2
    selected = [prepare_item(gr, cfg, row) for row in selected_rows]
    for ip in missing:
        selected.append({
            "id": None, "ip": ip, "hostname": "-", "enabled": False,
            "user": "", "port": 22, "profile": "", "client": "normal",
            "driver": "-", "vendor": "-", "expected_vendor": "-",
            "validation_commands": [], "interactive": False,
            "result": "not_in_phpipam",
        })
    selected.sort(key=lambda item: (item["hostname"].lower(), item["ip"]))
    counts = {}
    for item in selected:
        counts[item["result"]] = counts.get(item["result"], 0) + 1
    print("SELECTOR={} MATCHED={} STATUS={}".format(
        selector, len(selected), json.dumps(counts, sort_keys=True)))
    for item in selected:
        commands = "; ".join(item["validation_commands"]) or "-"
        print("{:<25} {:<15} {:<26} driver={} vendor={} command={}".format(
            item["hostname"], item["ip"], item["result"], item["driver"],
            item["vendor"] or "-", commands))
    if not selected:
        print("No phpIPAM addresses matched the explicit selector.", file=sys.stderr)
        return 1
    if not args.run:
        print("List-only. Re-run with --run and the same selector to validate SSH.")
        return 0 if all(item["result"] == "ready" for item in selected) else 2

    passwords = {}
    for profile in sorted({item["profile"] for item in selected
                           if item["result"] == "ready"
                           and item.get("auth_mode") == "vault"}):
        passwords[profile] = gr.read_vault_password(gr.vault_secret_name(cfg, profile))
    state_dir = os.path.expanduser("~/.local/state/gr/ssh-validation")
    os.makedirs(state_dir, mode=0o700, exist_ok=True)
    known_hosts_dir = os.path.join(state_dir, "known-hosts")
    os.makedirs(known_hosts_dir, mode=0o700, exist_ok=True)
    ready = [item for item in selected if item["result"] == "ready"]
    with concurrent.futures.ThreadPoolExecutor(
            max_workers=max(1, min(args.workers, 12))) as executor:
        futures = [executor.submit(validate_one, gr, item, passwords, known_hosts_dir)
                   for item in ready]
        for future in concurrent.futures.as_completed(futures):
            item = future.result()
            print("RESULT {:<25} {:<15} {} driver={} vendor={}".format(
                item["hostname"], item["ip"], item["result"],
                item["driver"], item["vendor"]))
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    report = os.path.join(state_dir, "ssh-validation-{}.json".format(stamp))
    with open(report, "w", encoding="utf-8") as handle:
        json.dump(selected, handle, ensure_ascii=False, indent=2, sort_keys=True)
        handle.write("\n")
    os.chmod(report, 0o600)
    final = {}
    for item in selected:
        final[item["result"]] = final.get(item["result"], 0) + 1
    print("SUMMARY={}".format(json.dumps(final, sort_keys=True)))
    print("REPORT={}".format(report))
    return 0 if all(item["result"] == "success" for item in selected) else 2


if __name__ == "__main__":
    sys.exit(main())
