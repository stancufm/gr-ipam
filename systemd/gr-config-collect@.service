[Unit]
Description=Run GR configuration collection pool %i
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/gr/collector.json

[Service]
Type=oneshot
User=gr-collector
Group=gr-collector
SupplementaryGroups=gr-config
Environment=HOME=/var/lib/gr-collector
ExecStart=/usr/local/bin/gr --config /etc/gr/collector.json collect config --pool %i
UMask=0007
Nice=10
IOSchedulingClass=best-effort
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/gr /etc/jumpserver-ha
ReadWritePaths=/var/lib/gr/config-archive /var/lib/gr-collector
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
TimeoutStartSec=30m
