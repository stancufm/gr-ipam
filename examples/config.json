{
  "app_id": "gr-app",
  "migration_app_id": "gr-migrate",
  "base_url": "https://ipam.example.net",
  "ca_file": "/etc/gr/phpipam-ca.pem",
  "credential_file": "~/.config/gr/credentials",
  "device_version_dir": "~/.local/state/gr/device-version",
  "hosts_file": "/etc/hosts",
  "hosts_sync_enabled": false,
  "include_tags": [2],
  "ssh_legacy_fallback": true,
  "ssh_audit_enabled": false,
  "ssh_audit_dir": "~/.local/state/gr/audit",
  "ssh_known_hosts": "~/.local/state/gr/known_hosts",
  "ssh_output": "~/.ssh/config.d/90-phpipam.conf",
  "ssh_profiles": {
    "network-admin": {"password_secret": "gr/network-admin"},
    "linux-admin": {"password_secret": "gr/linux-admin"},
    "linux-separate-sudo": {
      "password_secret": "gr/linux-separate-sudo",
      "sudo_password_secret": "gr/linux-separate-sudo-sudo"
    },
    "shared-network": {"password_secret": "gr/shared-network"}
  },
  "snmp_template_file": "/etc/gr/snmp-templates.json",
  "snmp_report_dir": "~/.local/state/gr/snmp-reports",
  "snmp_profiles": {
    "monitoring-v3": {
      "username": "snmp-monitor",
      "auth_protocol": "SHA",
      "privacy_protocol": "AES",
      "sources": ["192.0.2.20", "192.0.2.21", "192.0.2.22"],
      "source_address": "192.0.2.20",
      "auth_secret": "gr/snmpv3/monitoring-v3/auth",
      "privacy_secret": "gr/snmpv3/monitoring-v3/priv"
    }
  },
  "monitoring_profiles": {
    "librenms": {
      "type": "librenms",
      "url": "https://monitoring.example.net/api/v0",
      "ca_file": "/etc/ssl/certs/ca-certificates.crt",
      "token_secret": "gr/monitoring/librenms/token",
      "host": "monitoring.example.net"
    }
  },
  "config_collection": {
    "state_dir": "~/.local/state/gr/config-collection",
    "scheduler_enabled": false,
    "pools": {}
  },
  "username": "gr-api",
  "vendor_db_dir": "/var/lib/gr/ieee-vendors"
}
