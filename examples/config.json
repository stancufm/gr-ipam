{
  "app_id": "gr-app",
  "migration_app_id": "gr-migrate",
  "base_url": "https://ipam.example.net",
  "ca_file": "/etc/gr/phpipam-ca.pem",
  "credential_file": "~/.config/gr/credentials",
  "device_version_dir": "~/.local/state/gr/device-version",
  "hosts_file": "/etc/hosts",
  "hosts_sync_enabled": false,
  "include_tags": [2],
  "ssh_legacy_fallback": false,
  "ssh_audit_enabled": false,
  "ssh_audit_dir": "~/.local/state/gr/audit",
  "ssh_output": "~/.ssh/config.d/90-phpipam.conf",
  "ssh_profiles": {
    "network-admin": {"password_secret": "gr/network-admin"},
    "linux-admin": {"password_secret": "gr/linux-admin"},
    "cisco-smb": {
      "password_secret": "gr/cisco-smb",
      "session_driver": "cisco-small-business"
    }
  },
  "username": "gr-api",
  "vendor_db_dir": "/var/lib/gr/ieee-vendors"
}
