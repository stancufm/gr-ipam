      "verification_terms": ["{username}", "{group}", "{acl}", "{source_1}", "{source_2}", "{source_3}"],
      "save_commands": ["write memory"],
      "configure_rollback_commands": ["configure terminal", "no snmp-server user {username} {group} v3", "no snmp-server group {group} v3 priv", "no snmp-server view {view} iso included", "no ip access-list standard {acl}", "end"],
      "rotate_rollback_commands": []
