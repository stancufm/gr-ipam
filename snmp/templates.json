      "defaults": {"group": "SNMP_DEFAULT_GROUP", "view": "SNMP_DEFAULT_VIEW", "acl": "SNMP_MON_SRV_ACL"},
      "apply_supported": true,
      "supported_actions": ["configure", "rotate", "cleanup"],
      "workflow": "transactional-cli-v1",
      "inspect_commands": ["show running-config | section ^snmp", "show snmp user", "show access-lists {acl}"],
      "configure_commands": ["configure terminal", "snmp-server view {view} iso included", "ip access-list standard {acl}", "10 permit {source_1}", "20 permit {source_2}", "30 permit {source_3}", "90 deny any log", "exit", "snmp-server group {group} v3 priv read {view} access {acl}", "snmp-server user {username} {group} v3 auth {auth_protocol} {auth_cli} priv aes 128 {privacy_cli}", "end"],
