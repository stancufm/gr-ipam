class GrError(Exception):
    pass


def expand(path):
    return os.path.abspath(os.path.expanduser(path))


def read_json_config(path, required=True):
    path = expand(path)
    try:
        with open(path, encoding="utf-8") as handle:
            data = json.load(handle)
        if not isinstance(data, dict):
            raise ValueError("top-level JSON value must be an object")
        return data
    except FileNotFoundError:
        if not required:
            return {}
        raise GrError("Cannot read config {}: file does not exist".format(path))
    except (OSError, ValueError) as exc:
        raise GrError("Cannot read config {}: {}".format(path, exc))


def merge_config(base, override):
    merged = dict(base)
    for key, value in override.items():
        if key in ("ssh_profiles", "snmp_profiles", "monitoring_profiles") and isinstance(value, dict) and isinstance(merged.get(key), dict):
            profiles = dict(merged[key])
            profiles.update(value)
            merged[key] = profiles
        else:
            merged[key] = value
    return merged


def load_config(path=None):
    if path:
        source = expand(path)
        cfg = read_json_config(source)
        sources = [source]
    else:
        cfg = read_json_config(SYSTEM_CONFIG)
        sources = [SYSTEM_CONFIG]
        if os.path.isfile(USER_CONFIG):
            cfg = merge_config(cfg, read_json_config(USER_CONFIG))
            sources.append(USER_CONFIG)
    required = ("base_url", "app_id", "username", "ca_file", "credential_file")
    missing = [key for key in required if not cfg.get(key)]
    if missing:
        raise GrError("Missing config keys: {}".format(", ".join(missing)))
    cfg["base_url"] = cfg["base_url"].rstrip("/")
    cfg["ca_file"] = expand(cfg["ca_file"])
    cfg["credential_file"] = expand(cfg["credential_file"])
    cfg["hosts_file"] = expand(cfg.get("hosts_file", "/etc/hosts"))
    cfg["ssh_output"] = expand(cfg.get("ssh_output", "~/.ssh/config.d/90-phpipam.conf"))
    cfg["include_tags"] = [str(value) for value in cfg.get("include_tags", [2])]
    cfg["ssh_legacy_fallback"] = bool(cfg.get("ssh_legacy_fallback", True))
    cfg["ssh_audit_enabled"] = bool(cfg.get("ssh_audit_enabled", False))
    cfg["ssh_audit_dir"] = expand(cfg.get("ssh_audit_dir", "~/.local/state/gr/audit"))
    cfg["ssh_known_hosts"] = expand(cfg.get("ssh_known_hosts", "~/.local/state/gr/known_hosts"))
    cfg["hosts_sync_enabled"] = bool(cfg.get("hosts_sync_enabled", False))
    cfg["ssh_profiles"] = cfg.get("ssh_profiles", {})
    cfg["device_version_dir"] = expand(cfg.get("device_version_dir", "~/.local/state/gr/device-version"))
    cfg["vendor_db_dir"] = expand(cfg.get("vendor_db_dir", "/var/lib/gr/ieee-vendors"))
    cfg["snmp_template_file"] = expand(cfg.get("snmp_template_file", "/etc/gr/snmp-templates.json"))
    cfg["snmp_report_dir"] = expand(cfg.get("snmp_report_dir", "~/.local/state/gr/snmp-reports"))
    cfg["snmp_profiles"] = cfg.get("snmp_profiles", {})
    cfg["monitoring_profiles"] = cfg.get("monitoring_profiles", {})
    cfg["_config_sources"] = sources
    return cfg


def config_display(value, missing="-"):
    if value is None:
        return missing
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (dict, list)):
        return json.dumps(value, sort_keys=True, separators=(",", ":"))
    return str(value)


def profile_count(value):
    if value is None:
        return "-"
    count = len(value) if isinstance(value, dict) else 0
    return "{} profile{}".format(count, "" if count == 1 else "s")


PROFILE_CONFIG_KEYS = ("password_secret", "sudo_password_secret", "identity_file")
SNMP_PROFILE_CONFIG_KEYS = ("username", "auth_protocol", "privacy_protocol",
                            "auth_secret", "privacy_secret", "sources", "source_address")
MONITORING_PROFILE_CONFIG_KEYS = ("type", "url", "ca_file", "token_secret", "host")


def config_setting_path(scope):
    if scope == "global":
        if os.geteuid() != 0:
            raise GrError("Global configuration requires: sudo gr config set/unset ... --scope global")
        return SYSTEM_CONFIG, 0o644
    return USER_CONFIG, 0o600


def validate_config_setting_name(name):
    parts = str(name or "").split(".")
    top_level = {item[0] for item in CONFIG_OPTIONS}
    if (len(parts) == 1 and parts[0] in top_level and
            parts[0] not in ("ssh_profiles", "snmp_profiles", "monitoring_profiles")):
        return parts
    profile_keys = {"ssh_profiles": PROFILE_CONFIG_KEYS,
                    "snmp_profiles": SNMP_PROFILE_CONFIG_KEYS,
                    "monitoring_profiles": MONITORING_PROFILE_CONFIG_KEYS}
    if (len(parts) == 3 and parts[0] in profile_keys and
            re.match(r"^[A-Za-z0-9._-]+$", parts[1]) and
            parts[2] in profile_keys[parts[0]]):
        return parts
    raise GrError("Unsupported configuration setting: {}".format(name))


def parse_config_setting(name, value):
    parts = validate_config_setting_name(name)
    if (len(parts) == 3 and parts[0] == "snmp_profiles" and
            parts[2] == "source_address"):
        try:
            return str(ipaddress.ip_address(str(value).strip()))
        except ValueError as exc:
            raise GrError("{} contains an invalid IP address: {}".format(name, exc))
    if len(parts) == 3 and parts[0] == "snmp_profiles" and parts[2] == "sources":
        try:
            parsed_sources = json.loads(value)
        except ValueError:
            raise GrError("{} expects a JSON list of IP addresses".format(name))
        if not isinstance(parsed_sources, list) or not parsed_sources:
            raise GrError("{} expects a non-empty JSON list".format(name))
        try:
            return [str(ipaddress.ip_address(str(item))) for item in parsed_sources]
        except ValueError as exc:
            raise GrError("{} contains an invalid IP address: {}".format(name, exc))
    defaults = dict(CONFIG_OPTIONS)
    default = defaults.get(parts[0])
    if isinstance(default, bool):
        normalized = str(value).strip().lower()
        if normalized in ("true", "yes", "on", "1"):
            return True
        if normalized in ("false", "no", "off", "0"):
            return False
        raise GrError("{} expects true or false".format(name))
    if isinstance(default, list):
        try:
            parsed = json.loads(value)
        except ValueError:
            raise GrError("{} expects a JSON list".format(name))
        if not isinstance(parsed, list):
            raise GrError("{} expects a JSON list".format(name))
        return parsed
    return str(value)


def write_config_settings(path, data, mode):
    directory = os.path.dirname(path)
    os.makedirs(directory, mode=0o700 if mode == 0o600 else 0o755, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".gr-config-", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(data, handle, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def command_config_change(action, name, value=None, scope="user"):
    parts = validate_config_setting_name(name)
    path, mode = config_setting_path(scope)
    data = read_json_config(path, required=False)
    if action == "set":
        parsed = parse_config_setting(name, value)
        if len(parts) == 1:
            data[parts[0]] = parsed
        else:
            profiles = data.setdefault(parts[0], {})
            profile = profiles.setdefault(parts[1], {})
            profile[parts[2]] = parsed
    else:
        if len(parts) == 1:
            data.pop(parts[0], None)
        else:
            profiles = data.get(parts[0], {})
            profile = profiles.get(parts[1], {})
            profile.pop(parts[2], None)
            if not profile:
                profiles.pop(parts[1], None)
            if not profiles:
                data.pop(parts[0], None)
    write_config_settings(path, data, mode)
    print("{} {} configuration setting {} in {}".format(
        "Set" if action == "set" else "Removed", scope, name, path))
    return 0


def print_config_table(columns, rows):
    widths = [len(column) for column in columns]
    rendered = []
    for row in rows:
        values = [config_display(value) for value in row]
        rendered.append(values)
        widths = [max(width, len(value)) for width, value in zip(widths, values)]
    print("  ".join(column.ljust(width) for column, width in zip(columns, widths)))
    print("  ".join("-" * width for width in widths))
    for row in rendered:
        print("  ".join(value.ljust(width) for value, width in zip(row, widths)))


def command_config_show(cfg, custom_path=None):
    global_cfg = read_json_config(SYSTEM_CONFIG, required=False)
    user_cfg = read_json_config(USER_CONFIG, required=False)
    custom_cfg = read_json_config(custom_path) if custom_path else None
    rows = []
    for key, default in CONFIG_OPTIONS:
        global_value = global_cfg.get(key)
        user_value = user_cfg.get(key)
        if custom_cfg is not None:
            source = "custom" if key in custom_cfg else ("default" if default is not None else "required")
        elif key in user_cfg:
            source = "user"
        elif key in global_cfg:
            source = "global"
        else:
            source = "default" if default is not None else "required"
        profile_prefixes = {
            "ssh_profiles": "ssh_profiles",
            "snmp_profiles": "snmp_profiles",
            "monitoring_profiles": "monitoring_profiles",
        }
        if key in profile_prefixes:
            rows.append((key, profile_count(default), profile_count(global_value),
                         profile_count(user_value), profile_count(cfg.get(key)), source))
            global_profiles = global_value if isinstance(global_value, dict) else {}
            user_profiles = user_value if isinstance(user_value, dict) else {}
            effective_profiles = cfg.get(key) if isinstance(cfg.get(key), dict) else {}
            profile_names = sorted(set(global_profiles) | set(user_profiles) | set(effective_profiles),
                                   key=str.lower)
            for profile in profile_names:
                global_profile = global_profiles.get(profile, {})
                user_profile = user_profiles.get(profile, {})
                effective_profile = effective_profiles.get(profile, {})
                fields = sorted(set(global_profile) | set(user_profile) | set(effective_profile),
                                key=str.lower)
                for field in fields:
                    if field in user_profile:
                        profile_source = "user"
                    elif field in global_profile:
                        profile_source = "global"
                    else:
                        profile_source = "effective"
                    rows.append(("{}.{}.{}".format(profile_prefixes[key], profile, field), "-",
                                 global_profile.get(field), user_profile.get(field),
                                 effective_profile.get(field), profile_source))
            continue
        rows.append((key, config_display(default, "<required>"), global_value,
                     user_value, cfg.get(key), source))
    print("Global configuration: {}{}".format(
        SYSTEM_CONFIG, " (missing)" if not os.path.isfile(SYSTEM_CONFIG) else ""))
    print("User configuration:   {}{}".format(
        USER_CONFIG, " (missing)" if not os.path.isfile(USER_CONFIG) else ""))
    if custom_path:
        print("Effective custom file: {}".format(expand(custom_path)))
    print()
    print_config_table(("OPTION", "DEFAULT", "GLOBAL", "USER", "EFFECTIVE", "SOURCE"), rows)
    return 0


IEEE_VENDOR_SOURCES = {
    "MA-L": "https://standards-oui.ieee.org/oui/oui.csv",
    "MA-M": "https://standards-oui.ieee.org/oui28/mam.csv",
    "MA-S": "https://standards-oui.ieee.org/oui36/oui36.csv",
}


def normalize_mac(value):
    matches = re.findall(r"(?:[0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}|[0-9A-Fa-f]{12}", str(value or ""))
    if not matches:
        return ""
    compact = re.sub(r"[^0-9A-Fa-f]", "", matches[0]).upper()
    return compact if len(compact) == 12 else ""


def canonical_vendor(value):
    text = str(value or "").strip()
    lower = text.lower()
    rules = [
        ("cisco", "cisco"), ("aruba", "hpe-aruba"), ("hewlett", "hpe-aruba"),
        ("h3c", "h3c"), ("dell", "dell"), ("juniper", "juniper"),
        ("fortinet", "fortinet"), ("ubiquiti", "ubiquiti"),
        ("mikrotik", "mikrotik"), ("extreme", "extreme"),
        ("allied telesis", "allied-telesis"), ("brocade", "brocade"),
        ("ruckus", "ruckus"), ("vmware", "vmware"), ("intel", "intel"),
        ("super micro", "supermicro"), ("supermicro", "supermicro"),
        ("raspberry", "raspberry-pi"), ("synology", "synology"), ("qnap", "qnap"),
        ("brother", "brother-industries"),
        ("giga-byte", "giga-byte-technology"),
        ("planet technology", "planet-technology"),
    ]
    for needle, result in rules:
        if needle in lower:
            return result
    return re.sub(r"[^a-z0-9]+", "-", lower).strip("-")[:64]


def vendor_db_paths(cfg):
    return {registry: os.path.join(cfg["vendor_db_dir"], registry.lower().replace("-", "") + ".csv")
            for registry in IEEE_VENDOR_SOURCES}


def command_vendor_update_db(cfg):
    directory = cfg["vendor_db_dir"]
    system_database = directory == "/var/lib/gr/ieee-vendors" or directory.startswith("/var/lib/gr/")
    if system_database and getattr(os, "geteuid", lambda: 1)() != 0:
        raise GrError("The shared vendor database is root-owned. Run: sudo gr vendor update-db")
    os.makedirs(directory, mode=0o755 if system_database else 0o700, exist_ok=True)
    if system_database:
        os.chmod(directory, 0o755)
    metadata = {"updated_utc": dt.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ"), "sources": {}}
    for registry, url in IEEE_VENDOR_SOURCES.items():
        target = vendor_db_paths(cfg)[registry]
        request = urllib.request.Request(url, headers={"User-Agent": "gr-ieee-vendor/1.0"})
        try:
            with urllib.request.urlopen(request, timeout=60) as response:
                content = response.read()
        except (urllib.error.URLError, OSError) as exc:
            raise GrError("Cannot download {} from IEEE: {}".format(registry, exc))
        text = content.decode("utf-8-sig", "replace")
        rows = list(csv.DictReader(text.splitlines()))
        if len(rows) < 100 or not rows or "Assignment" not in rows[0] or "Organization Name" not in rows[0]:
            raise GrError("Invalid or incomplete IEEE {} database".format(registry))
        fd, temp_path = tempfile.mkstemp(prefix=".{}-".format(registry.lower()), dir=directory)
        try:
            with os.fdopen(fd, "wb") as handle:
                handle.write(content)
            os.chmod(temp_path, 0o644 if system_database else 0o600)
            os.replace(temp_path, target)
        finally:
            if os.path.exists(temp_path):
                os.unlink(temp_path)
        metadata["sources"][registry] = {"url": url, "records": len(rows), "bytes": len(content),
                                          "sha256": hashlib.sha256(content).hexdigest()}
        print("Updated {}: {} records".format(registry, len(rows)))
    meta_path = os.path.join(directory, "metadata.json")
    fd, temp_path = tempfile.mkstemp(prefix=".metadata-", dir=directory)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump(metadata, handle, indent=2, sort_keys=True)
    os.chmod(temp_path, 0o644 if system_database else 0o600)
    os.replace(temp_path, meta_path)
    print("Vendor database: {}".format(directory))
    return 0


def load_vendor_db(cfg):
    entries = []
    for registry, path in vendor_db_paths(cfg).items():
        if not os.path.isfile(path):
            raise GrError("Vendor database is missing. Run: gr vendor update-db")
        with open(path, encoding="utf-8-sig", errors="replace") as handle:
            for row in csv.DictReader(handle):
                assignment = re.sub(r"[^0-9A-Fa-f]", "", row.get("Assignment", "")).upper()
                organization = str(row.get("Organization Name") or "").strip()
                if assignment and organization:
                    entries.append((len(assignment), assignment, registry, organization))
    entries.sort(reverse=True)
    return entries


def vendor_lookup(entries, mac):
    compact = normalize_mac(mac)
    if not compact:
        raise GrError("Invalid MAC address: {}".format(mac))
    if int(compact[:2], 16) & 2:
        return {"mac": ":".join(compact[i:i+2] for i in range(0, 12, 2)),
                "registry": "", "assignment": "", "organization": "",
                "vendor": "", "status": "locally-administered"}
    for _, assignment, registry, organization in entries:
        if compact.startswith(assignment):
            return {"mac": ":".join(compact[i:i+2] for i in range(0, 12, 2)),
                    "registry": registry, "assignment": assignment,
                    "organization": organization, "vendor": canonical_vendor(organization),
                    "status": "matched"}
    return {"mac": ":".join(compact[i:i+2] for i in range(0, 12, 2)),
            "registry": "", "assignment": "", "organization": "", "vendor": "", "status": "not-found"}


def command_vendor_lookup(cfg, macs):
    entries = load_vendor_db(cfg)
    for mac in macs:
        result = vendor_lookup(entries, mac)
        print("{}  status={} registry={} prefix={} vendor={} organization={}".format(
            result["mac"], result["status"], result["registry"] or "-",
            result["assignment"] or "-", result["vendor"] or "-", result["organization"] or "-"))
    return 0


def vendor_counts(rows):
    counts = {}
    names = {}
    for row in rows:
        vendor = str(custom_value(row, "device_vendor") or "").strip()
        if not vendor:
            continue
        key = vendor.lower()
        names.setdefault(key, vendor)
        counts[key] = counts.get(key, 0) + 1
    return [(names[key], counts[key]) for key in sorted(counts)]


def command_vendor_list(cfg):
    with api_session(cfg, prompt=False) as client:
        values = vendor_counts(client.addresses())
    if not values:
        print("No device_vendor values are configured in phpIPAM.")
        return 0
    print_audit_table(("VENDOR", "ADDRESSES"),
                      [(vendor, str(count)) for vendor, count in values])
    return 0


def command_vendor_sync(cfg, apply=False, overwrite=False):
    entries = load_vendor_db(cfg)
    api_cfg = dict(cfg)
    if apply:
        api_cfg["app_id"] = cfg.get("migration_app_id", "gr-migrate")
    counts = {"matched": 0, "candidate": 0, "same": 0, "conflict": 0,
              "missing_mac": 0, "not_found": 0, "locally_administered": 0,
              "updated": 0, "failed": 0}
    audit = []
    with api_session(api_cfg) as client:
        for row in client.addresses():
            compact = normalize_mac(row.get("mac"))
            if not compact:
                counts["missing_mac"] += 1
                continue
            found = vendor_lookup(entries, compact)
            if found["status"] == "locally-administered":
                counts["locally_administered"] += 1
                continue
            if found["status"] != "matched":
                counts["not_found"] += 1
                continue
            counts["matched"] += 1
            current = str(custom_value(row, "device_vendor") or "").strip()
            desired = found["vendor"]
            item = {"id": row.get("id"), "ip": str(normalize_ip(row.get("ip")) or row.get("ip")),
                    "hostname": row.get("hostname"), "mac": found["mac"],
                    "registry": found["registry"], "assignment": found["assignment"],
                    "organization": found["organization"], "before": current, "desired": desired}
            if current == desired:
                item["status"] = "same"
                counts["same"] += 1
            elif current and not overwrite:
                item["status"] = "conflict"
                counts["conflict"] += 1
            else:
                item["status"] = "candidate"
                counts["candidate"] += 1
                if apply:
                    try:
                        client.request("PATCH", "addresses/{}/".format(row.get("id")),
                                       payload={"custom_device_vendor": desired})
                        after = client.request("GET", "addresses/{}/".format(row.get("id")))
                        actual = str(custom_value(after or {}, "device_vendor") or "").strip()
                        if actual != desired:
                            raise GrError("verification returned {!r}".format(actual))
                        item["status"] = "updated"
                        counts["updated"] += 1
                    except Exception as exc:
                        item["status"] = "failed"
                        item["error"] = str(exc)
                        counts["failed"] += 1
            audit.append(item)
    stamp = dt.datetime.utcnow().strftime("%Y%m%dT%H%M%SZ")
    report = expand("~/.local/state/gr/vendor-sync/vendor-{}-{}.json".format(
        "apply" if apply else "preview", stamp))
    os.makedirs(os.path.dirname(report), mode=0o700, exist_ok=True)
    with open(report, "w", encoding="utf-8") as handle:
        json.dump({"apply": apply, "overwrite": overwrite, "counts": counts, "entries": audit},
                  handle, ensure_ascii=False, indent=2)
    os.chmod(report, 0o600)
    print("Vendor sync: {}".format(json.dumps(counts, sort_keys=True)))
    print("Report: {}".format(report))
    if not apply:
        print("Dry-run only. Re-run with --apply to write verified changes.")
    return 2 if counts["failed"] else 0


def read_password(cfg, prompt=True):
    env_password = os.environ.get("GR_API_PASSWORD")
    if env_password:
        return env_password
    try:
        mode = os.stat(cfg["credential_file"]).st_mode & 0o777
        if mode & 0o077:
            raise GrError("Credential file must be mode 0600: {}".format(cfg["credential_file"]))
        with open(cfg["credential_file"], encoding="utf-8") as handle:
            password = handle.read().rstrip("\r\n")
        if password:
            return password
    except FileNotFoundError:
        pass
    except OSError as exc:
        raise GrError("Cannot read credential file: {}".format(exc))
    if prompt and sys.stdin.isatty():
        return getpass.getpass("phpIPAM password for {}: ".format(cfg["username"]))
    raise GrError("No API password. Run: gr auth configure")


class PhpIpamClient:
    def __init__(self, cfg, password):
        self.cfg = cfg
        self.password = password
        self.token = None
        if not os.path.isfile(cfg["ca_file"]):
            raise GrError("Pinned CA file is missing: {}".format(cfg["ca_file"]))
        self.ssl_context = ssl.create_default_context(cafile=cfg["ca_file"])
        self.api_base = "{}/api/{}".format(cfg["base_url"], urllib.parse.quote(cfg["app_id"], safe=""))

    def request(self, method, path, auth=False, token=True, payload=None):
        url = self.api_base + "/" + path.lstrip("/")
        headers = {"Accept": "application/json", "User-Agent": "gr-phpipam/1.0"}
        if auth:
            raw = "{}:{}".format(self.cfg["username"], self.password).encode("utf-8")
            headers["Authorization"] = "Basic " + base64.b64encode(raw).decode("ascii")
        elif token:
            if not self.token:
                raise GrError("API token is unavailable")
            headers["phpipam-token"] = self.token
        body = None
        if payload is not None:
            body = json.dumps(payload).encode("utf-8")
            headers["Content-Type"] = "application/json"
        request = urllib.request.Request(url, data=body, method=method, headers=headers)
        try:
            with urllib.request.urlopen(request, context=self.ssl_context, timeout=30) as response:
                payload = response.read().decode("utf-8")
        except urllib.error.HTTPError as exc:
            body = exc.read().decode("utf-8", "replace")
            try:
                message = json.loads(body).get("message", body)
            except ValueError:
                message = body
            raise GrError("phpIPAM HTTP {}: {}".format(exc.code, message))
        except (urllib.error.URLError, OSError) as exc:
            raise GrError("phpIPAM connection failed: {}".format(exc))
        try:
            data = json.loads(payload)
        except ValueError:
            raise GrError("phpIPAM returned invalid JSON")
        if not data.get("success"):
            raise GrError("phpIPAM API error {}: {}".format(data.get("code"), data.get("message", "unknown")))
        return data.get("data")

    def login(self):
        data = self.request("POST", "user/", auth=True, token=False) or {}
        self.token = data.get("token")
        if not self.token:
            raise GrError("phpIPAM did not return a token")
        return data

    def logout(self):
        if not self.token:
            return
        try:
            self.request("DELETE", "user/")
        except GrError:
            pass
        self.token = None

    def addresses(self):
        data = self.request("GET", "addresses/all/")
        return data if isinstance(data, list) else []

    def subnets(self):
        data = self.request("GET", "subnets/all/")
        return data if isinstance(data, list) else []

    def permissions(self):
        return self.request("OPTIONS", "") or {}


@contextlib.contextmanager
def api_session(cfg, prompt=True):
    client = PhpIpamClient(cfg, read_password(cfg, prompt=prompt))
    client.login()
    try:
        yield client
    finally:
        client.logout()


def normalize_ip(value):
    text = str(value or "").strip()
    if not text:
        return None
    try:
        if text.isdigit():
            return ipaddress.ip_address(int(text))
        return ipaddress.ip_address(text)
    except ValueError:
        return None


def clean_hostname(value):
    hostname = str(value or "").strip().rstrip(".")
    if not hostname or not HOSTNAME_RE.match(hostname):
        return None
    return hostname


def clean_comment(value):
    return " ".join(str(value or "").replace("#", " ").split())[:180]


def ssh_port(value):
    try:
        port = int(value)
    except (TypeError, ValueError):
        raise argparse.ArgumentTypeError("port must be an integer")
    if not 1 <= port <= 65535:
        raise argparse.ArgumentTypeError("port must be between 1 and 65535")
    return port


def ssh_user(value):
    value = str(value or "").strip()
    if not re.match(r"^[A-Za-z0-9._-]+$", value):
        raise argparse.ArgumentTypeError("SSH user may contain only letters, digits, dot, underscore and hyphen")
    return value


def profile_name(value):
    value = str(value or "").strip()
    if not re.match(r"^[A-Za-z0-9._-]+$", value):
        raise argparse.ArgumentTypeError("profile may contain only letters, digits, dot, underscore and hyphen")
    return value


def device_vendor(value):
    value = str(value or "").strip().lower()
    if not re.match(r"^[a-z0-9][a-z0-9._-]{0,63}$", value):
        raise argparse.ArgumentTypeError(
            "device vendor may contain only lowercase letters, digits, dot, underscore and hyphen"
        )
    return value


def normalized_addresses(rows):
    output = []
    for row in rows:
        ip = normalize_ip(row.get("ip"))
        if ip is None:
            continue
        item = dict(row)
        item["_ip"] = ip
        item["_hostname"] = clean_hostname(row.get("hostname"))
        output.append(item)
    output.sort(key=lambda item: (item["_ip"].version, int(item["_ip"])))
    return output


def sync_addresses(cfg, rows):
    """Return only records explicitly allowed for generated resolver files."""
    allowed = set(cfg.get("include_tags", ["2"]))
    return [row for row in rows if str(row.get("tag") or "") in allowed]


def duplicate_hostnames(rows):
    counts = {}
    for row in normalized_addresses(rows):
        hostname = row.get("_hostname")
        if hostname:
            key = hostname.lower()
            counts[key] = counts.get(key, 0) + 1
    return {name for name, count in counts.items() if count > 1}


def tag_label(row):
    value = str(row.get("tag") or "")
    return {"1": "Offline", "2": "Used", "3": "Reserved", "4": "DHCP"}.get(value, value or "-")


def custom_value(row, name):
    key = "custom_" + name
    if key in row:
        return row.get(key)
    nested = row.get("custom_fields")
    if isinstance(nested, dict):
        return nested.get(key, nested.get(name))
    return row.get(name)


def truthy(value):
    return str(value or "").strip().lower() in ("1", "true", "yes", "on", "enabled")


def phpipam_ssh_metadata(row):
    enabled = truthy(custom_value(row, "ssh_enabled"))
    user = str(custom_value(row, "ssh_user") or "").strip()
    port = str(custom_value(row, "ssh_port") or "").strip()
    profile = str(custom_value(row, "ssh_profile") or "").strip()
    jump = str(custom_value(row, "ssh_jump") or "").strip()
    client = str(custom_value(row, "ssh_client") or "normal").strip().lower()
    driver = str(custom_value(row, "device_driver") or "").strip().lower()
    if client not in ("normal", "legacy"):
        client = "invalid"
    valid_port = port.isdigit() and 1 <= int(port) <= 65535
    return {
        "enabled": enabled,
        "user": user,
        "port": port if valid_port else "",
        "profile": profile,
        "jump": jump,
        "client": client,
        "driver": driver,
        "complete": enabled and bool(user) and valid_port,
    }


def ssh_display(row, legacy_fallback=True, override_user=None, override_port=None, override_profile=None,
                override_client=None):
    meta = phpipam_ssh_metadata(row)
    if not meta["enabled"] and override_user is None and override_port is None:
        return "legacy" if legacy_fallback else "disabled"
    user = override_user or meta["user"] or getpass.getuser()
    port = str(override_port or meta["port"] or "22")
    target = "{}@{}:{}".format(user, row["_ip"], port)
    defaults = []
    if override_user is None and not meta["user"]:
        defaults.append("user=current")
    if override_port is None and not meta["port"]:
        defaults.append("port=22")
    selected_profile = override_profile or meta["profile"]
    if selected_profile:
        target += " [{}]".format(selected_profile)
    selected_client = override_client or meta["client"]
    if selected_client == "legacy":
        target += " [legacy-client]"
    elif selected_client == "invalid":
        target += " [invalid-client]"
    target += " [driver={}]".format(resolve_device_driver(row))
    if meta["jump"]:
        target += " via {}".format(meta["jump"])
    if defaults:
        target += " ({})".format(",".join(defaults))
    return target


def print_table(rows, numbered=False, legacy_fallback=True, override_user=None, override_port=None,
                override_profile=None, override_client=None, brief=False, show_vendor=False):
    base_columns = (["IP", "HOSTNAME"] + (["VENDOR"] if show_vendor else []) +
                    (["SSH", "DESCRIPTION"] if brief else
                     ["STATUS", "LASTSEEN", "SSH", "DESCRIPTION"]))
    base_columns = tuple(base_columns)
    columns = (("#",) if numbered else ()) + base_columns
    values = []
    for index, row in enumerate(rows, 1):
        value = [str(row["_ip"]), row.get("_hostname") or "-"]
        if show_vendor:
            value.append(str(custom_value(row, "device_vendor") or "-"))
        if not brief:
            value.extend((tag_label(row), str(row.get("lastSeen") or "-")))
        value.extend((ssh_display(row, legacy_fallback, override_user, override_port,
                                  override_profile, override_client),
                      clean_comment(row.get("description") or row.get("note") or "-")))
        value = tuple(value)
        if numbered:
            value = (str(index),) + value
        values.append(value)
    widths = [len(col) for col in columns]
    max_widths = [60] * len(columns)
    if brief:
        max_widths[columns.index("SSH")] = 100
    for value in values:
        for idx, cell in enumerate(value):
            widths[idx] = min(max_widths[idx], max(widths[idx], len(cell)))
    fmt = "  ".join("{{:<{}}}".format(width) for width in widths)
    print(fmt.format(*columns))
    print(fmt.format(*("-" * width for width in widths)))
    for value in values:
        clipped = [cell if len(cell) <= widths[idx] else cell[: widths[idx] - 1] + "…" for idx, cell in enumerate(value)]
        print(fmt.format(*clipped))


def address_detail_value(row, key):
    value = str(row["_ip"]) if key == "ip" else row.get(key)
    if value is None or value == "":
        return ["-"]
    if isinstance(value, bool):
        return ["true" if value else "false"]
    if isinstance(value, (dict, list)):
        return json.dumps(value, ensure_ascii=False, sort_keys=True, indent=2).splitlines()
    return str(value).splitlines() or ["-"]


def print_address_details(rows):
    for index, row in enumerate(rows, 1):
        hostname = row.get("_hostname") or str(row["_ip"])
        print("\nDetails {}/{}: {} ({})".format(index, len(rows), hostname, row["_ip"]))
        keys = [key for key in row if not key.startswith("_")]
        keys.sort(key=lambda key: (0 if key == "ip" else 1 if key == "hostname" else 2,
                                   key.lower()))
        width = max([len(key) for key in keys] or [0])
        for key in keys:
            lines = address_detail_value(row, key)
            if len(lines) == 1:
                print("  {} : {}".format(key.ljust(width), lines[0]))
                continue
            print("  {} :".format(key.ljust(width)))
            for line in lines:
                print("    {}".format(line))


def ssh_effective(target):
    try:
        output = subprocess.check_output(
            ["ssh", "-G", target], stderr=subprocess.DEVNULL,
            universal_newlines=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return {"hostname": target, "user": getpass.getuser(), "port": "22"}
    wanted = {}
    for line in output.splitlines():
        key, _, value = line.partition(" ")
        if key in ("hostname", "user", "port") and key not in wanted:
            wanted[key] = value.strip()
    return {
        "hostname": wanted.get("hostname", target),
        "user": wanted.get("user", getpass.getuser()),
        "port": wanted.get("port", "22"),
    }


def choose_ssh_target(rows, legacy_fallback=True, override_user=None, override_port=None,
                      override_profile=None, override_client=None, brief=False, show_vendor=False):
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        raise GrError("--ssh requires an interactive terminal")
    print_table(rows, numbered=True, legacy_fallback=legacy_fallback,
                override_user=override_user, override_port=override_port,
                override_profile=override_profile, override_client=override_client, brief=brief,
                show_vendor=show_vendor)
    print()
    while True:
        answer = input("Select SSH target [1-{}, q]: ".format(len(rows))).strip().lower()
        if answer in ("q", "quit", "exit"):
            return None
        try:
            index = int(answer)
        except ValueError:
            print("Enter a number between 1 and {}, or q.".format(len(rows)), file=sys.stderr)
            continue
        if 1 <= index <= len(rows):
            return rows[index - 1]
        print("Enter a number between 1 and {}, or q.".format(len(rows)), file=sys.stderr)


def vault_secret_name(cfg, profile):
    profile_cfg = cfg.get("ssh_profiles", {}).get(profile, {})
    return str(profile_cfg.get("password_secret") or "").strip()


def sudo_vault_secret_name(cfg, profile):
    """Use an explicit sudo secret when configured, otherwise reuse the SSH secret."""
    profile_cfg = cfg.get("ssh_profiles", {}).get(profile, {})
    return str(profile_cfg.get("sudo_password_secret") or
               profile_cfg.get("password_secret") or "").strip()


def read_vault_password(secret):
    if not shutil.which("pass"):
        raise GrError("pass is not installed")
    environment = os.environ.copy()
    inherited_gpg_tty = str(environment.get("GPG_TTY") or "").strip()
    gpg_tty = ""
    try:
        if sys.stdin.isatty():
            gpg_tty = os.ttyname(sys.stdin.fileno())
    except (AttributeError, OSError, ValueError):
        gpg_tty = ""
    if not gpg_tty:
        gpg_tty = inherited_gpg_tty
    if gpg_tty:
        environment["GPG_TTY"] = gpg_tty
        connector = shutil.which("gpg-connect-agent")
        if connector:
            # A long-lived agent can retain a pinentry TTY from an older SSH
            # session.  Refresh only its startup TTY before pass may prompt;
            # this neither decrypts nor changes the password store.
            subprocess.call(
                [connector, "updatestartuptty", "/bye"], env=environment,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        output = subprocess.check_output(
            ["pass", "show", secret], universal_newlines=True, timeout=120,
            env=environment)
    except subprocess.TimeoutExpired:
        raise GrError(
            "Vault decryption timed out for {}; close any abandoned pinentry prompt "
            "or run 'gr vault reset-agent', then retry".format(secret))
    except subprocess.CalledProcessError as exc:
        raise GrError("Cannot decrypt vault secret {} (pass exit {})".format(secret, exc.returncode))
    password = output.splitlines()[0] if output.splitlines() else ""
    if not password:
        raise GrError("Vault secret is empty: {}".format(secret))
    return password


def vault_secret_exists(secret):
    store = expand(os.environ.get("PASSWORD_STORE_DIR", "~/.password-store"))
    return os.path.isfile(os.path.join(store, secret + ".gpg"))


def normalize_device_driver(value, allow_empty=False):
    driver = str(value or "").strip().lower()
    if not driver and allow_empty:
        return ""
    if driver not in DEVICE_DRIVERS:
        raise GrError("Unsupported device driver: {} (valid: {})".format(
            driver or "<empty>", ", ".join(DEVICE_DRIVERS)))
    return driver


def device_driver_spec(driver):
    return DEVICE_DRIVER_SPECS[normalize_device_driver(driver)]


def resolve_device_driver(row, override=None):
    """Resolve device behavior independently from credentials and SSH transport."""
    if override:
        return normalize_device_driver(override)
    explicit = str(custom_value(row, "device_driver") or "").strip()
    if explicit:
        return normalize_device_driver(explicit)
    return "generic"


def legacy_profile_driver(cfg, profile):
    """Read the v1 profile/driver association only for explicit migration."""
    profile_cfg = cfg.get("ssh_profiles", {}).get(profile, {}) if profile else {}
    if not isinstance(profile_cfg, dict):
        raise GrError("SSH profile {} must be an object".format(profile))
    legacy = str(profile_cfg.get("session_driver") or "").strip().lower()
    if legacy in ("", "standard"):
        return ""
    return normalize_device_driver(legacy)


class CiscoSmallBusinessLogin:
    """Recognize the second-stage CLI login without exposing its credentials."""

    USERNAME_RE = re.compile(br"user\s*name\s*:\s*$", re.I)
    PASSWORD_RE = re.compile(br"password\s*:\s*$", re.I)
    PROMPT_RE = re.compile(br"(?:^|[\r\n])[^\r\n]{0,128}[>#]\s*$")
    PAGER_RE = re.compile(br"(?:--\s*more\s*--|more\s*[:>])", re.I)
    ANSI_RE = re.compile(br"\x1b\[[0-?]*[ -/]*[@-~]")
    PASSWORD_CHANGE_RE = re.compile(
        br"do you want to change (?:it|the password) now\s*\(y/n\)\s*\[n\]\s*\?\s*$",
        re.I)

    def __init__(self, username, password):
        self.username = str(username).encode("utf-8")
        self.password = str(password).encode("utf-8")
        self.state = "username"
        self.buffer = b""

    def feed(self, data):
        self.buffer = (self.buffer + data)[-4096:]
        visible = self.ANSI_RE.sub(b"", self.buffer)
        # Several Cisco Business releases stop after authentication at an
        # advisory password-expiry prompt.  Declining that optional change is
        # required for read-only collectors as well as SNMP sessions.
        if self.PASSWORD_CHANGE_RE.search(visible):
            self.buffer = b""
            return [("credential", b"n\n")]
        if self.state == "ready" and self.PAGER_RE.search(visible):
            self.buffer = b""
            return [("credential", b" ")]
        if self.state == "username" and self.PROMPT_RE.search(visible):
            self.state = "ready"
            self.buffer = b""
            return [("ready", b"")]
        if self.state == "username" and self.USERNAME_RE.search(visible):
            self.state = "password"
            self.buffer = b""
            return [("credential", self.username + b"\n")]
        if self.state == "password" and self.PASSWORD_RE.search(visible):
            self.state = "prompt"
            self.buffer = b""
            return [("credential", self.password + b"\n")]
        if self.state == "prompt" and self.PROMPT_RE.search(visible):
            self.state = "ready"
            self.buffer = b""
            return [("ready", b"")]
        if self.state == "ready" and self.PROMPT_RE.search(visible):
            self.buffer = b""
            return [("prompt", b"")]
        return []


class CiscoIosLogin(CiscoSmallBusinessLogin):
    """Drive an IOS PTY and handle an optional enable-password prompt."""

    def feed(self, data):
        visible = (self.buffer + data)[-4096:]
        if self.state == "ready" and self.PASSWORD_RE.search(visible):
            self.buffer = b""
            return [("credential", self.password + b"\n")]
        return super().feed(data)


class PlanetSgsLogin(CiscoIosLogin):
    """Drive the PLANET SGS privileged CLI and paginated output."""


class HpeArubaOsSwitchLogin:
    """Pass the ArubaOS-Switch legal banner and recognize its CLI prompt."""

    CONTINUE_RE = re.compile(br"press any key to continue", re.I)
    LOGOUT_RE = re.compile(br"do you want to log out\s*[\[(]y/n[\])]\?", re.I)
    PROMPT_RE = re.compile(br"(?:^|[\r\n])[^\r\n]{1,128}[>#]\s*$")
    ANSI_RE = re.compile(br"\x1b\[[0-?]*[ -/]*[@-~]")

    def __init__(self, _username, _password):
        self.state = "continue"
        self.buffer = b""

    def feed(self, data):
        self.buffer = (self.buffer + data)[-4096:]
        visible = self.ANSI_RE.sub(b"", self.buffer)
        if self.state == "continue" and self.CONTINUE_RE.search(visible):
            self.state = "prompt"
            self.buffer = b""
            return [("credential", b" ")]
        if self.state == "prompt" and self.PROMPT_RE.search(visible):
            self.state = "ready"
            self.buffer = b""
            return [("ready", b"")]
        if self.state == "ready" and self.LOGOUT_RE.search(visible):
            self.buffer = b""
            return [("credential", b"y\n")]
        if self.state == "ready" and self.PROMPT_RE.search(visible):
            self.buffer = b""
            return [("prompt", b"")]
        return []


class HpeComwareLogin:
    """Recognize the HPE Comware angle-bracket command prompt."""

    PROMPT_RE = re.compile(br"(?:^|[\r\n])<[^>\r\n]{1,128}>\s*$")
    ANSI_RE = re.compile(br"\x1b\[[0-?]*[ -/]*[@-~]")

    def __init__(self, _username, _password):
        self.state = "prompt"
        self.buffer = b""

    def feed(self, data):
        self.buffer = (self.buffer + data)[-4096:]
        visible = self.ANSI_RE.sub(b"", self.buffer)
        if self.state == "prompt" and self.PROMPT_RE.search(visible):
            self.state = "ready"
            self.buffer = b""
            return [("ready", b"")]
        if self.state == "ready" and self.PROMPT_RE.search(visible):
            self.buffer = b""
            return [("prompt", b"")]
        return []


class FortiGateFortiOsLogin(CiscoSmallBusinessLogin):
    """Recognize a FortiOS CLI prompt without entering configuration mode."""


def device_login_driver(driver):
    mapping = {
        "cisco-ios": CiscoIosLogin,
        "cisco-small-business": CiscoSmallBusinessLogin,
        "planet-sgs": PlanetSgsLogin,
        "dell-os10": CiscoIosLogin,
        "hpe-arubaos-switch": HpeArubaOsSwitchLogin,
        "hpe-comware7": HpeComwareLogin,
        "fortigate-fortios": FortiGateFortiOsLogin,
    }
    normalized = normalize_device_driver(driver)
    if normalized not in mapping:
        raise GrError("Device driver {} has no interactive login handler".format(driver))
    return mapping[normalized]



def audit_component(value):
    value = str(value or "unknown").strip()
    value = re.sub(r"[^A-Za-z0-9_.:-]+", "_", value).strip("._")
    return value or "unknown"


class SshSessionAudit:
    """Lossless, timestamped JSON-lines recording of terminal byte streams."""

    def __init__(self, cfg, row, command):
        label = audit_component(row.get("_hostname") or row.get("_ip"))
        directory = os.path.join(cfg["ssh_audit_dir"], label)
        os.makedirs(directory, mode=0o700, exist_ok=True)
        os.chmod(cfg["ssh_audit_dir"], 0o700)
        os.chmod(directory, 0o700)
        stamp = dt.datetime.utcnow().strftime("%Y%m%dT%H%M%S.%fZ")
        self.path = os.path.join(directory, "{}-{}.ses".format(label, stamp))
        fd = os.open(self.path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        self.handle = os.fdopen(fd, "w", encoding="ascii")
        self.started = time.time()
        self._write({
            "format": "gr-ssh-session-v1",
            "started_utc": dt.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%S.%fZ"),
            "hostname": row.get("_hostname") or "",
            "ip": str(row.get("_ip") or ""),
            "command": command,
            "warning": "Contains complete terminal I/O and may contain credentials."
        })

    def _write(self, record):
        self.handle.write(json.dumps(record, sort_keys=True, separators=(",", ":")) + "\n")
        self.handle.flush()

    def record(self, stream, data):
        if data:
            self._write({"t": round(time.time() - self.started, 6), "stream": stream,
                         "data": base64.b64encode(data).decode("ascii")})

    def close(self, exit_status):
        self._write({"ended_utc": dt.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%S.%fZ"),
                     "exit_status": exit_status})
        os.fsync(self.handle.fileno())
        self.handle.close()


def copy_terminal_size(source_fd, target_fd):
    try:
        size = fcntl.ioctl(source_fd, termios.TIOCGWINSZ, b"\0" * 8)
        fcntl.ioctl(target_fd, termios.TIOCSWINSZ, size)
    except OSError:
        pass


def write_all(descriptor, data):
    offset = 0
    while offset < len(data):
        offset += os.write(descriptor, data[offset:])


def run_pty_ssh(command, audit=None, inherited_fd=None, login_driver=None):
    if not sys.stdin.isatty() or not sys.stdout.isatty() or not sys.stderr.isatty():
        raise GrError("PTY SSH sessions require an interactive terminal")
    master_fd, slave_fd = os.openpty()
    stderr_read, stderr_write = os.pipe()
    copy_terminal_size(sys.stdin.fileno(), slave_fd)
    pid = os.fork()
    if pid == 0:
        try:
            os.close(master_fd)
            os.close(stderr_read)
            os.setsid()
            fcntl.ioctl(slave_fd, termios.TIOCSCTTY, 0)
            os.dup2(slave_fd, 0)
            os.dup2(slave_fd, 1)
            os.dup2(stderr_write, 2)
            if slave_fd > 2:
                os.close(slave_fd)
            if stderr_write > 2:
                os.close(stderr_write)
            os.execvp(command[0], command)
        except Exception as exc:
            os.write(2, ("gr: cannot start SSH: {}\n".format(exc)).encode("utf-8", "replace"))
            os._exit(127)
    os.close(slave_fd)
    os.close(stderr_write)
    original = termios.tcgetattr(sys.stdin.fileno())
    previous_winch = signal.getsignal(signal.SIGWINCH)

    def resize(_signum, _frame):
        copy_terminal_size(sys.stdin.fileno(), master_fd)
        try:
            os.kill(pid, signal.SIGWINCH)
        except OSError:
            pass

    signal.signal(signal.SIGWINCH, resize)
    streams = {master_fd: ("stdout", sys.stdout.fileno()),
               stderr_read: ("stderr", sys.stderr.fileno()),
               sys.stdin.fileno(): ("stdin", master_fd)}
    try:
        tty.setraw(sys.stdin.fileno())
        while master_fd in streams or stderr_read in streams:
            ready, _, _ = select.select(list(streams), [], [])
            for source in ready:
                stream, destination = streams[source]
                try:
                    data = os.read(source, 65536)
                except OSError as exc:
                    if exc.errno == errno.EIO:
                        data = b""
                    else:
                        raise
                if not data:
                    if source != sys.stdin.fileno():
                        streams.pop(source, None)
                        os.close(source)
                    continue
                if audit is not None:
                    audit.record(stream, data)
                write_all(destination, data)
                if source == master_fd and login_driver is not None:
                    for action, response in login_driver.feed(data):
                        if action == "credential":
                            write_all(master_fd, response)
    finally:
        signal.signal(signal.SIGWINCH, previous_winch)
        termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, original)
        for descriptor in (master_fd, stderr_read):
            if descriptor in streams:
                os.close(descriptor)
        if inherited_fd is not None:
            os.close(inherited_fd)
    _, status = os.waitpid(pid, 0)
    exit_status = os.waitstatus_to_exitcode(status) if hasattr(os, "waitstatus_to_exitcode") else (
        os.WEXITSTATUS(status) if os.WIFEXITED(status) else 128 + os.WTERMSIG(status))
    if audit is not None:
        audit.close(exit_status)
        print("\nSSH audit: {}".format(audit.path), file=sys.stderr)
    return exit_status


def retry_rejected_vault_password(exit_status, target, profile, retry_callback,
                                  prompt_retry_supported=True):
    """Explain sshpass status 5 and optionally retry through OpenSSH.

    The retry is deliberately operator-approved and bypasses the vault. Device
    drivers with automated credential handling cannot safely switch to an
    OpenSSH-owned prompt, so they stop with an actionable diagnostic instead.
    """
    if exit_status != 5:
        return exit_status
    print("\nVault password was rejected by {} for profile {}.".format(
        target, profile), file=sys.stderr)
    if not prompt_retry_supported:
        print("This device driver requires its encrypted credential. Validate it with "
              "'gr vault test {}' and replace it with 'gr vault set {}' after "
              "verification.".format(profile, profile), file=sys.stderr)
        return exit_status
    try:
        answer = input("Retry once with the OpenSSH password prompt? [y/N] ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print("", file=sys.stderr)
        return exit_status
    if answer not in ("y", "yes"):
        print("Not retrying. Validate with 'gr vault test {}' and replace the secret "
              "only after verifying the password.".format(profile), file=sys.stderr)
        return exit_status
    print("Retrying without Vault. The entered password will not be saved by gr.",
          file=sys.stderr)
    return retry_callback()


def audit_replay_streams(include_stdin=False, stream=None):
    if stream:
        return {stream}
    return {"stdin", "stdout", "stderr"} if include_stdin else {"stdout", "stderr"}


def audit_pager_command():
    configured = os.environ.get("GR_PAGER") or os.environ.get("PAGER")
    if configured:
        try:
            return shlex.split(configured)
        except ValueError as exc:
            raise GrError("Invalid pager command: {}".format(exc))
    if shutil.which("less"):
        return ["less", "-R"]
    if shutil.which("more"):
        return ["more"]
    return []


def write_paged_text(content, use_pager=True):
    pager = None
    pager_input = None
    if use_pager and getattr(sys.stdout, "isatty", lambda: False)():
        command = audit_pager_command()
        if command:
            try:
                pager = subprocess.Popen(command, stdin=subprocess.PIPE, universal_newlines=True)
                pager_input = pager.stdin
            except OSError as exc:
                raise GrError("Cannot start pager {}: {}".format(command[0], exc))
    try:
        destination = pager_input or sys.stdout
        destination.write(content)
        destination.flush()
    except BrokenPipeError:
        pass
    finally:
        if pager_input is not None:
            try:
                pager_input.close()
            except BrokenPipeError:
                pass
        if pager is not None:
            pager.wait()
    return 0


def command_audit_replay(path, streams=None, use_pager=True):
    path = expand(path)
    streams = set(streams or ("stdout", "stderr"))
    pager = None
    pager_input = None
    if use_pager and sys.stdout.isatty():
        pager_command = audit_pager_command()
        if pager_command:
            try:
                pager = subprocess.Popen(pager_command, stdin=subprocess.PIPE)
                pager_input = pager.stdin
            except OSError as exc:
                raise GrError("Cannot start audit pager {}: {}".format(pager_command[0], exc))
    total_frames = 0
    exit_status = "incomplete"
    try:
        with open(path, encoding="ascii") as handle:
            for line_number, line in enumerate(handle, 1):
                record = json.loads(line)
                if "exit_status" in record:
                    exit_status = record["exit_status"]
                if "data" not in record:
                    continue
                total_frames += 1
                if record.get("stream") not in streams:
                    continue
                data = base64.b64decode(record["data"], validate=True)
                destination = pager_input or (
                    sys.stderr.buffer if record.get("stream") == "stderr" else sys.stdout.buffer)
                destination.write(data)
                destination.flush()
    except BrokenPipeError:
        # Leaving the pager with q is a successful, intentional short replay.
        pass
    except (OSError, ValueError, KeyError) as exc:
        raise GrError("Cannot replay audit {}: {}".format(path, exc))
    finally:
        if pager_input is not None:
            try:
                pager_input.close()
            except BrokenPipeError:
                pass
        if pager is not None:
            pager.wait()
    if total_frames == 0:
        if exit_status == 5:
            message = ("No terminal stream data was recorded. SSH password authentication "
                       "was rejected (sshpass exit 5); validate the selected Vault profile.\n")
        else:
            message = ("No terminal stream data was recorded (session exit status: {}).\n".format(
                exit_status))
        destination = getattr(sys.stderr, "buffer", sys.stderr)
        if destination is sys.stderr:
            destination.write(message)
        else:
            destination.write(message.encode("utf-8"))
        destination.flush()
    return 0


def audit_session_summary(path):
    """Return safe index metadata without decoding recorded terminal frames."""
    try:
        with open(path, "rb") as handle:
            header = json.loads(handle.readline().decode("ascii"))
            if header.get("format") != "gr-ssh-session-v1":
                raise ValueError("unsupported audit format")
            handle.seek(0, os.SEEK_END)
            end = handle.tell()
            start = max(0, end - 65536)
            handle.seek(start)
            tail = handle.read()
            lines = tail.splitlines()
            trailer = {}
            for line in reversed(lines):
                try:
                    trailer = json.loads(line.decode("ascii"))
                    break
                except (UnicodeDecodeError, ValueError):
                    continue
            if "ended_utc" not in trailer and "exit_status" not in trailer:
                trailer = {}
        return {
            "path": path,
            "directory": os.path.basename(os.path.dirname(path)),
            "session": os.path.splitext(os.path.basename(path))[0],
            "hostname": str(header.get("hostname") or ""),
            "ip": str(header.get("ip") or ""),
            "started": str(header.get("started_utc") or ""),
            "ended": str(trailer.get("ended_utc") or ""),
            "exit_status": trailer.get("exit_status", "incomplete"),
        }
    except (OSError, ValueError, KeyError) as exc:
        raise GrError("Cannot index audit {}: {}".format(path, exc))


def audit_inventory(cfg):
    root = cfg["ssh_audit_dir"]
    if not os.path.isdir(root):
        return []
    sessions = []
    try:
        directories = sorted(os.scandir(root), key=lambda item: item.name.lower())
        for directory in directories:
            if not directory.is_dir(follow_symlinks=False):
                continue
            files = sorted(os.scandir(directory.path), key=lambda item: item.name.lower())
            for item in files:
                if item.name.endswith(".ses") and item.is_file(follow_symlinks=False):
                    sessions.append(audit_session_summary(item.path))
    except OSError as exc:
        raise GrError("Cannot list audit directory {}: {}".format(root, exc))
    return sessions


def audit_session_keys(summary):
    return tuple(value for value in (summary["directory"], summary["hostname"], summary["ip"]) if value)


def audit_target_matches(summary, target, exact=False):
    needle = str(target or "").lower()
    keys = [value.lower() for value in audit_session_keys(summary)]
    return any(value == needle for value in keys) if exact else any(needle in value for value in keys)


def audit_target_rows(sessions, filter_value=None):
    groups = {}
    for summary in sessions:
        if filter_value and not audit_target_matches(summary, filter_value):
            continue
        key = (summary["directory"], summary["hostname"], summary["ip"])
        groups.setdefault(key, []).append(summary)
    rows = []
    for (directory, hostname, ip), items in groups.items():
        latest = max(item["started"] for item in items)
        rows.append((hostname or directory, ip or "-", str(len(items)), latest or "-"))
    return sorted(rows, key=lambda row: (row[0].lower(), row[1]))


def print_audit_table(columns, rows):
    widths = [len(column) for column in columns]
    for row in rows:
        for index, value in enumerate(row):
            widths[index] = max(widths[index], len(str(value)))
    fmt = "  ".join("{:<" + str(width) + "}" for width in widths)
    print(fmt.format(*columns))
    print(fmt.format(*("-" * width for width in widths)))
    for row in rows:
        print(fmt.format(*(str(value) for value in row)))


def resolve_audit_sessions(cfg, target):
    return [item for item in audit_inventory(cfg) if audit_target_matches(item, target, exact=True)]


def command_audit_show(cfg, target=None, session=None, streams=None, use_pager=True):
    sessions = audit_inventory(cfg)
    if not target:
        rows = audit_target_rows(sessions)
        if not rows:
            print("No SSH audit sessions found in {}.".format(cfg["ssh_audit_dir"]))
            return 0
        rows = [(target_name, ip, sessions_count, format_local_timestamp(latest))
                for target_name, ip, sessions_count, latest in rows]
        print_audit_table(("TARGET", "IP", "SESSIONS", "LATEST (EUROPE/BUCHAREST)"), rows)
        print("\nNext: gr audit show <hostname-or-ip>")
        return 0

    direct_path = expand(target)
    if os.path.isfile(direct_path) and session is None:
        return command_audit_replay(direct_path, streams, use_pager)

    matches = [item for item in sessions if audit_target_matches(item, target, exact=True)]
    if not matches:
        rows = audit_target_rows(sessions, target)
        if rows and session is None:
            rows = [(target_name, ip, sessions_count, format_local_timestamp(latest))
                    for target_name, ip, sessions_count, latest in rows]
            print_audit_table(("TARGET", "IP", "SESSIONS", "LATEST (EUROPE/BUCHAREST)"), rows)
            print("\nUse a complete hostname or IP to list its sessions.")
            return 0
        raise GrError("No audit target matches: {}".format(target))

    matches.sort(key=lambda item: (item["started"], item["session"]), reverse=True)
    if session is None:
        rows = []
        for item in matches:
            rows.append((item["session"], format_local_timestamp(item["started"]),
                         format_local_timestamp(item["ended"]) if item["ended"] else "incomplete",
                         str(item["exit_status"])))
        print_audit_table(("SESSION", "STARTED (EUROPE/BUCHAREST)",
                           "ENDED (EUROPE/BUCHAREST)", "EXIT"), rows)
        print("\nReplay: gr audit show {} <session-or-latest>".format(target))
        return 0

    if session == "latest":
        selected = matches[0]
    else:
        normalized = session[:-4] if session.endswith(".ses") else session
        candidates = [item for item in matches if item["session"] == normalized]
        if not candidates:
            raise GrError("No audit session {} for target {}".format(session, target))
        selected = candidates[0]
    return command_audit_replay(selected["path"], streams, use_pager)


def collect_report_criteria(data, filename):
    criteria = data.get("criteria")
    if isinstance(criteria, dict):
        selector = str(criteria.get("selector") or "unknown")
        if selector == "all-non-generic-drivers":
            return "driver!=generic"
        if selector == "vendor-all":
            return "vendor={} all".format(criteria.get("vendor") or "-")
        if selector == "ip":
            ips = ",".join(str(value) for value in criteria.get("ips", [])) or "-"
            return "vendor={} ip={}".format(criteria.get("vendor") or "-", ips)
        return selector
    suffix = "-show-version-report.json"
    vendor = filename[:-len(suffix)] if filename.endswith(suffix) else filename
    return "vendor={} (legacy)".format(vendor or "unknown")


def collect_report_inventory(cfg):
    root = cfg["device_version_dir"]
    if not os.path.isdir(root):
        return []
    reports = []
    try:
        directories = sorted(os.scandir(root), key=lambda item: item.name, reverse=True)
        for directory in directories:
            if not directory.is_dir(follow_symlinks=False):
                continue
            candidates = [item for item in os.scandir(directory.path)
                          if item.is_file(follow_symlinks=False)
                          and item.name.endswith("-show-version-report.json")]
            for item in sorted(candidates, key=lambda entry: entry.name):
                try:
                    with open(item.path, encoding="utf-8") as handle:
                        data = json.load(handle)
                except (OSError, ValueError) as exc:
                    raise GrError("Cannot read collect report {}: {}".format(item.path, exc))
                if not isinstance(data, dict):
                    raise GrError("Invalid collect report {}: top-level JSON must be an object".format(
                        item.path))
                results = data.get("results", [])
                if not isinstance(results, list):
                    raise GrError("Invalid collect report {}: results must be a list".format(item.path))
                if not all(isinstance(result, dict) for result in results):
                    raise GrError("Invalid collect report {}: every result must be an object".format(
                        item.path))
                counts = {status: sum(1 for result in results if result.get("result") == status)
                          for status in ("success", "failed", "timeout")}
                reports.append({
                    "id": directory.name,
                    "path": item.path,
                    "generated": str(data.get("generated_utc") or directory.name),
                    "generated_local": format_local_timestamp(
                        data.get("generated_utc") or directory.name),
                    "devices": len(results),
                    "success": counts["success"],
                    "failed": counts["failed"],
                    "timeout": counts["timeout"],
                    "criteria": collect_report_criteria(data, item.name),
                    "data": data,
                })
    except OSError as exc:
        raise GrError("Cannot list collect reports in {}: {}".format(root, exc))
    reports.sort(key=lambda item: (item["generated"], item["id"]), reverse=True)
    return reports


def collect_report_table(data, report_id):
    results = data.get("results", [])
    excluded = {"stderr", "raw_report", "system_image", "rom", "uptime"}
    preferred = ("hostname", "ip", "vendor", "result", "model", "firmware", "os_family",
                 "serial", "user", "port", "profile", "client", "returncode")
    available = set()
    for result in results:
        available.update(key for key in result if key not in excluded)
    columns = [key for key in preferred if key in available]
    columns.extend(sorted(available - set(columns), key=str.lower))
    lines = ["Report: {}".format(report_id),
             "Generated (Europe/Bucharest): {}".format(
                 format_local_timestamp(data.get("generated_utc"))), ""]
    if not results:
        lines.append("No device results in this report.")
        return "\n".join(lines) + "\n"
    if not columns:
        lines.append("No displayable device attributes in this report.")
        return "\n".join(lines) + "\n"
    widths = [len(column.upper()) for column in columns]
    rows = []
    for result in results:
        row = []
        for index, column in enumerate(columns):
            value = result.get(column)
            if value is None or value == "":
                rendered = "-"
            elif isinstance(value, bool):
                rendered = "true" if value else "false"
            elif isinstance(value, (dict, list)):
                rendered = json.dumps(value, ensure_ascii=False, sort_keys=True,
                                      separators=(",", ":"))
            else:
                rendered = " ".join(str(value).splitlines())
            row.append(rendered)
            widths[index] = max(widths[index], len(rendered))
        rows.append(row)
    fmt = "  ".join("{{:<{}}}".format(width) for width in widths)
    lines.append(fmt.format(*(column.upper() for column in columns)))
    lines.append(fmt.format(*("-" * width for width in widths)))
    lines.extend(fmt.format(*row) for row in rows)
    return "\n".join(lines) + "\n"


def command_collect_reports(cfg, report=None, use_pager=True, raw=False):
    reports = collect_report_inventory(cfg)
    if not report:
        if raw:
            raise GrError("--raw requires a report ID or latest")
        if not reports:
            print("No collect reports found in {}.".format(cfg["device_version_dir"]))
            return 0
        rows = [(item["id"], item["generated_local"], item["criteria"], str(item["devices"]),
                 str(item["success"]), str(item["failed"]), str(item["timeout"]))
                for item in reports]
        print_audit_table(("REPORT", "GENERATED (EUROPE/BUCHAREST)", "CRITERIA", "DEVICES",
                           "SUCCESS", "FAILED", "TIMEOUT"), rows)
        print("\nShow: gr collect reports <report-or-latest>")
        return 0
    selected = reports[0] if report == "latest" and reports else next(
        (item for item in reports if item["id"] == report), None)
    if selected is None:
        raise GrError("No collect report matches: {}".format(report))
    if raw:
        try:
            with open(selected["path"], encoding="utf-8") as handle:
                content = handle.read()
        except OSError as exc:
            raise GrError("Cannot read collect report {}: {}".format(selected["path"], exc))
    else:
        content = collect_report_table(selected["data"], selected["id"])
    return write_paged_text(content, use_pager)


def config_archive_files():
    devices = os.path.join(GLOBAL_CONFIG_ARCHIVE, "devices")
    if not os.path.isdir(os.path.join(GLOBAL_CONFIG_ARCHIVE, ".git")):
        return []
    files = []
    try:
        entries = os.scandir(devices)
    except OSError as exc:
        raise GrError("Cannot read global configuration archive: {}".format(exc))
    with entries:
        for entry in entries:
            match = re.match(r"^(.*?)--([0-9a-fA-F:.]+)\.cfg$", entry.name)
            if entry.is_file(follow_symlinks=False) and match:
                files.append({"hostname": match.group(1), "ip": match.group(2),
                              "path": "devices/{}".format(entry.name)})
    return sorted(files, key=lambda item: (item["hostname"].lower(), item["ip"]))


def config_archive_target(value):
    needle = str(value or "").lower()
    matches = [item for item in config_archive_files()
               if needle in (item["hostname"].lower(), item["ip"].lower())]
    if not matches:
        raise GrError("No archived configuration matches: {}".format(value))
    if len(matches) > 1:
        raise GrError("Multiple archived configurations match {}; use the exact IP".format(value))
    return matches[0]


def git_archive_output(arguments):
    try:
        return subprocess.check_output([
            "git", "--git-dir={}".format(os.path.join(GLOBAL_CONFIG_ARCHIVE, ".git")),
            "--work-tree={}".format(GLOBAL_CONFIG_ARCHIVE)] + list(arguments),
                                       universal_newlines=True, stderr=subprocess.STDOUT)
    except (OSError, subprocess.CalledProcessError) as exc:
        detail = getattr(exc, "output", "") or str(exc)
        raise GrError("Cannot read configuration archive: {}".format(detail.strip()))


def config_archive_history(item):
    output = git_archive_output([
        "log", "--follow", "--date=format-local:{}".format(DISPLAY_TIME_FORMAT),
        "--format=%H%x1f%ad%x1f%s", "--", item["path"]])
    rows = []
    for line in output.splitlines():
        fields = line.split("\x1f", 2)
        if len(fields) == 3:
            rows.append(tuple(fields))
    return rows


def command_config_devices(filter_value=None):
    items = config_archive_files()
    if filter_value:
        needle = filter_value.lower()
        items = [item for item in items if needle in item["hostname"].lower() or needle in item["ip"]]
    rows = []
    for item in items:
        history = config_archive_history(item)
        rows.append((item["hostname"], item["ip"], str(len(history)),
                     history[0][1] if history else "-"))
    if not rows:
        print("No archived device configurations found.")
        return 0
    print_audit_table(("HOSTNAME", "IP", "VERSIONS", "LATEST (EUROPE/BUCHAREST)"), rows)
    print("\nHistory: gr config history <hostname-or-ip>")
    return 0


def command_config_history(target):
    item = config_archive_target(target)
    history = config_archive_history(item)
    rows = [(commit[:12], date, subject) for commit, date, subject in history]
    print_audit_table(("REVISION", "COLLECTED (EUROPE/BUCHAREST)", "SUBJECT"), rows)
    print("\nView: gr config view {} <revision-or-latest>".format(target))
    return 0


def command_config_view(target, revision="latest", use_pager=True):
    item = config_archive_target(target)
    selected = "HEAD" if revision in (None, "latest") else revision
    content = git_archive_output(["show", "{}:{}".format(selected, item["path"])])
    heading = "Configuration: {} ({}) revision={}\n\n".format(
        item["hostname"], item["ip"], revision or "latest")
    return write_paged_text(heading + content, use_pager)


def latest_successful_inventory(cfg):
    """Return the newest successful collected inventory record for every IP."""
    inventory = {}
    for report in collect_report_inventory(cfg):
        for result in report["data"].get("results", []):
            ip = str(normalize_ip(result.get("ip")) or "")
            if ip and ip not in inventory and result.get("result") == "success":
                inventory[ip] = result
    return inventory


def detect_device_driver(row, collected=None):
    """Classify a device from successful inventory and unambiguous metadata."""
    collected = collected or {}
    model = str(collected.get("model") or "").strip()
    firmware = str(collected.get("firmware") or "").strip()
    os_family = str(collected.get("os_family") or "").strip().lower()
    collected_driver = str(collected.get("device_driver") or "").strip().lower()
    vendor = str(custom_value(row, "device_vendor") or collected.get("vendor") or "").strip().lower()
    combined = "{} {} {}".format(model, firmware, os_family).lower()

    if "comware" in combined or re.search(r"\b5520\b", model, re.I):
        return "hpe-comware7", "inventory:model/os-family"
    if ("arubaos-switch" in combined or "provision" in combined or
            re.search(r"\b(?:j9726a|2920-)\b", model, re.I) or firmware.upper().startswith("WB.")):
        return "hpe-arubaos-switch", "inventory:model/firmware"
    if "os10" in combined or re.search(r"\b(?:s|z)\d{4}[a-z-]*\b", model, re.I) and "dell" in vendor:
        return "dell-os10", "inventory:model/os-family"
    if os_family == "planet-sgs" or re.match(r"^SGS-\d", model, re.I):
        return "planet-sgs", "inventory:model/os-family"
    if re.match(r"^(?:SG|SF|CBS|SX|SRW)\d", model, re.I):
        return "cisco-small-business", "inventory:model"
    if re.match(r"^(?:WS-C|C\d{3,4}|ISR|ASR|IE\d|N[3579]K)", model, re.I):
        return "cisco-ios", "inventory:model"
    if os_family in DEVICE_DRIVER_SPECS and os_family != "generic":
        return os_family, "inventory:os-family"
    if collected_driver in DEVICE_DRIVER_SPECS and collected_driver != "generic":
        return collected_driver, "inventory:successful-driver"

    vendor_map = {
        "planet-technology": "planet-sgs",
        "hpe-comware": "hpe-comware7",
        "hpe-aruba": "hpe-arubaos-switch",
        "aruba": "hpe-arubaos-switch",
        "dell": "dell-os10",
        "dell-os10": "dell-os10",
        "fortinet": "fortigate-fortios",
        "fortigate": "fortigate-fortios",
    }
    if vendor in vendor_map:
        return vendor_map[vendor], "phpipam:vendor"
    if "planet" in vendor:
        return "planet-sgs", "phpipam:vendor"
    return "generic", "fallback:unidentified"


def driver_detection_range(value):
    raw = str(value or "").strip()
    start_text, separator, end_text = raw.partition("-")
    if not separator:
        raise argparse.ArgumentTypeError("range must be START-END")
    try:
        start = ipaddress.ip_address(start_text.strip())
        if "." not in end_text and start.version == 4:
            end = ipaddress.ip_address("{}.{}".format(
                ".".join(start_text.strip().split(".")[:-1]), end_text.strip()))
        else:
            end = ipaddress.ip_address(end_text.strip())
    except ValueError as exc:
        raise argparse.ArgumentTypeError(str(exc))
    if start.version != end.version or int(start) > int(end):
        raise argparse.ArgumentTypeError("range end must be after start in the same IP family")
    return start, end


def select_driver_detection_rows(rows, args):
    normalized = normalized_addresses(rows)
    if args.all:
        return normalized
    if args.ips:
        try:
            wanted = {ipaddress.ip_address(value) for value in args.ips}
        except ValueError as exc:
            raise GrError(str(exc))
        return [row for row in normalized if row["_ip"] in wanted]
    if args.subnet:
        try:
            network = ipaddress.ip_network(args.subnet, strict=False)
        except ValueError as exc:
            raise GrError(str(exc))
        return [row for row in normalized if row["_ip"] in network]
    if args.ip_range:
        start, end = args.ip_range
        return [row for row in normalized
                if row["_ip"].version == start.version and int(start) <= int(row["_ip"]) <= int(end)]
    needle = str(args.find or "").strip().lower()
    return [row for row in normalized if needle in " ".join(
        str(row.get(key) or "") for key in
        ("ip", "hostname", "description", "note", "owner", "mac", "port")
    ).lower()]


def command_driver_detect(cfg, args):
    api_cfg = dict(cfg)
    if args.apply:
        api_cfg["app_id"] = cfg.get("migration_app_id", "gr-migrate")
    inventory = latest_successful_inventory(cfg)
    counts = {"selected": 0, "same": 0, "candidate": 0, "updated": 0, "failed": 0}
    entries = []
    with api_session(api_cfg) as client:
        selected = select_driver_detection_rows(client.addresses(), args)
        if not selected:
            raise GrError("No phpIPAM addresses matched the driver detection selector")
        counts["selected"] = len(selected)
        for row in selected:
            ip = str(row["_ip"])
            detected, evidence = detect_device_driver(row, inventory.get(ip))
            current = str(custom_value(row, "device_driver") or "").strip().lower() or "-"
            entry = {"id": row.get("id"), "ip": ip, "hostname": row.get("_hostname") or "-",
                     "current": current, "detected": detected, "evidence": evidence}
            if current == detected:
                entry["status"] = "same"
                counts["same"] += 1
            else:
                entry["status"] = "candidate"
                counts["candidate"] += 1
                if args.apply:
                    before = "" if current == "-" else current
                    try:
                        client.request("PATCH", "addresses/{}/".format(row.get("id")),
                                       payload={"custom_device_driver": detected})
                        after = client.request("GET", "addresses/{}/".format(row.get("id")))
                        if isinstance(after, list):
                            after = after[0] if after else {}
                        actual = str(custom_value(after or {}, "device_driver") or "").strip().lower()
                        if actual != detected:
                            raise GrError("verification returned {!r}".format(actual))
                        entry["status"] = "updated"
                        counts["updated"] += 1
                    except Exception as exc:
                        entry["status"] = "failed"
                        entry["error"] = str(exc)
                        counts["failed"] += 1
                        try:
                            client.request("PATCH", "addresses/{}/".format(row.get("id")),
                                           payload={"custom_device_driver": before})
                            entry["rollback"] = "attempted"
                        except Exception as rollback_exc:
                            entry["rollback"] = "failed: {}".format(rollback_exc)
            entries.append(entry)

    rows = [(entry["ip"], entry["hostname"], entry["current"], entry["detected"],
             entry["evidence"], entry["status"]) for entry in entries]
    print_audit_table(("IP", "HOSTNAME", "CURRENT", "DETECTED", "EVIDENCE", "STATUS"), rows)
    stamp = dt.datetime.utcnow().strftime("%Y%m%dT%H%M%SZ")
    report_path = expand("~/.local/state/gr/driver-detection/driver-detect-{}-{}.json".format(
        "apply" if args.apply else "preview", stamp))
    os.makedirs(os.path.dirname(report_path), mode=0o700, exist_ok=True)
    with open(report_path, "w", encoding="utf-8") as handle:
        json.dump({"created_utc": stamp, "apply": args.apply, "counts": counts,
                   "entries": entries}, handle, ensure_ascii=False, indent=2)
    os.chmod(report_path, 0o600)
    print("\nSUMMARY={}".format(json.dumps(counts, sort_keys=True)))
    print("REPORT={}".format(report_path))
    if not args.apply:
        print("Dry-run only. Re-run with the same selector and --apply to write and verify.")
    return 2 if counts["failed"] else 0


def command_driver_list():
    rows = []
    for driver in DEVICE_DRIVERS:
        spec = device_driver_spec(driver)
        rows.append((driver, "yes" if spec["interactive_cli"] else "no",
                     "; ".join(spec["version_commands"]),
                     "; ".join(spec["config_commands"]) or "-"))
    print_audit_table(("DRIVER", "INTERACTIVE LOGIN", "VERSION COMMANDS", "CONFIG COMMANDS"), rows)
    return 0


def completion_source_path():
    candidates = [
        BASH_COMPLETION,
        os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "completions", "gr.bash"),
    ]
    return next((path for path in candidates if os.path.isfile(path)), "")


def command_completion(cfg, action, value=None):
    if action == "bash":
        source = completion_source_path()
        if not source:
            raise GrError("Bash completion file is not installed")
        with open(source, encoding="utf-8") as handle:
            sys.stdout.write(handle.read())
        return 0
    if action == "profiles":
        for profile in sorted(cfg.get("ssh_profiles", {}), key=str.lower):
            print(profile)
        return 0
    if action == "config-settings":
        for name, _default in CONFIG_OPTIONS:
            if name != "ssh_profiles":
                print(name)
        for profile in sorted(cfg.get("ssh_profiles", {}), key=str.lower):
            for key in PROFILE_CONFIG_KEYS:
                print("ssh_profiles.{}.{}".format(profile, key))
        for profile in sorted(cfg.get("snmp_profiles", {}), key=str.lower):
            for key in SNMP_PROFILE_CONFIG_KEYS:
                print("snmp_profiles.{}.{}".format(profile, key))
        for profile in sorted(cfg.get("monitoring_profiles", {}), key=str.lower):
            for key in MONITORING_PROFILE_CONFIG_KEYS:
                print("monitoring_profiles.{}.{}".format(profile, key))
        return 0
    if action == "drivers":
        for driver in DEVICE_DRIVERS:
            print(driver)
        return 0
    if action == "vendors":
        with api_session(cfg, prompt=False) as client:
            for vendor, _count in vendor_counts(client.addresses()):
                print(vendor)
        return 0
    if action == "inventory-targets":
        values = set()
        with api_session(cfg, prompt=False) as client:
            for row in normalized_addresses(client.addresses()):
                values.add(str(row["_ip"]))
                if row.get("_hostname"):
                    values.add(str(row["_hostname"]))
        for target in sorted(values, key=str.lower):
            print(target)
        return 0
    if action == "audit-targets":
        values = set()
        for summary in audit_inventory(cfg):
            values.update(audit_session_keys(summary))
        for target in sorted(values, key=str.lower):
            print(target)
        return 0
    if action == "audit-sessions":
        if not value:
            raise GrError("audit-sessions requires a hostname or IP")
        matches = resolve_audit_sessions(cfg, value)
        if matches:
            print("latest")
        for summary in sorted(matches, key=lambda item: item["started"], reverse=True):
            print(summary["session"])
        return 0
    if action == "collect-reports":
        reports = collect_report_inventory(cfg)
        if reports:
            print("latest")
        for report in reports:
            print(report["id"])
        return 0
    if action == "config-targets":
        values = set()
        for item in config_archive_files():
            values.update((item["hostname"], item["ip"]))
        for candidate in sorted(values, key=str.lower):
            print(candidate)
        return 0
    if action == "config-revisions":
        if not value:
            raise GrError("config-revisions requires a hostname or IP")
        item = config_archive_target(value)
        print("latest")
        for commit, _date, _subject in config_archive_history(item):
            print(commit[:12])
        return 0
    raise GrError("Unsupported completion action: {}".format(action))

def ssh_with_password(command, password):
    if not shutil.which("sshpass"):
        raise GrError("sshpass is not installed")
    read_fd, write_fd = os.pipe()
    try:
        os.set_inheritable(read_fd, True)
        os.write(write_fd, (password + "\n").encode("utf-8"))
    finally:
        os.close(write_fd)
    return ["sshpass", "-d", str(read_fd)] + command, read_fd


def ensure_known_hosts(cfg):
    path = cfg["ssh_known_hosts"]
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT, 0o600)
    os.close(fd)
    os.chmod(path, 0o600)
    return path


def exact_inventory_target(cfg, target):
    wanted = str(target or "").strip().lower()
    if not wanted:
        raise GrError("An exact hostname or IP is required")
    with api_session(cfg) as client:
        rows = normalized_addresses(client.addresses())
    matches = [row for row in rows if
               str(row.get("_ip") or "").lower() == wanted or
               str(row.get("_hostname") or "").lower() == wanted]
    if not matches:
        raise GrError("No exact phpIPAM target matches: {}".format(target))
    if len(matches) != 1:
        values = ", ".join(str(row.get("_ip")) for row in matches)
        raise GrError("Target {} is ambiguous; use an exact IP ({})".format(target, values))
    return matches[0]


def command_exec(cfg, target, command_values, use_sudo=False, override_user=None,
                 override_port=None, override_profile=None, override_client=None,
                 no_vault=False, audit=None):
    """Execute an explicit non-interactive command using phpIPAM and vault metadata."""
    command_values = list(command_values or [])
    if command_values and command_values[0] == "--":
        command_values.pop(0)
    if not command_values:
        raise GrError("Remote command is required after --")
    row = exact_inventory_target(cfg, target)
    meta = phpipam_ssh_metadata(row)
    if not meta["enabled"] and not cfg.get("ssh_legacy_fallback", True):
        raise GrError("SSH metadata is not enabled for {}".format(row["_ip"]))
    user = override_user or meta["user"] or getpass.getuser()
    port = str(override_port or meta["port"] or "22")
    selected_profile = override_profile or meta["profile"]
    selected_client = override_client or meta["client"]
    if selected_client not in ("normal", "legacy"):
        raise GrError("Invalid SSH client metadata for {}: {}".format(row["_ip"], selected_client))
    client_binary = "/usr/bin/ssh1" if selected_client == "legacy" else "ssh"
    if not shutil.which(client_binary):
        raise GrError("SSH client is not installed: {}".format(client_binary))

    remote_text = " ".join(shlex.quote(value) for value in command_values)
    if use_sudo:
        remote_text = "sudo -S -p '' -- sh -c {}".format(shlex.quote(remote_text))
    ssh_command = [client_binary, "-F", "/dev/null", "-p", port,
                   "-o", "UserKnownHostsFile={}".format(ensure_known_hosts(cfg)),
                   "-o", "StrictHostKeyChecking=ask"]
    profile_cfg = cfg.get("ssh_profiles", {}).get(selected_profile, {}) if selected_profile else {}
    identity = str(profile_cfg.get("identity_file") or "").strip()
    if identity:
        identity = expand(identity)
        if not os.path.isfile(identity):
            raise GrError("Identity file for profile {} is missing: {}".format(selected_profile, identity))
        ssh_command.extend(["-i", identity])
    if meta["jump"]:
        ssh_command.extend(["-J", meta["jump"]])
    ssh_command.extend(["{}@{}".format(user, row["_ip"]), remote_text])

    inherited_fd = None
    ssh_secret = vault_secret_name(cfg, selected_profile) if selected_profile and not no_vault else ""
    if ssh_secret:
        if not vault_secret_exists(ssh_secret):
            raise GrError("Vault secret is not configured: {}".format(ssh_secret))
        ssh_command, inherited_fd = ssh_with_password(ssh_command, read_vault_password(ssh_secret))
    sudo_input = None
    if use_sudo:
        if no_vault or not selected_profile:
            raise GrError("--sudo requires an encrypted credential profile")
        sudo_secret = sudo_vault_secret_name(cfg, selected_profile)
        if not sudo_secret or not vault_secret_exists(sudo_secret):
            raise GrError("Sudo vault secret is not configured for profile {}".format(selected_profile))
        sudo_input = (read_vault_password(sudo_secret) + "\n").encode("utf-8")

    display_command = [client_binary, "-p", port, "{}@{}".format(user, row["_ip"]),
                       "<sudo command>" if use_sudo else remote_text]
    print("Executing on {}@{}:{} using profile {}{}".format(
        user, row["_ip"], port, selected_profile or "-", " with sudo" if use_sudo else ""),
          flush=True)
    recorder = None
    audit_enabled = cfg.get("ssh_audit_enabled", False) if audit is None else audit
    if audit_enabled:
        recorder = SshSessionAudit(cfg, row, display_command)
        print("Recording remote stdout and stderr to: {}".format(recorder.path), file=sys.stderr)
    try:
        process = subprocess.Popen(ssh_command, stdin=subprocess.PIPE if use_sudo else None,
                                   stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                   pass_fds=(inherited_fd,) if inherited_fd is not None else ())
        stdout_data, stderr_data = process.communicate(sudo_input)
    finally:
        if inherited_fd is not None:
            os.close(inherited_fd)
    if stdout_data:
        sys.stdout.buffer.write(stdout_data)
        sys.stdout.buffer.flush()
        if recorder:
            recorder.record("stdout", stdout_data)
    if stderr_data:
        sys.stderr.buffer.write(stderr_data)
        sys.stderr.buffer.flush()
        if recorder:
            recorder.record("stderr", stderr_data)
    if recorder:
        recorder.close(process.returncode)
        print("Remote command audit: {}".format(recorder.path), file=sys.stderr)
    return process.returncode


def connect_ssh(cfg, row, override_user=None, override_port=None, override_profile=None,
                override_client=None, override_driver=None, no_vault=False, audit=None):
    # Always connect to the selected IP, not a potentially duplicated hostname.
    target = str(row["_ip"])
    meta = phpipam_ssh_metadata(row)
    if meta["enabled"] or override_user is not None or override_port is not None or override_profile is not None:
        user = override_user or meta["user"] or getpass.getuser()
        port = str(override_port or meta["port"] or "22")
        selected_client = override_client or meta["client"]
        if selected_client not in ("normal", "legacy"):
            raise GrError("Invalid SSH client metadata for {}: {}".format(target, selected_client))
        client_binary = "/usr/bin/ssh1" if selected_client == "legacy" else "ssh"
        if not shutil.which(client_binary):
            raise GrError("SSH client is not installed: {}".format(client_binary))
        command = [client_binary, "-F", "/dev/null", "-p", port]
        command.extend(["-o", "UserKnownHostsFile={}".format(ensure_known_hosts(cfg)),
                        "-o", "StrictHostKeyChecking=ask"])
        selected_profile = override_profile or meta["profile"]
        profile_cfg = cfg.get("ssh_profiles", {}).get(selected_profile, {}) if selected_profile else {}
        identity = str(profile_cfg.get("identity_file") or "").strip()
        if identity:
            identity = expand(identity)
            if not os.path.isfile(identity):
                raise GrError("Identity file for profile {} is missing: {}".format(meta["profile"], identity))
            command.extend(["-i", identity])
        if meta["jump"]:
            command.extend(["-J", meta["jump"]])
        command.append("{}@{}".format(user, target))
        print("Connecting with phpIPAM/default/CLI metadata: {}".format(
            ssh_display(row, cfg.get("ssh_legacy_fallback", True), override_user, override_port,
                        override_profile, override_client)))
    else:
        if not cfg.get("ssh_legacy_fallback", True):
            raise GrError("SSH metadata is not enabled for {} and legacy fallback is disabled".format(target))
        effective = ssh_effective(target)
        command = ["ssh", target]
        print("Connecting with LEGACY ~/.ssh/config: {}@{}:{}".format(
            effective["user"], target, effective["port"]))
    selected_profile = override_profile or meta["profile"]
    secret = vault_secret_name(cfg, selected_profile) if selected_profile and not no_vault else ""
    device_driver = resolve_device_driver(row, override_driver)
    inherited_fd = None
    vault_password = None
    if secret and vault_secret_exists(secret):
        print("Using encrypted SSH password profile: {}".format(selected_profile))
        vault_password = read_vault_password(secret)
        command, inherited_fd = ssh_with_password(command, vault_password)
    elif secret:
        print("Vault secret {} is not configured; using the normal OpenSSH prompt.".format(secret))
    driver_spec = device_driver_spec(device_driver)
    if driver_spec["interactive_cli"] and not vault_password:
        raise GrError("Device driver {} requires a configured credential profile".format(
            device_driver))
    login_driver = None
    if driver_spec["interactive_cli"]:
        print("Using device driver: {}".format(device_driver))
        login_driver = device_login_driver(device_driver)(user, vault_password)

    def retry_with_prompt(exit_status):
        if not vault_password:
            return exit_status
        return retry_rejected_vault_password(
            exit_status, target, selected_profile,
            lambda: connect_ssh(cfg, row, override_user, override_port, override_profile,
                                override_client, override_driver, no_vault=True, audit=audit),
            prompt_retry_supported=login_driver is None)

    audit_enabled = cfg.get("ssh_audit_enabled", False) if audit is None else audit
    if audit_enabled:
        recorder = SshSessionAudit(cfg, row, command)
        print("Recording complete SSH session to: {}".format(recorder.path), file=sys.stderr)
        return retry_with_prompt(run_pty_ssh(command, recorder, inherited_fd, login_driver))
    if login_driver is not None:
        return retry_with_prompt(run_pty_ssh(command, inherited_fd=inherited_fd,
                                             login_driver=login_driver))
    if vault_password:
        # We must wait for sshpass to return to identify status 5 and offer the
        # operator an interactive retry. Non-vault SSH retains execvp behavior.
        return retry_with_prompt(run_pty_ssh(command, inherited_fd=inherited_fd))
    os.execvp(command[0], command)


def command_search(cfg, terms, use_ssh=False, ssh_user=None, ssh_port=None,
                   ssh_profile=None, ssh_client=None, device_driver=None, no_vault=False, audit=None,
                   details=False, brief=False, show_vendor=False):
    needle = " ".join(terms).strip().lower()
    if not needle:
        raise GrError("Search text is required")
    try:
        exact_ip = ipaddress.ip_address(needle)
    except ValueError:
        exact_ip = None
    with api_session(cfg) as client:
        rows = normalized_addresses(client.addresses())
    matches = []
    for row in rows:
        if exact_ip is not None:
            if row["_ip"] == exact_ip:
                matches.append(row)
            continue
        haystack = " ".join(str(row.get(key) or "") for key in
                            ("ip", "hostname", "description", "note", "owner", "mac", "port")).lower()
        if needle in haystack:
            matches.append(row)
    if matches:
        if details:
            print_table(matches, legacy_fallback=cfg.get("ssh_legacy_fallback", True), brief=brief,
                        show_vendor=show_vendor)
            print_address_details(matches)
            print()
        if use_ssh:
            if len(matches) == 1:
                selected = matches[0]
                print("One SSH target matched; connecting automatically:")
                if not details:
                    print_table(matches, numbered=False,
                                legacy_fallback=cfg.get("ssh_legacy_fallback", True),
                                override_user=ssh_user, override_port=ssh_port,
                                override_profile=ssh_profile, override_client=ssh_client,
                                brief=brief, show_vendor=show_vendor)
                print()
            else:
                selected = choose_ssh_target(matches, cfg.get("ssh_legacy_fallback", True), ssh_user, ssh_port,
                                             ssh_profile, ssh_client, brief=brief,
                                             show_vendor=show_vendor)
                if selected is None:
                    print("SSH connection cancelled.")
                    return 0
            return connect_ssh(cfg, selected, ssh_user, ssh_port, ssh_profile, ssh_client,
                               device_driver, no_vault, audit)
        if not details:
            print_table(matches, legacy_fallback=cfg.get("ssh_legacy_fallback", True), brief=brief,
                        show_vendor=show_vendor)
        print("\n{} result(s)".format(len(matches)))
        return 0
    print("No phpIPAM results for: {}".format(needle), file=sys.stderr)
    return 1


def command_subnet(cfg, cidr):
    try:
        network = ipaddress.ip_network(cidr, strict=False)
    except ValueError as exc:
        raise GrError(str(exc))
    with api_session(cfg) as client:
        rows = [row for row in normalized_addresses(client.addresses()) if row["_ip"] in network]
    print_table(rows, legacy_fallback=cfg.get("ssh_legacy_fallback", True))
    print("\n{} address(es) in {}".format(len(rows), network))
    return 0


def split_managed_hosts(text):
    lines = text.splitlines()
    begin = [idx for idx, line in enumerate(lines) if line == BEGIN_MARKER]
    end = [idx for idx, line in enumerate(lines) if line == END_MARKER]
    if not begin and not end:
        return lines, None
    if len(begin) != 1 or len(end) != 1 or begin[0] >= end[0]:
        raise GrError("Invalid phpIPAM managed markers in /etc/hosts")
    return lines[:begin[0]] + lines[end[0] + 1 :], (begin[0], end[0])


def existing_host_keys(lines):
    ips, names = set(), set()
    for raw in lines:
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        fields = line.split()
        if not fields:
            continue
        if normalize_ip(fields[0]) is None:
            continue
        ips.add(fields[0].lower())
        names.update(field.lower() for field in fields[1:])
    return ips, names


def render_hosts(current, rows):
    manual_lines, marker_range = split_managed_hosts(current)
    manual_ips, manual_names = existing_host_keys(manual_lines)
    generated = [BEGIN_MARKER]
    skipped = 0
    duplicates = duplicate_hostnames(rows)
    duplicate_skipped = 0
    for row in normalized_addresses(rows):
        hostname = row.get("_hostname")
        if not hostname:
            continue
        if hostname.lower() in duplicates:
            duplicate_skipped += 1
            continue
        ip_text = str(row["_ip"])
        if ip_text.lower() in manual_ips or hostname.lower() in manual_names:
            skipped += 1
            continue
        description = clean_comment(row.get("description") or row.get("note"))
        line = "{:<39} {}".format(ip_text, hostname)
        if description:
            line += "  # " + description
        generated.append(line.rstrip())
    generated.append(END_MARKER)
    if marker_range is None:
        base = current.rstrip("\n")
        result = base + "\n\n" + "\n".join(generated) + "\n"
    else:
        begin, end = marker_range
        original = current.splitlines()
        result = "\n".join(original[:begin] + generated + original[end + 1 :]) + "\n"
    return result, len(generated) - 2, skipped, duplicate_skipped


def render_ssh(rows):
    lines = ["# Generated by gr from phpIPAM; do not edit.", ""]
    count = 0
    seen = set()
    duplicates = duplicate_hostnames(rows)
    duplicate_skipped = 0
    for row in normalized_addresses(rows):
        hostname = row.get("_hostname")
        if not hostname:
            continue
        if hostname.lower() in duplicates:
            duplicate_skipped += 1
            continue
        if hostname.lower() in seen:
            continue
        seen.add(hostname.lower())
        description = clean_comment(row.get("description") or row.get("note"))
        if description:
            lines.append("# " + description)
        lines.append("Host {}".format(hostname))
        lines.append("    HostName {}".format(row["_ip"]))
        port = str(row.get("port") or "").strip()
        if port.isdigit() and 1 <= int(port) <= 65535:
            lines.append("    Port {}".format(port))
        lines.append("")
        count += 1
    return "\n".join(lines).rstrip() + "\n", count, duplicate_skipped


def show_diff(path, old, new):
    diff = difflib.unified_diff(old.splitlines(), new.splitlines(),
                                fromfile=path + " (current)", tofile=path + " (phpIPAM)", lineterm="")
    for line in diff:
        print(line)


def atomic_user_write(path, content):
    directory = os.path.dirname(path)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    timestamp = dt.datetime.utcnow().strftime("%Y%m%dT%H%M%SZ")
    if os.path.exists(path):
        shutil.copy2(path, path + ".backup-" + timestamp)
    fd, temp_path = tempfile.mkstemp(prefix=".gr-", dir=directory, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temp_path, 0o600)
        os.replace(temp_path, path)
    finally:
        if os.path.exists(temp_path):
            os.unlink(temp_path)


def privileged_hosts_write(path, content):
    timestamp = dt.datetime.utcnow().strftime("%Y%m%dT%H%M%SZ")
    fd, temp_path = tempfile.mkstemp(prefix="gr-hosts-", dir="/tmp", text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temp_path, 0o600)
        subprocess.check_call(["sudo", "cp", "-p", path, path + ".backup-" + timestamp])
        subprocess.check_call(["sudo", "install", "-o", "root", "-g", "root", "-m", "0644", temp_path, path])
    finally:
        if os.path.exists(temp_path):
            os.unlink(temp_path)


def command_sync(cfg, apply, target):
    hosts_enabled = cfg.get("hosts_sync_enabled", False)
    if target == "hosts" and not hosts_enabled:
        raise GrError("/etc/hosts synchronization is disabled; phpIPAM is the hostname source of truth")
    with api_session(cfg) as client:
        all_rows = client.addresses()
    rows = sync_addresses(cfg, all_rows)
    current_hosts = new_hosts = ""
    host_count = skipped = host_duplicate_skipped = 0
    if hosts_enabled and target in ("all", "hosts"):
        with open(cfg["hosts_file"], encoding="utf-8") as handle:
            current_hosts = handle.read()
        new_hosts, host_count, skipped, host_duplicate_skipped = render_hosts(current_hosts, rows)
    try:
        with open(cfg["ssh_output"], encoding="utf-8") as handle:
            current_ssh = handle.read()
    except FileNotFoundError:
        current_ssh = ""
    new_ssh, ssh_count, ssh_duplicate_skipped = render_ssh(rows)
    if hosts_enabled and target in ("all", "hosts"):
        print("\n=== /etc/hosts: {} generated, {} manual conflicts skipped, {} duplicate records skipped ===".format(
            host_count, skipped, host_duplicate_skipped))
        show_diff(cfg["hosts_file"], current_hosts, new_hosts)
    if target in ("all", "ssh"):
        print("\n=== SSH config: {} generated hosts, {} duplicate records skipped ===".format(
            ssh_count, ssh_duplicate_skipped))
        show_diff(cfg["ssh_output"], current_ssh, new_ssh)
    if not apply:
        print("\nDry-run only. Re-run with: gr sync --apply --target {}".format(target))
        return 0
    if target in ("all", "ssh"):
        atomic_user_write(cfg["ssh_output"], new_ssh)
        subprocess.check_call(["ssh", "-F", os.path.expanduser("~/.ssh/config"), "-G", "localhost"],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print("Updated {}".format(cfg["ssh_output"]))
    if hosts_enabled and target in ("all", "hosts"):
        privileged_hosts_write(cfg["hosts_file"], new_hosts)
        print("Updated {}".format(cfg["hosts_file"]))
    return 0


def command_export(cfg, kind, output):
    if kind == "hosts" and not cfg.get("hosts_sync_enabled", False):
        raise GrError("hosts export is disabled; phpIPAM is the hostname source of truth")
    with api_session(cfg) as client:
        rows = sync_addresses(cfg, client.addresses())
    if kind == "hosts":
        content, count, skipped, duplicate_skipped = render_hosts("", rows)
        summary = "{} host entries ({} conflicts, {} duplicate records skipped)".format(
            count, skipped, duplicate_skipped)
    else:
        content, count, duplicate_skipped = render_ssh(rows)
        summary = "{} SSH entries ({} duplicate records skipped)".format(count, duplicate_skipped)
    if output == "-":
        sys.stdout.write(content)
    else:
        path = expand(output)
        atomic_user_write(path, content)
        print("Wrote {}: {}".format(path, summary))
    return 0


def command_auth(cfg, action):
    if action == "configure":
        password = getpass.getpass("New phpIPAM password for {}: ".format(cfg["username"]))
        confirm = getpass.getpass("Confirm password: ")
        if not password or password != confirm:
            raise GrError("Passwords do not match or are empty")
        client = PhpIpamClient(cfg, password)
        data = client.login()
        client.logout()
        os.makedirs(os.path.dirname(cfg["credential_file"]), mode=0o700, exist_ok=True)
        fd = os.open(cfg["credential_file"], os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(password + "\n")
        os.chmod(cfg["credential_file"], 0o600)
        print("Authentication succeeded; credential saved with mode 0600 (expires {}).".format(data.get("expires", "unknown")))
        return 0
    with api_session(cfg) as client:
        perms = client.permissions()
        addresses = client.addresses()
        subnets = client.subnets()
    print("Authentication OK; permissions={}; addresses={}; subnets={}".format(
        perms.get("permissions", "unknown"), len(addresses), len(subnets)))
    return 0


def command_init(cfg, configure_auth=False):
    directories = (expand("~/.config/gr"), expand("~/.local/state/gr"))
    for directory in directories:
        os.makedirs(directory, mode=0o700, exist_ok=True)
        os.chmod(directory, 0o700)
    print("Initialized per-user gr directories (mode 0700).")
    print("Persistent gr host-key store: {}".format(ensure_known_hosts(cfg)))
    print("Configuration sources: {}".format(" + ".join(cfg.get("_config_sources", []))))
    if configure_auth:
        return command_auth(cfg, "configure")
    if not os.path.isfile(cfg["credential_file"]):
        print("API credential is not configured. Next: gr auth configure")
    if not os.path.isdir(expand("~/.password-store")):
        print("SSH vault is not initialized. See: gr docs (vault section)")
    return 0


def command_doctor(cfg, test_api=False, system_only=False):
    results = []

    def check(name, ok, detail, essential=False):
        results.append((name, bool(ok), detail, essential))

    sources = cfg.get("_config_sources", [])
    check("configuration", bool(sources), " + ".join(sources), essential=True)
    check("pinned CA", os.path.isfile(cfg["ca_file"]), cfg["ca_file"], essential=True)
    if not system_only:
        credential = cfg["credential_file"]
        if os.path.isfile(credential):
            mode = os.stat(credential).st_mode & 0o777
            check("API credential", mode == 0o600, "{} mode {:04o}".format(credential, mode), essential=True)
        else:
            check("API credential", False, "missing; run gr auth configure", essential=True)
    for executable in ("python3", "ssh", "sshpass", "pass", "gpg", "git", "less", "systemctl", "snmpget"):
        found = shutil.which(executable)
        check(executable, found is not None, found or "not found", essential=True)
    legacy = shutil.which("ssh1")
    check("ssh1 legacy client", legacy is not None, legacy or "not found", essential=True)
    completion_runtime = "/usr/share/bash-completion/bash_completion"
    check("bash-completion runtime", os.path.isfile(completion_runtime), completion_runtime, essential=True)
    ca_bundle = "/etc/ssl/certs/ca-certificates.crt"
    check("CA certificate bundle", os.path.isfile(ca_bundle), ca_bundle, essential=True)
    vendor_dir = cfg["vendor_db_dir"]
    metadata = os.path.join(vendor_dir, "metadata.json")
    check("IEEE vendor database", os.path.isfile(metadata), metadata)
    check("self-update helper", os.path.isfile(SELF_UPDATER), SELF_UPDATER, essential=system_only)
    check("update configuration", os.path.isfile("/etc/gr/update.json"), "/etc/gr/update.json",
          essential=system_only)
    check("release verification key", os.path.isfile("/etc/gr/release-key.asc"),
          "/etc/gr/release-key.asc or install with --release-key")
    check("Bash completion", os.path.isfile(BASH_COMPLETION),
          "{} or run: eval \"$(gr completion bash)\"".format(BASH_COMPLETION), essential=True)
    template_file = expand(cfg.get("snmp_template_file") or "/etc/gr/snmp-templates.json")
    template_ok = False
    template_detail = template_file
    try:
        with open(template_file, encoding="utf-8") as handle:
            template_data = json.load(handle)
        template_ok = (template_data.get("schema_version") == 1 and
                       isinstance(template_data.get("templates"), list) and
                       bool(template_data.get("templates")))
    except (OSError, ValueError) as exc:
        template_detail = "{} ({})".format(template_file, exc)
    check("SNMP template catalog", template_ok, template_detail, essential=True)
    snmp_handlers = "/usr/local/libexec/gr/snmp-handlers"
    check("SNMP handler registry", os.path.isfile(snmp_handlers), snmp_handlers, essential=True)
    archive_exists = os.path.isdir(GLOBAL_CONFIG_ARCHIVE)
    archive_access = archive_exists and os.access(GLOBAL_CONFIG_ARCHIVE, os.R_OK | os.X_OK)
    check("global config archive", archive_access,
          "{}{}".format(GLOBAL_CONFIG_ARCHIVE,
                        "" if archive_access else "; membership in gr-config required"),
          essential=True)
    timezone_path = "/etc/timezone"
    try:
        with open(timezone_path, encoding="utf-8") as handle:
            system_timezone = handle.read().strip()
    except OSError:
        system_timezone = "unknown"
    check("system timezone", system_timezone == DISPLAY_TIMEZONE,
          "{} (required: {})".format(system_timezone, DISPLAY_TIMEZONE), essential=True)
    legacy_driver_profiles = sorted(
        profile for profile, value in cfg.get("ssh_profiles", {}).items()
        if isinstance(value, dict) and value.get("session_driver"))
    check("credential/driver separation", not legacy_driver_profiles,
          "clean" if not legacy_driver_profiles else
          "legacy session_driver in {}; run gr migrate-drivers, then remove the keys".format(
              ", ".join(legacy_driver_profiles)))
    if not system_only:
        state_dir = expand("~/.local/state/gr")
        if os.path.isdir(state_dir):
            mode = os.stat(state_dir).st_mode & 0o777
            check("private state directory", mode == 0o700, "{} mode {:04o}".format(state_dir, mode))
        else:
            check("private state directory", False, "missing; run gr init")
        check("password vault", os.path.isdir(expand("~/.password-store")), expand("~/.password-store"))
        known_hosts = cfg["ssh_known_hosts"]
        known_hosts_mode = (os.stat(known_hosts).st_mode & 0o777) if os.path.isfile(known_hosts) else 0
        check("gr known_hosts", os.path.isfile(known_hosts) and known_hosts_mode == 0o600,
              "{} mode {:04o}".format(known_hosts, known_hosts_mode) if known_hosts_mode else
              "missing; run gr init")
    if test_api:
        try:
            with api_session(cfg, prompt=False) as client:
                permissions = client.permissions()
                api_addresses = client.addresses()
            check("phpIPAM API", True, "permissions={}".format(permissions.get("permissions", "unknown")), essential=True)
            missing_fields = missing_address_custom_fields(api_addresses)
            check("phpIPAM custom fields", not missing_fields,
                  "all required fields present" if not missing_fields else
                  "missing {}; run phpipam/ensure-custom-fields.php on the phpIPAM server".format(
                      ", ".join(missing_fields)), essential=True)
        except GrError as exc:
            check("phpIPAM API", False, str(exc), essential=True)
    for name, ok, detail, _essential in results:
        print("{:<5} {:<24} {}".format("OK" if ok else "WARN", name, detail))
    failures = [name for name, ok, _detail, essential in results if essential and not ok]
    if failures:
        print("Essential checks failed: {}".format(", ".join(failures)), file=sys.stderr)
        return 2
    return 0


def command_vault(cfg, action, value=None):
    if sys.stdin.isatty():
        try:
            os.environ["GPG_TTY"] = os.ttyname(sys.stdin.fileno())
        except OSError:
            pass
    if action == "reset-agent":
        if not shutil.which("gpgconf"):
            raise GrError("gpgconf is not installed")
        print("Resetting only the current user's GPG agent and pinentry state.")
        if subprocess.call(["gpgconf", "--kill", "gpg-agent"]):
            raise GrError("gpgconf could not stop the current user's GPG agent")
        # Do not eagerly restart the agent here.  On supervised installations
        # that can bind pinentry to the old or non-interactive SSH terminal.
        # The next gpg/pass operation auto-starts it with the current GPG_TTY;
        # read_vault_password refreshes that TTY before decryption.
        print("GPG agent reset complete; the encrypted vault was not modified.")
        if not value:
            return 0
        action = "test"
    if not shutil.which("pass"):
        raise GrError("pass is not installed")
    if action == "init":
        if not value:
            raise GrError("Usage: gr vault init <GPG-ID>")
        return subprocess.call(["pass", "init", value])
    if action == "list":
        return subprocess.call(["pass", "ls", "gr"])
    if not value:
        raise GrError("Usage: gr vault {} <profile>".format(action))
    profile = profile_name(value)
    secret = vault_secret_name(cfg, profile)
    if not secret:
        raise GrError("Profile {} has no password_secret in ssh_profiles".format(profile))
    if action == "set":
        print("Saving encrypted secret {} for profile {}.".format(secret, profile))
        return subprocess.call(["pass", "insert", "-f", secret])
    read_vault_password(secret)
    print("Vault secret is available for profile {}.".format(profile))
    return 0


def command_local(terms, hosts_file):
    needle = " ".join(terms).lower()
    with open(hosts_file, encoding="utf-8-sig") as handle:
        matches = [line.rstrip() for line in handle if needle in line.lower() and line.strip()]
    for line in matches:
        print(line)
    return 0 if matches else 1


def build_ssh_migration(rows, hosts_file):
    by_ip = {}
    for row in rows:
        ip = normalize_ip(row.get("ip"))
        if ip is not None:
            by_ip.setdefault(str(ip), []).append(row)
    pattern = re.compile(
        r"^\s*(\S+)\s+(\S+)(?:\s+.*)?#\s*\[(\d{1,5})\](?:\[([^\]]*)\])?\s*(.*)$")
    items = []
    with open(hosts_file, encoding="utf-8-sig") as handle:
        for lineno, line in enumerate(handle, 1):
            match = pattern.match(line.rstrip())
            if not match:
                continue
            ip_text, hosts_hostname, port, user, description = match.groups()
            user = (user or "").strip()
            try:
                ipaddress.ip_address(ip_text)
            except ValueError:
                continue
            matches = by_ip.get(ip_text, [])
            if not matches:
                status = "missing_in_phpipam"
            elif len(matches) > 1:
                status = "ambiguous"
            elif phpipam_ssh_metadata(matches[0])["complete"]:
                status = "already_configured"
            elif not user:
                status = "missing_user"
            else:
                status = "ready"
            api_row = matches[0] if len(matches) == 1 else {}
            items.append({
                "line": lineno,
                "ip": ip_text,
                "hosts_hostname": hosts_hostname,
                "port": int(port),
                "user": user,
                "description": description.strip(),
                "status": status,
                "phpipam_id": api_row.get("id"),
                "phpipam_hostname": api_row.get("hostname"),
                "api_row": api_row,
            })
    return items


def ssh_custom_snapshot(row):
    return {
        "custom_ssh_enabled": custom_value(row, "ssh_enabled"),
        "custom_ssh_user": custom_value(row, "ssh_user"),
        "custom_ssh_port": custom_value(row, "ssh_port"),
        "custom_ssh_profile": custom_value(row, "ssh_profile"),
        "custom_ssh_jump": custom_value(row, "ssh_jump"),
        "custom_ssh_client": custom_value(row, "ssh_client"),
        "custom_device_driver": custom_value(row, "device_driver"),
        "custom_device_vendor": custom_value(row, "device_vendor"),
    }


def command_migrate_drivers(cfg, apply=False, limit=None, overwrite=False):
    """Move legacy v1 profile session_driver values into phpIPAM address metadata."""
    mappings = {}
    for profile in cfg.get("ssh_profiles", {}):
        driver = legacy_profile_driver(cfg, profile)
        if driver:
            mappings[profile] = driver
    if not mappings:
        print("No legacy profile session_driver mappings were found.")
        return 0
    api_cfg = dict(cfg)
    if apply:
        api_cfg["app_id"] = cfg.get("migration_app_id", "gr-migrate")
    counts = {"candidate": 0, "same": 0, "conflict": 0, "updated": 0, "failed": 0}
    entries = []
    writes = 0
    with api_session(api_cfg) as client:
        for row in client.addresses():
            meta = phpipam_ssh_metadata(row)
            desired = mappings.get(meta["profile"])
            if not desired:
                continue
            current = str(custom_value(row, "device_driver") or "").strip().lower()
            item = {"id": row.get("id"), "ip": str(normalize_ip(row.get("ip")) or row.get("ip")),
                    "hostname": row.get("hostname"), "profile": meta["profile"],
                    "before": current, "desired": desired}
            if current == desired:
                item["status"] = "same"
                counts["same"] += 1
            elif current and not overwrite:
                item["status"] = "conflict"
                counts["conflict"] += 1
            else:
                item["status"] = "candidate"
                counts["candidate"] += 1
                if apply and (limit is None or writes < limit):
                    try:
                        client.request("PATCH", "addresses/{}/".format(row.get("id")),
                                       payload={"custom_device_driver": desired})
                        after = client.request("GET", "addresses/{}/".format(row.get("id")))
                        actual = str(custom_value(after or {}, "device_driver") or "").strip().lower()
                        if actual != desired:
                            raise GrError("verification returned {!r}".format(actual))
                        item["status"] = "updated"
                        counts["updated"] += 1
                        writes += 1
                    except Exception as exc:
                        item["status"] = "failed"
                        item["error"] = str(exc)
                        counts["failed"] += 1
            entries.append(item)
    stamp = dt.datetime.utcnow().strftime("%Y%m%dT%H%M%SZ")
    report = expand("~/.local/state/gr/driver-migration/driver-{}-{}.json".format(
        "apply" if apply else "preview", stamp))
    os.makedirs(os.path.dirname(report), mode=0o700, exist_ok=True)
    with open(report, "w", encoding="utf-8") as handle:
        json.dump({"apply": apply, "limit": limit, "overwrite": overwrite,
                   "legacy_profile_mappings": mappings, "counts": counts, "entries": entries},
                  handle, ensure_ascii=False, indent=2)
    os.chmod(report, 0o600)
    print("Driver migration: {}".format(json.dumps(counts, sort_keys=True)))
    print("Legacy mappings: {}".format(json.dumps(mappings, sort_keys=True)))
    print("Report: {}".format(report))
    if not apply:
        print("Dry-run only. Re-run with --apply to write verified changes.")
    return 2 if counts["failed"] else 0


def command_update(cfg, args):
    try:
        wanted_ip = ipaddress.ip_address(args.ip)
    except ValueError as exc:
        raise GrError(str(exc))
    desired = {}
    if args.hostname is not None:
        hostname = clean_hostname(args.hostname)
        if not hostname:
            raise GrError("Invalid hostname: {}".format(args.hostname))
        desired["hostname"] = hostname
    if args.clear_hostname:
        desired["hostname"] = ""
    if args.ssh_enabled is not None:
        desired["custom_ssh_enabled"] = 1 if args.ssh_enabled == "yes" else 0
    if args.ssh_user is not None:
        desired["custom_ssh_user"] = args.ssh_user
    if args.clear_ssh_user:
        desired["custom_ssh_user"] = ""
    if args.ssh_port is not None:
        desired["custom_ssh_port"] = args.ssh_port
    if args.clear_ssh_port:
        desired["custom_ssh_port"] = ""
    if args.ssh_profile is not None:
        desired["custom_ssh_profile"] = args.ssh_profile
    if args.clear_ssh_profile:
        desired["custom_ssh_profile"] = ""
    if args.ssh_jump is not None:
        desired["custom_ssh_jump"] = args.ssh_jump
    if args.clear_ssh_jump:
        desired["custom_ssh_jump"] = ""
    if args.ssh_client is not None:
        desired["custom_ssh_client"] = args.ssh_client
    if args.clear_ssh_client:
        desired["custom_ssh_client"] = ""
    if args.device_driver is not None:
        desired["custom_device_driver"] = args.device_driver
    if args.clear_device_driver:
        desired["custom_device_driver"] = ""
    if args.device_vendor is not None:
        desired["custom_device_vendor"] = args.device_vendor
    if args.clear_device_vendor:
        desired["custom_device_vendor"] = ""
    if not desired:
        raise GrError("No changes requested")

    write_cfg = dict(cfg)
    write_cfg["app_id"] = cfg.get("migration_app_id", "gr-migrate")
    with api_session(write_cfg) as client:
        matches = [row for row in client.addresses() if normalize_ip(row.get("ip")) == wanted_ip]
        if not matches:
            raise GrError("Address not found in phpIPAM: {}".format(wanted_ip))
        if len(matches) != 1:
            raise GrError("Address is ambiguous in phpIPAM: {} matches".format(len(matches)))
        row = matches[0]
        before = {"hostname": row.get("hostname")}
        before.update(ssh_custom_snapshot(row))
        print("Address id={} ip={}".format(row.get("id"), wanted_ip))
        print("Before:  {}".format(json.dumps(before, ensure_ascii=False, sort_keys=True)))
        print("Desired: {}".format(json.dumps(desired, ensure_ascii=False, sort_keys=True)))
        if not args.apply:
            print("Dry-run only. Re-run with --apply to write and verify.")
            return 0
        stamp = dt.datetime.utcnow().strftime("%Y%m%dT%H%M%SZ")
        report_path = expand("~/.local/state/gr/updates/address-{}-{}.json".format(row.get("id"), stamp))
        os.makedirs(os.path.dirname(report_path), mode=0o700, exist_ok=True)
        report = {"created_utc": stamp, "application": write_cfg["app_id"], "id": row.get("id"),
                  "ip": str(wanted_ip), "before": before, "desired": desired, "status": "running"}
        try:
            client.request("PATCH", "addresses/{}/".format(row.get("id")), payload=desired)
            after = client.request("GET", "addresses/{}/".format(row.get("id")))
            if isinstance(after, list):
                after = after[0] if after else {}
            after_snapshot = {"hostname": after.get("hostname")}
            after_snapshot.update(ssh_custom_snapshot(after))
            for key, expected in desired.items():
                actual = after.get(key)
                if actual is None and key.startswith("custom_"):
                    actual = custom_value(after, key[len("custom_"):])
                if str(actual or "") != str(expected or ""):
                    raise GrError("Verification failed for {}: expected {!r}, got {!r}".format(
                        key, expected, actual))
            report["after"] = after_snapshot
            report["status"] = "complete"
        except Exception:
            report["status"] = "failed"
            rollback = {key: (before.get(key) if before.get(key) is not None else "") for key in desired}
            try:
                client.request("PATCH", "addresses/{}/".format(row.get("id")), payload=rollback)
                report["rollback"] = "attempted"
            except Exception as rollback_exc:
                report["rollback"] = "failed: {}".format(rollback_exc)
            raise
        finally:
            with open(report_path, "w", encoding="utf-8") as handle:
                json.dump(report, handle, ensure_ascii=False, indent=2, sort_keys=True)
                handle.write("\n")
            os.chmod(report_path, 0o600)
        print("Updated and verified: {}".format(wanted_ip))
        print("Update report: {}".format(report_path))
    return 0


def migration_print(items):
    counts = {}
    for item in items:
        counts[item["status"]] = counts.get(item["status"], 0) + 1
    print("Migration candidates from {} parsed lines:".format(len(items)))
    for status in sorted(counts):
        print("  {:<20} {}".format(status, counts[status]))
    print()
    for item in items:
        if item["status"] == "ready":
            print("READY id={:<5} {:<15} {}@{}:{}".format(
                str(item["phpipam_id"]), item["ip"], item["user"], item["ip"], item["port"]))


def command_migrate_ssh(cfg, apply, limit):
    migration_cfg = dict(cfg)
    migration_cfg["app_id"] = cfg.get("migration_app_id", "gr-migrate")
    with api_session(migration_cfg) as client:
        items = build_ssh_migration(client.addresses(), cfg["hosts_file"])
        ready = [item for item in items if item["status"] == "ready"]
        if limit is not None:
            ready = ready[:limit]
        migration_print(items)
        print("Selected for this run: {}".format(len(ready)))
        if not apply:
            print("Dry-run only. Re-run with: gr migrate-ssh --apply{}".format(
                " --limit {}".format(limit) if limit is not None else ""))
            return 0
        if not ready:
            print("Nothing to migrate.")
            return 0
        stamp = dt.datetime.utcnow().strftime("%Y%m%dT%H%M%SZ")
        report_path = expand("~/.local/state/gr/migrations/ssh-{}.json".format(stamp))
        os.makedirs(os.path.dirname(report_path), mode=0o700, exist_ok=True)
        report = {"created_utc": stamp, "application": migration_cfg["app_id"], "status": "running", "updates": []}
        updated = []
        try:
            for item in ready:
                before = ssh_custom_snapshot(item["api_row"])
                desired = {
                    "custom_ssh_enabled": 1,
                    "custom_ssh_user": item["user"],
                    "custom_ssh_port": item["port"],
                }
                entry = {"id": item["phpipam_id"], "ip": item["ip"], "before": before, "desired": desired}
                report["updates"].append(entry)
                client.request("PATCH", "addresses/{}/".format(item["phpipam_id"]), payload=desired)
                after = client.request("GET", "addresses/{}/".format(item["phpipam_id"]))
                if isinstance(after, list):
                    after = after[0] if after else {}
                entry["after"] = ssh_custom_snapshot(after or {})
                meta = phpipam_ssh_metadata(after or {})
                if not meta["complete"] or meta["user"] != item["user"] or meta["port"] != str(item["port"]):
                    raise GrError("Post-write verification failed for {}".format(item["ip"]))
                entry["verified"] = True
                updated.append(entry)
                print("UPDATED {} {}@{}:{}".format(item["ip"], item["user"], item["ip"], item["port"]))
            report["status"] = "complete"
        except Exception as exc:
            report["status"] = "failed"
            report["error"] = str(exc)
            report["rollback"] = []
            for entry in reversed(updated):
                rollback = {"id": entry["id"], "ip": entry["ip"], "success": False}
                try:
                    client.request("PATCH", "addresses/{}/".format(entry["id"]), payload=entry["before"])
                    rollback["success"] = True
                except Exception as rollback_exc:
                    rollback["error"] = str(rollback_exc)
                report["rollback"].append(rollback)
            raise
        finally:
            fd = os.open(report_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as handle:
                json.dump(report, handle, indent=2, sort_keys=True)
                handle.write("\n")
            os.chmod(report_path, 0o600)
            print("Migration report: {}".format(report_path))
    return 0


def command_docs(path):
    try:
        with open(path, encoding="utf-8") as handle:
            content = handle.read()
    except OSError as exc:
        raise GrError("Cannot read documentation {}: {}".format(path, exc))
    pager = shutil.which("less")
    if pager and sys.stdin.isatty() and sys.stdout.isatty():
        process = subprocess.Popen([pager, "-R"], stdin=subprocess.PIPE, universal_newlines=True)
        process.communicate(content)
        return process.returncode
    try:
        sys.stdout.write(content)
    except UnicodeEncodeError:
        sys.stdout.buffer.write(content.encode("utf-8"))
    return 0


def command_helper(path, arguments):
    if not os.path.isfile(path):
        raise GrError("Installed helper is missing: {}".format(path))
    return subprocess.call([sys.executable, path] + arguments)


def command_self_update(args):
    if not os.path.isfile(SELF_UPDATER):
        raise GrError("Installed self-update helper is missing: {}".format(SELF_UPDATER))
    helper_args = []
    if args.update_action == "check":
        helper_args.append("check")
    if args.version:
        helper_args.extend(["--tag", args.version])
    if args.dry_run:
        helper_args.append("--dry-run")
    if args.yes:
        helper_args.append("--yes")
    command = [SELF_UPDATER] + helper_args
    needs_root = args.update_action != "check" and not args.dry_run
    if needs_root and os.geteuid() != 0:
        sudo = shutil.which("sudo")
        if not sudo:
            raise GrError("sudo is required to update the system-wide gr installation")
        command.insert(0, sudo)
    return subprocess.call(command)


