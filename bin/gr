                               help="write and GET-verify custom_device_driver")
    vendor = sub.add_parser("vendor", help="manage the local IEEE vendor database and phpIPAM vendor fields")
    vendor_sub = vendor.add_subparsers(dest="vendor_action")
    vendor_sub.add_parser("list", help="list device_vendor values configured in phpIPAM")
    vendor_sub.add_parser("update-db", help="download current IEEE MA-L, MA-M and MA-S registries")
    vendor_lookup_parser = vendor_sub.add_parser("lookup", help="look up one or more MAC addresses")
    vendor_lookup_parser.add_argument("macs", nargs="+")
    vendor_sync_parser = vendor_sub.add_parser("sync", help="preview or update device_vendor in phpIPAM")
    vendor_sync_parser.add_argument("--apply", action="store_true", help="write and GET-verify changes")
    vendor_sync_parser.add_argument("--overwrite", action="store_true", help="replace existing different values")
    audit_parser = sub.add_parser("audit", help="inspect private SSH session recordings")
    audit_sub = audit_parser.add_subparsers(dest="audit_action")
    audit_show = audit_sub.add_parser("show", help="browse targets and sessions, or replay a recording")
    audit_show.add_argument("target", nargs="?", help="hostname, IP, or direct .ses path")
    audit_show.add_argument("session", nargs="?", help="session name or latest")
    audit_streams = audit_show.add_mutually_exclusive_group()
    audit_streams.add_argument("--include-stdin", action="store_true",
                               help="also replay typed input (may duplicate terminal echo)")
    audit_streams.add_argument("--stream", choices=("stdin", "stdout", "stderr"),
                               help="replay only one recorded stream")
    audit_show.add_argument("--no-more", action="store_true",
                            help="write directly instead of using the automatic terminal pager")
    completion = sub.add_parser("completion", help="print shell completion or dynamic candidates")
    completion.add_argument("completion_action",
                            choices=("bash", "profiles", "config-settings", "drivers", "vendors", "inventory-targets", "audit-targets", "audit-sessions",
                                     "collect-reports", "config-targets", "config-revisions"))
    completion.add_argument("value", nargs="?", help="target required by audit-sessions")
    docs_parser = sub.add_parser("docs", aliases=["help"], help="display the complete installed documentation")
    docs_parser.add_argument("--language", choices=("en", "ro"), default="en")
    return parser


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    exec_remote_command = None
    if argv and argv[0] == "exec":
        if "--" not in argv:
            raise GrError("gr exec requires -- before the remote command")
        separator = argv.index("--")
        exec_remote_command = argv[separator + 1:]
        argv = argv[:separator]
        if not exec_remote_command:
            raise GrError("Remote command is required after --")
    known_commands = {"init", "doctor", "config", "ssh", "collect", "snmp", "find", "search", "exec", "subnet", "local", "sync", "export", "auth", "vault", "update", "self-update", "migrate-ssh", "migrate-drivers", "driver", "vendor", "audit", "completion", "docs", "help"}
    ssh_requested = "--ssh" in argv
    if ssh_requested:
        argv = [value for value in argv if value != "--ssh"]
    if argv and argv[0] not in known_commands and not argv[0].startswith("-"):
        argv.insert(0, "find")
    if ssh_requested:
        if not argv or argv[0] not in ("find", "search"):
            if argv and argv[0] in known_commands:
                raise GrError("--ssh can only be used with find")
            argv.insert(0, "find")
        argv.append("--ssh")
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.command == "exec":
        args.remote_command = exec_remote_command
    if not args.command:
        parser.print_help()
        return 0
    if args.command in ("docs", "help"):
        return command_docs(DEFAULT_DOCUMENTATION_RO if args.language == "ro" else DEFAULT_DOCUMENTATION)
    if args.command == "self-update":
        return command_self_update(args)
    if args.command == "completion" and args.completion_action == "bash":
        return command_completion({}, "bash")
    if args.command == "config" and args.config_action in ("set", "unset"):
        if args.config:
            raise GrError("--config cannot be combined with config set/unset; use --scope")
        expected = 2 if args.config_action == "set" else 1
        if len(args.config_values) != expected:
            usage = "gr config {} <setting>{} [--scope user|global]".format(
                args.config_action, " <value>" if args.config_action == "set" else "")
            raise GrError("Usage: {}".format(usage))
        return command_config_change(args.config_action, args.config_values[0],
                                     args.config_values[1] if expected == 2 else None,
                                     args.scope)
    cfg = load_config(args.config)
    if args.command == "config":
        if args.config_action == "show":
            if args.config_values:
                raise GrError("gr config show does not accept a target")
            return command_config_show(cfg, args.config)
        if args.config_action == "devices":
            if len(args.config_values) > 1:
                raise GrError("Usage: gr config devices [filter]")
            return command_config_devices(args.config_values[0] if args.config_values else None)
        if args.config_action == "history":
            if len(args.config_values) != 1:
                raise GrError("Usage: gr config history <hostname-or-ip>")
            return command_config_history(args.config_values[0])
        if args.config_action == "view":
            if not 1 <= len(args.config_values) <= 2:
                raise GrError("Usage: gr config view <hostname-or-ip> [revision-or-latest]")
            return command_config_view(args.config_values[0],
                                       args.config_values[1] if len(args.config_values) == 2 else "latest",
                                       use_pager=not args.no_more)
    if args.command == "audit":
        if args.audit_action != "show":
            parser.parse_args(["audit", "--help"])
            return 0
        return command_audit_show(cfg, args.target, args.session,
                                  audit_replay_streams(args.include_stdin, args.stream),
                                  use_pager=not args.no_more)
    if args.command == "completion":
        return command_completion(cfg, args.completion_action, args.value)
    if args.command == "init":
        return command_init(cfg, args.configure_auth)
    if args.command == "doctor":
        if args.api and args.system:
            raise GrError("--api and --system cannot be used together")
        return command_doctor(cfg, args.api, args.system)
    if args.command == "snmp":
        helper_args = list(args.snmp_args or [])
        if args.config:
            helper_args[0:0] = ["--config", args.config]
        return command_helper(SNMP_MANAGER, helper_args)
    if args.command == "ssh":
        if args.ssh_action != "validate":
            parser.parse_args(["ssh", "--help"])
            return 0
        helper_args = ["--workers", str(args.workers)]
        if args.run:
            helper_args.append("--run")
        for ip in args.ips or []:
            helper_args.extend(["--ip", ip])
        return command_helper(SSH_VALIDATOR, helper_args)
    if args.command == "collect":
        if args.collect_action == "reports":
            return command_collect_reports(cfg, args.report, use_pager=not args.no_more, raw=args.raw)
        if args.collect_action == "config":
            helper_args = ["--workers", str(args.workers)]
            if args.driver and not args.ips:
                raise GrError("--driver requires --ip and is intended for controlled probing")
            if args.vendor:
                helper_args.extend(["--vendor", args.vendor])
            if args.driver:
                helper_args.extend(["--driver", args.driver])
            if args.all:
                helper_args.append("--all")
            for ip in args.ips or []:
                helper_args.extend(["--ip", ip])
            return command_helper(CONFIG_COLLECTOR, helper_args)
        if args.collect_action != "version":
            parser.parse_args(["collect", "--help"])
            return 0
        helper_args = ["--workers", str(args.workers)]
        if args.all_drivers and args.vendor:
            raise GrError("--vendor cannot be combined with --all-drivers")
        if args.driver and not args.ips:
            raise GrError("--driver requires --ip and is intended for controlled probing")
        if args.all_drivers:
            helper_args.append("--all-drivers")
        elif args.vendor:
            helper_args.extend(["--vendor", args.vendor])
        if args.driver:
            helper_args.extend(["--driver", args.driver])
        if args.all:
            helper_args.append("--all")
        for ip in args.ips or []:
            helper_args.extend(["--ip", ip])
        return command_helper(VERSION_COLLECTOR, helper_args)
    if args.command in ("find", "search"):
        if (args.user is not None or args.port is not None or args.profile is not None or
                args.client is not None or args.driver is not None or args.no_vault or
                args.audit is not None) and not args.ssh:
            raise GrError("SSH connection options require --ssh")
        return command_search(cfg, args.terms, use_ssh=args.ssh, ssh_user=args.user, ssh_port=args.port,
                              ssh_profile=args.profile, ssh_client=args.client,
                              device_driver=args.driver, no_vault=args.no_vault,
                              audit=args.audit, details=args.details, brief=args.brief,
                              show_vendor=args.show_vendor)
    if args.command == "exec":
        return command_exec(cfg, args.target, args.remote_command, args.sudo, args.user,
                            args.port, args.profile, args.client, args.no_vault, args.audit)
    if args.command == "subnet":
        return command_subnet(cfg, args.cidr)
    if args.command == "local":
        return command_local(args.terms, cfg["hosts_file"])
    if args.command == "sync":
        return command_sync(cfg, args.apply, args.target)
    if args.command == "export":
        return command_export(cfg, args.kind, args.output)
    if args.command == "auth":
        return command_auth(cfg, args.action)
    if args.command == "vault":
        return command_vault(cfg, args.action, args.value)
    if args.command == "update":
        return command_update(cfg, args)
    if args.command == "migrate-ssh":
        if args.limit is not None and args.limit < 1:
            raise GrError("--limit must be at least 1")
        return command_migrate_ssh(cfg, args.apply, args.limit)
    if args.command == "migrate-drivers":
        if args.limit is not None and args.limit < 1:
            raise GrError("--limit must be at least 1")
        if args.overwrite and not args.apply:
            raise GrError("--overwrite requires --apply")
        return command_migrate_drivers(cfg, args.apply, args.limit, args.overwrite)
    if args.command == "driver":
        if args.driver_action == "list":
            return command_driver_list()
        if args.driver_action != "detect":
            parser.parse_args(["driver", "--help"])
            return 0
        return command_driver_detect(cfg, args)
    if args.command == "vendor":
        if not args.vendor_action:
            parser.parse_args(["vendor", "--help"])
            return 0
        if args.vendor_action == "update-db":
            return command_vendor_update_db(cfg)
        if args.vendor_action == "list":
            return command_vendor_list(cfg)
        if args.vendor_action == "lookup":
            return command_vendor_lookup(cfg, args.macs)
        if args.vendor_action == "sync":
            if args.overwrite and not args.apply:
                raise GrError("--overwrite requires --apply")
            return command_vendor_sync(cfg, args.apply, args.overwrite)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except GrError as exc:
        print("gr: error: {}".format(exc), file=sys.stderr)
        sys.exit(2)
    except KeyboardInterrupt:
        print("\ngr: interrupted", file=sys.stderr)
        sys.exit(130)
