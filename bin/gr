def format_local_timestamp(value):
    """Render UTC report/audit timestamps in the configured local display timezone."""
    text = str(value or "").strip()
    if not text:
        return "-"
    parsed = None
    for pattern in ("%Y%m%dT%H%M%SZ", "%Y-%m-%dT%H:%M:%SZ",
                    "%Y-%m-%dT%H:%M:%S.%fZ"):
        try:
            parsed = dt.datetime.strptime(text, pattern)
            break
        except ValueError:
            pass
    if parsed is None:
        try:
            return dt.datetime.strptime(text[:19], "%Y-%m-%d %H:%M:%S").strftime(
                DISPLAY_TIME_FORMAT)
        except ValueError:
            return text
    return time.strftime(DISPLAY_TIME_FORMAT, time.localtime(calendar.timegm(parsed.timetuple())))


def missing_address_custom_fields(rows):
    available = set()
    for row in rows:
        available.update(str(key) for key in row)
        custom_fields = row.get("custom_fields")
        if isinstance(custom_fields, dict):
            for key in custom_fields:
                key = str(key)
                available.add(key if key.startswith("custom_") else "custom_{}".format(key))
    return [field for field in REQUIRED_ADDRESS_CUSTOM_FIELDS if field not in available]

