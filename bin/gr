  gr --ssh --user root --port 2222 corefw
  gr update 192.0.2.22 --ssh-user operator --ssh-port 22 --apply
  gr local corefw            search only /etc/hosts
  gr init                    initialize private per-user directories
  gr doctor --api            verify local setup and phpIPAM access
  gr auth test               validate phpIPAM authentication
